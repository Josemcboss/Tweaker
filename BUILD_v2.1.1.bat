@echo off
:: ??????????????????????????????????????????????????????????
:: BUILD RÁPIDO v2.1.1 - Fix Crítico BrokerInfrastructure
:: ??????????????????????????????????????????????????????????

echo ??????????????????????????????????????????????????????????
echo GHOST OPTIMIZER v2.1.1 - BUILD CRÍTICO
echo Fix: BrokerInfrastructure protection
echo ??????????????????????????????????????????????????????????
echo.

echo [1/4] Limpiando builds anteriores...
if exist "bin\Release" (
    rmdir /s /q "bin\Release"
)
if exist "Tweaker\bin\Release" (
    rmdir /s /q "Tweaker\bin\Release"
)
echo ? Limpieza completada
echo.

echo [2/4] Compilando proyecto...
dotnet build Tweaker\Tweaker.csproj -c Release

if errorlevel 1 (
    echo.
    echo ??????????????????????????????????????????????????????????
    echo ? ERROR EN LA COMPILACIÓN
    echo ??????????????????????????????????????????????????????????
    pause
    exit /b 1
)

echo ? Compilación exitosa
echo.

echo [3/4] Publicando aplicación...
dotnet publish Tweaker\Tweaker.csproj ^
    -c Release ^
    -r win-x64 ^
    --self-contained true ^
    -p:PublishSingleFile=true ^
    -p:PublishTrimmed=false ^
    -p:EnableCompressionInSingleFile=true ^
    -p:DebugType=none ^
    -p:DebugSymbols=false ^
    -p:PublishReadyToRun=true ^
    -o publish\GhostOptimizer_v2.1.1

if errorlevel 1 (
    echo.
    echo ??????????????????????????????????????????????????????????
    echo ? ERROR EN LA PUBLICACIÓN
    echo ??????????????????????????????????????????????????????????
    pause
    exit /b 1
)

echo ? Publicación exitosa
echo.

echo [4/4] Copiando archivos adicionales...
copy "Release\DIAGNOSTICO_SERVICIOS.bat" "publish\GhostOptimizer_v2.1.1\"
copy "Release\VERIFICAR_BROKERINFRASTRUCTURE.bat" "publish\GhostOptimizer_v2.1.1\"
copy "Release\CRITICAL_FIX_BROKERINFRASTRUCTURE.md" "publish\GhostOptimizer_v2.1.1\"
copy "Release\RESUMEN_FIX_v2.1.1.md" "publish\GhostOptimizer_v2.1.1\"
echo ? Archivos copiados
echo.

echo ??????????????????????????????????????????????????????????
echo ? BUILD COMPLETADO EXITOSAMENTE
echo ??????????????????????????????????????????????????????????
echo.
echo Versión: v2.1.1 (Fix Crítico)
echo Ubicación: publish\GhostOptimizer_v2.1.1\
echo.
echo Archivos generados:
dir /b "publish\GhostOptimizer_v2.1.1"
echo.
echo ??????????????????????????????????????????????????????????
echo CHANGELOG v2.1.1:
echo ??????????????????????????????????????????????????????????
echo.
echo ?? FIX CRÍTICO: BrokerInfrastructure Protection
echo.
echo PROBLEMA:
echo   - El tweak de telemetría deshabilitaba BrokerInfrastructure
echo   - Esto es un servicio CRÍTICO del sistema
echo   - Causaba inestabilidad y posibles errores
echo.
echo SOLUCIÓN:
echo   - Removido BrokerInfrastructure de la lista de telemetría
echo   - Ahora solo deshabilita servicios reales de telemetría
echo   - Sistema protegido contra modificaciones peligrosas
echo.
echo SERVICIOS PROTEGIDOS:
echo   ? BrokerInfrastructure (Background Tasks)
echo   ? RpcSs (Remote Procedure Call)
echo   ? DcomLaunch (DCOM Server)
echo   ? Y otros 17 servicios críticos
echo.
echo VALIDACIÓN:
echo   - Ejecuta: DIAGNOSTICO_SERVICIOS.bat
echo   - Verifica: BrokerInfrastructure START_TYPE = 2
echo.
echo ??????????????????????????????????????????????????????????
echo DISTRIBUCIÓN:
echo ??????????????????????????????????????????????????????????
echo.
echo 1. Prueba el ejecutable: Tweaker.exe
echo 2. Verifica con: VERIFICAR_BROKERINFRASTRUCTURE.bat
echo 3. Lee: RESUMEN_FIX_v2.1.1.md
