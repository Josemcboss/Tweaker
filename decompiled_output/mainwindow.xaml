                <StackPanel>
                  <TextBlock Text="Guardar Configuración Actual" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,10" />
                  <TextBlock Text="Crea un perfil con todos los tweaks que tienes activos actualmente para poder restaurarlos más tarde." Foreground="#B9BBBE" FontSize="12" Margin="0,0,0,20" TextWrapping="Wrap" Height="40" />
                  <StackPanel Orientation="Horizontal">
                    <Button Content="CREAR PERFIL NUEVO" Style="{StaticResource OnButton}" Background="#5865F2" Padding="15,10" Margin="0,0,10,0" Command="{Binding SaveProfileCommand}" />
                    <Button Content="IMPORTAR PERFIL" Style="{DynamicResource PresetButton}" Padding="15,10" Command="{Binding ImportProfileCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{DynamicResource NeonGlowCard}" Padding="20" Margin="10,0,0,0">
                <StackPanel>
                  <TextBlock Text="Presets del Sistema" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,10" />
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,20" Height="40">
                    <Button Content="Casual" Style="{DynamicResource PresetButton}" Margin="0,0,8,0" Width="85" CommandParameter="Casual" Command="{Binding LoadPresetCommand}" />
                    <Button Content="Competitivo" Style="{DynamicResource PresetButton}" Margin="0,0,8,0" Width="105" CommandParameter="Competitivo" Command="{Binding LoadPresetCommand}" />
                    <Button Content="Extremo" Style="{DynamicResource PresetButton}" Width="90" CommandParameter="Extremo" Command="{Binding LoadPresetCommand}" />
                  </StackPanel>
                  <TextBlock Text="Aplica configuraciones recomendadas por Ghost Optimizer según tu perfil de uso." Foreground="#B9BBBE" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>
            <TextBlock Text="Mis Perfiles Guardados" FontSize="20" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,15" />
            <ItemsControl ItemsSource="{Binding SavedProfiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{DynamicResource NeonGlowCard}" Padding="15" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Width="40" Height="40" Background="#2A2D31" CornerRadius="6" Margin="0,0,15,0">
                        <TextBlock Text="📄" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="Bold" Foreground="#FFFFFFFF" FontSize="16" Text="{Binding Name}" />
                        <TextBlock Foreground="#7F8084" FontSize="12" Margin="0,2,0,2" Text="{Binding Description}" />
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Tweaks: " Foreground="#5865F2" FontSize="11" />
                          <TextBlock Foreground="#FFFFFFFF" FontSize="11" FontWeight="Bold" Margin="0,0,15,0" Text="{Binding TweakCount}" />
                          <TextBlock Text="Creado: " Foreground="#7F8084" FontSize="11" />
                          <TextBlock Foreground="#7F8084" FontSize="11" Text="{Binding CreatedDate, StringFormat=d}" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="CARGAR" Style="{StaticResource OnButton}" Padding="15,8" Margin="0,0,8,0" Command="{Binding DataContext.LoadProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        <Button Content="EXPORTAR" Style="{DynamicResource PresetButton}" Padding="15,8" Margin="0,0,8,0" Command="{Binding DataContext.ExportProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        <Button Content="ELIMINAR" Style="{StaticResource DangerButton}" Padding="15,8" Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer Name="HistoryPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <UIElement.RenderTransform>
            <TranslateTransform />
          </UIElement.RenderTransform>
          <StackPanel Margin="40">
            <TextBlock FontFamily="Segoe UI Emoji" FontSize="28" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,10">
              <Run Text="📜" /> <Run Text="Historial de Cambios" /></TextBlock>
            <TextBlock Text="Un registro detallado de todas las optimizaciones y modificaciones aplicadas a tu sistema." FontSize="14" Foreground="#A0A0A0" Margin="0,0,0,30" />
            <Border Style="{DynamicResource NeonGlowCard}" Padding="20" Margin="0,0,0,25">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="Control del Registro" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,5" />
                  <TextBlock Text="Puedes exportar el historial a tu escritorio o vaciar el registro por completo." Foreground="#B9BBBE" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Content="EXPORTAR REGISTRO" Style="{StaticResource OnButton}" Background="#5865F2" Padding="15,10" Margin="0,0,10,0" Command="{Binding ExportLogCommand}" />
                  <Button Content="LIMPIAR HISTORIAL" Style="{StaticResource OffButton}" Padding="15,10" Command="{Binding ClearHistoryCommand}" />
                </StackPanel>
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding RecentHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{DynamicResource NeonGlowCard}" Padding="15" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Width="40" Height="40" Background="#2A2D31" CornerRadius="6" Margin="0,0,15,0">
                        <TextBlock Text="🔧" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="Bold" Foreground="#FFFFFFFF" FontSize="14" Text="{Binding Description}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                          <TextBlock Text="Categoría: " Foreground="#7F8084" FontSize="11" />
                          <TextBlock Foreground="#A970FF" FontSize="11" FontWeight="SemiBold" Margin="0,0,15,0" Text="{Binding TweakId}" />
                          <TextBlock Text="Fecha: " Foreground="#7F8084" FontSize="11" />
                          <TextBlock Foreground="#7F8084" FontSize="11" Text="{Binding Timestamp}" />
                        </StackPanel>
                      </StackPanel>
                      <Button Grid.Column="2" Content="DESHACER" Style="{StaticResource OffButton}" Padding="12,6" VerticalAlignment="Center" Command="{Binding DataContext.RollbackTweakCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding TweakId}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <controls:GameBoosterWidget x:Name="GameBoosterWidget" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,45,20,0" Panel.ZIndex="9999" Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="3" />
  </Grid>
</Window>