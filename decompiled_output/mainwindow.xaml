      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource ThemeSidebarBgBrush}" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0">
        <StackPanel>
          <Border Background="{DynamicResource ThemeHeaderBgBrush}" Padding="20,25" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
