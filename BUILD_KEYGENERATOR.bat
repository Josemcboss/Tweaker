@echo off
echo ????????????????????????????????????????????????????????
echo    COMPILAR KEYGENERATOR STANDALONE
echo    Genera un ejecutable independiente
echo ????????????????????????????????????????????????????????
echo.

echo ?? Compilando KeyGenerator en modo Release...
echo.

REM Compilar KeyGenerator en modo Release
dotnet publish KeyGenerator\KeyGenerator.csproj ^
    --configuration Release ^
    --output ".\KeyGenerator_Standalone" ^
    --self-contained false ^
    --runtime win-x64 ^
    /p:PublishSingleFile=false

if errorlevel 1 (
    echo.
    echo ? Error al compilar KeyGenerator
    pause
    exit /b 1
)

echo.
echo ????????????????????????????????????????????????????????
echo ? COMPILACIÓN EXITOSA
echo ????????????????????????????????????????????????????????
echo.
echo ?? KeyGenerator compilado en: .\KeyGenerator_Standalone\
echo ?? Ejecutar: KeyGenerator_Standalone\KeyGenerator.exe
echo.
echo ?? Este ejecutable requiere .NET 10 instalado
echo.

pause