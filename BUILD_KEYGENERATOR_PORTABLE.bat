@echo off
echo ????????????????????????????????????????????????????????
echo    COMPILAR KEYGENERATOR PORTABLE
echo    Genera UN SOLO ejecutable .exe
echo ????????????????????????????????????????????????????????
echo.

echo ?? Compilando KeyGenerator portable (single-file)...
echo ??  Esto puede tardar unos minutos...
echo.

REM Compilar KeyGenerator como single-file portable
dotnet publish KeyGenerator\KeyGenerator.csproj ^
    --configuration Release ^
    --output ".\KeyGenerator_Portable" ^
    --self-contained true ^
    --runtime win-x64 ^
    /p:PublishSingleFile=true ^
    /p:IncludeNativeLibrariesForSelfExtract=true ^
    /p:EnableCompressionInSingleFile=true

if errorlevel 1 (
    echo.
    echo ? Error al compilar KeyGenerator
    pause
    exit /b 1
)

echo.
echo ????????????????????????????????????????????????????????
echo ? COMPILACIÓN EXITOSA - PORTABLE
echo ????????????????????????????????????????????????????????
echo.
echo ?? KeyGenerator portable: .\KeyGenerator_Portable\KeyGenerator.exe
echo.
echo ? CARACTERÍSTICAS:
echo   • UN SOLO archivo ejecutable
echo   • NO requiere .NET instalado
echo   • Funciona en cualquier Windows 10/11 x64
echo   • Tamaño: ~80-100 MB (incluye .NET runtime)
echo.
echo ?? Distribuir solo este archivo: KeyGenerator.exe
echo.

REM Copiar a carpeta Release si existe
if exist "Release" (
    echo ?? Copiando a carpeta Release...
    copy "KeyGenerator_Portable\KeyGenerator.exe" "Release\KeyGenerator_v2.3.0.exe"
    echo ? Copiado a: Release\KeyGenerator_v2.3.0.exe
    echo.
)

pause