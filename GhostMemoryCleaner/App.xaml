<Application x:Class="GhostMemoryCleaner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Futuristic Dark Color Scheme matching Ghost Optimizer -->
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="SecondaryColor">#A970FF</Color>
        <Color x:Key="SuccessColor">#00FF88</Color>
        <Color x:Key="DangerColor">#FF3B30</Color>
        
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="DarkBgBrush" Color="#0D0E12"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#161820"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2E3D"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E9297"/>
    </Application.Resources>
</Application>
