<Window x:Class="GhostMemoryCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ghost Memory Cleaner" 
        Height="540" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Estilo de Botón Futurista -->
        <Style x:Key="GlowingPrimaryButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00D9FF" Offset="0.0"/>
                        <GradientStop Color="#0066FF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="15,12">
                            <Border.Effect>
                                <DropShadowEffect Color="#00D9FF" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#33E1FF" Offset="0.0"/>
                                            <GradientStop Color="#1A75FF" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1F2330"/>
            <Setter Property="Foreground" Value="#00D9FF"/>
            <Setter Property="BorderBrush" Value="#2A2E3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2A2F42"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#00D9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fondo Principal con Borde Redondeado y Sombra Glassmorphic -->
    <Border Background="#0D0E12" CornerRadius="16" BorderBrush="#262A36" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="4" Opacity="0.7"/>
        </Border.Effect>
        
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- RAM Meter Card -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                <RowDefinition Height="Auto"/> <!-- Auto Clean Settings -->
                <RowDefinition Height="*"/>    <!-- Status / Log Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👻" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="GHOST MEMORY CLEANER" FontWeight="Black" FontSize="13" Foreground="White"/>
                        <TextBlock Text="Standby Purge &amp; RAM Optimizer" FontSize="10" Foreground="#00D9FF" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="—" Width="30" Height="26" Background="Transparent" Foreground="#8E9297" BorderThickness="0" Cursor="Hand" Click="MinimizeButton_Click" FontSize="12"/>
                    <Button Content="✕" Width="30" Height="26" Background="Transparent" Foreground="#FF5C5C" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <!-- 2. RAM Meter Card -->
            <Border Grid.Row="1" Background="#14161D" CornerRadius="12" BorderBrush="#212531" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Uso de Memoria RAM" FontSize="12" Foreground="#8E9297" FontWeight="Medium"/>
                        <TextBlock x:Name="TxtRamPercent" Text="0%" HorizontalAlignment="Right" FontSize="20" FontWeight="Black" Foreground="#00D9FF"/>
                    </Grid>

                    <!-- Barra de progreso estilizada -->
                    <Border Grid.Row="1" Height="10" Background="#212531" CornerRadius="5" Margin="0,10,0,12" ClipToBounds="True">
                        <Grid HorizontalAlignment="Left">
                            <ProgressBar x:Name="PbRamUsage" Value="0" Maximum="100" Height="10" BorderThickness="0" Background="Transparent" Foreground="#00D9FF">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Border Background="Transparent" CornerRadius="5">
                                                        <Border x:Name="PART_Track" Background="#1D202A" CornerRadius="5">
                                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="5">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Color="#00D9FF" Offset="0.0"/>
                                                                        <GradientStop Color="#A970FF" Offset="1.0"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                        </Border>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </Grid>
                    </Border>

                    <!-- Métricas detalladas -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="En Uso" FontSize="10" Foreground="#8E9297"/>
                            <TextBlock x:Name="TxtUsedMem" Text="0.0 GB" FontSize="13" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Disponible" FontSize="10" Foreground="#8E9297"/>
                            <TextBlock x:Name="TxtAvailMem" Text="0.0 GB" FontSize="13" FontWeight="Bold" Foreground="#00FF88"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="Total RAM" FontSize="10" Foreground="#8E9297"/>
                            <TextBlock x:Name="TxtTotalMem" Text="0.0 GB" FontSize="13" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. Botones de Acción -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <Button x:Name="BtnCleanAll" Content="⚡ PURGAR STANDBY &amp; LIMPIAR RAM" Style="{StaticResource GlowingPrimaryButton}" Click="BtnCleanAll_Click" Margin="0,0,0,10"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="🧹 Solo Standby List" Style="{StaticResource SecondaryActionButton}" Margin="0,0,5,0" Click="BtnPurgeStandby_Click"/>
                    <Button Grid.Column="1" Content="🔄 Vaciar Working Sets" Style="{StaticResource SecondaryActionButton}" Margin="5,0,0,0" Click="BtnTrimWorkingSets_Click"/>
                </Grid>
            </StackPanel>

            <!-- 4. Auto-Clean Config -->
            <Border Grid.Row="3" Background="#14161D" CornerRadius="10" BorderBrush="#212531" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Auto-Limpieza en segundo plano" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Purga automáticamente cada 15 min si el uso > 80%" FontSize="10" Foreground="#8E9297"/>
                    </StackPanel>
                    
                    <CheckBox x:Name="ChkAutoClean" Grid.Column="1" VerticalAlignment="Center" Cursor="Hand" Checked="ChkAutoClean_Changed" Unchecked="ChkAutoClean_Changed"/>
                </Grid>
            </Border>

            <!-- 5. Status / Log Banner -->
            <Border Grid.Row="4" x:Name="StatusBanner" Background="#121820" CornerRadius="8" BorderBrush="#1C2733" BorderThickness="1" Padding="10">
                <Grid>
                    <TextBlock x:Name="TxtStatus" Text="Listo para optimizar." FontSize="11" Foreground="#00D9FF" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
