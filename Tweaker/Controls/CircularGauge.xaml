<UserControl x:Class="Tweaker.Controls.CircularGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="130" d:DesignWidth="260">
    <UserControl.Resources>
        <Style x:Key="MetricCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#120D0D"/>
            <Setter Property="BorderBrush" Value="#221515"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF0000" BlurRadius="12" ShadowDepth="0" Opacity="0.12"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#551A1A"/>
                    <Setter Property="Background" Value="#150E0E"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FF2222" BlurRadius="16" ShadowDepth="0" Opacity="0.22"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource MetricCardBorder}" Padding="15">
        <Grid>
            <!-- View Details Button -->
            <Button Content="View Details" 
                    Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Foreground="#707070" FontSize="10" Cursor="Hand" Margin="0,0,2,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#1D1515" CornerRadius="6" Padding="8,3" BorderBrush="#2D1D1D" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFE0E0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Icon and Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="5,0,0,0">
                    <!-- Icon Box -->
                    <Border Width="38" Height="38" Background="#1A1111" CornerRadius="8" BorderBrush="#2A1A1A" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Path Data="{Binding IconData, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                              Fill="#FFE0E0" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <!-- Value Text -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:F0}}" 
                                   Foreground="#FFFFFFFF" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="%" Foreground="#FFA0A0" FontSize="16" FontWeight="Bold" Margin="2,0,0,4" VerticalAlignment="Bottom"/>
                        
                        <!-- Temperature Badge -->
                        <Border Name="TempBadge" Background="#221111" CornerRadius="4" BorderBrush="#3C1C1C" BorderThickness="1" Margin="8,0,0,4" Padding="5,2" VerticalAlignment="Bottom">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Temperature, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="-1">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Temperature, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Temperature, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:F0}°C}"
                                       Foreground="#FFA0A0" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Title/Label -->
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                               Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Right Column: Circular Gauge -->
                <Grid Grid.Column="1" Width="70" Height="70" Margin="10,0,5,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Track Circle -->
                    <Ellipse Stroke="#1A1515" StrokeThickness="4" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    
                    <!-- Center Target Dot -->
                    <Ellipse Fill="#402D2D" Width="4" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Dynamic Arc -->
                    <Path x:Name="GaugePath" 
                          Stroke="{Binding StrokeBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                          StrokeThickness="4" 
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
