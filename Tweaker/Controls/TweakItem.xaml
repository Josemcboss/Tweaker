<UserControl x:Class="Tweaker.Controls.TweakItem"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:converters="clr-namespace:Tweaker.Converters"
         mc:Ignorable="d" 
         d:DesignHeight="90" 
         d:DesignWidth="800">
    
<UserControl.Resources>
    <converters:RiskLevelToBrushConverter x:Key="RiskToBrushConverter"/>
    <converters:RiskLevelToTextConverter x:Key="RiskToTextConverter"/>
    <converters:RiskLevelToIconConverter x:Key="RiskToIconConverter"/>
</UserControl.Resources>
    
<Border Style="{DynamicResource NeonGlowCard}" Padding="25" Margin="0,0,0,15">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
            
        <!-- Content Area -->
        <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <!-- Risk Level Indicator -->
                <Grid Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                    <!-- Background Circle -->
                    <Ellipse 
                        Width="20" 
                        Height="20" 
                        Fill="{Binding Risk, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource RiskToBrushConverter}}"
                        Opacity="0.2"/>
                        
                    <!-- Icon/Text -->
                    <TextBlock 
                        Text="{Binding Risk, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource RiskToIconConverter}}"
                        FontFamily="Segoe UI Symbol"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{Binding Risk, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource RiskToBrushConverter}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <TextBlock.ToolTip>
                            <ToolTip>
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Margin="0,0,0,5">
                                        <Run Text="Nivel de Riesgo: "/>
                                        <Run Text="{Binding Risk, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource RiskToTextConverter}}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Risk, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource RiskToTextConverter}}" />
                                </StackPanel>
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </Grid>
                    
                <TextBlock x:Name="TitleText" 
                         Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         FontSize="16" 
                         FontWeight="Bold" 
                         Foreground="White"/>
                    
                <!-- Recommendation Icon -->
                <TextBlock x:Name="RecommendationIcon"
                         FontFamily="Segoe UI Emoji" 
                         FontSize="14" 
                         Margin="8,0,0,0" 
                         VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecommended, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Text" Value="?"/>
                                    <Setter Property="Foreground" Value="#0E7A0D"/>
                                    <Setter Property="ToolTip" Value="Recomendado para gaming"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRecommended, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Text" Value="??"/>
                                    <Setter Property="Foreground" Value="#FFC107"/>
                                    <Setter Property="ToolTip" Value="Avanzado - Revisar advertencias"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
                
            <TextBlock x:Name="DescriptionText"
                     Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     FontSize="11" 
                     Foreground="#A0A0A0"
                     TextWrapping="Wrap"
                     Margin="0,0,0,5"/>
        </StackPanel>
            
        <!-- Info Button -->
        <Button Grid.Column="1" 
                x:Name="InfoButton"
                Style="{StaticResource InfoButton}" 
                Margin="0,0,15,0"
                VerticalAlignment="Center"
                Click="InfoButton_Click"
                Visibility="{Binding ShowInfoButton, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            
        <!-- Control: Modern Toggle Switch -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Modern Toggle Switch (Replaces ON/OFF buttons) -->
            <CheckBox x:Name="TweakToggleSwitch"
                     Style="{StaticResource ModernToggleSwitch}"
                     Checked="TweakToggleSwitch_Checked"
                     Unchecked="TweakToggleSwitch_Unchecked"
                     ToolTip="Click para activar/desactivar tweak"/>
                
            <!-- Single Apply Button (Alternative - Hidden by default) -->
            <Button x:Name="ApplyButton"
                    Content="APLICAR" 
                    Style="{StaticResource OnButton}"
                    Background="#5865F2"
                    Width="90" 
                    Click="ApplyButton_Click"
                    Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Border>
</UserControl>