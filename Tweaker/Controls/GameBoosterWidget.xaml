<UserControl x:Class="Tweaker.Controls.GameBoosterWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="280" Height="Auto">
    
    <UserControl.Resources>
        <Storyboard x:Key="SlideIn">
            <DoubleAnimation Storyboard.TargetName="MainBorder"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                           From="300" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainBorder"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="Collapse">
            <DoubleAnimation Storyboard.TargetName="ContentPanel"
                           Storyboard.TargetProperty="Height"
                           To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="ContentPanel"
                           Storyboard.TargetProperty="Opacity"
                           To="0" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Key="Expand">
            <DoubleAnimation Storyboard.TargetName="ContentPanel"
                           Storyboard.TargetProperty="Height"
                           To="160" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="ContentPanel"
                           Storyboard.TargetProperty="Opacity"
                           To="1" Duration="0:0:0.2"/>
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="MainBorder" 
            Background="#CC1E1E1E" 
            BorderBrush="#5865F2" 
            BorderThickness="2" 
            CornerRadius="10"
            Padding="0"
            RenderTransformOrigin="0.5,0.5">
        
        <Border.RenderTransform>
            <TranslateTransform X="0" Y="0"/>
        </Border.RenderTransform>

        <Border.Effect>
            <DropShadowEffect Color="#5865F2" 
                            BlurRadius="20" 
                            ShadowDepth="0" 
                            Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    Background="#5865F2" 
                    CornerRadius="8,8,0,0" 
                    Padding="12,8"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="GAME" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Game Booster" 
                                 FontSize="14" 
                                 FontWeight="Bold" 
                                 Foreground="White"
                                 VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnToggle"
                              Content="-"
                              Click="BtnToggle_Click"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="White"
                              FontSize="16"
                              FontWeight="Bold"
                              Width="24"
                              Height="24"
                              Margin="0,0,5,0"
                              Cursor="Hand"
                              ToolTip="Minimizar/Expandir">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                      CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#4A5FC2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="X"
                              Click="BtnClose_Click"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="White"
                              FontSize="14"
                              Width="24"
                              Height="24"
                              Cursor="Hand"
                              ToolTip="Cerrar">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                      CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#DC3545"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ContentPanel" 
                   Grid.Row="1" 
                   Padding="15,12"
                   Height="160">
                <StackPanel>
                    <Border Background="#2A2D31" 
                           CornerRadius="5" 
                           Padding="10,8"
                           Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Ellipse x:Name="StatusLed" 
                                    Grid.Column="0"
                                    Width="10" 
                                    Height="10" 
                                    Fill="#808080"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#808080" 
                                                    BlurRadius="10" 
                                                    ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Estado:" 
                                         FontSize="10" 
                                         Foreground="#808080" 
                                         Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtStatus" 
                                         Text="Escritorio" 
                                         FontSize="13" 
                                         FontWeight="SemiBold"
                                         Foreground="White"
                                         TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Auto-Deteccion" 
                                 FontSize="12" 
                                 Foreground="White"
                                 VerticalAlignment="Center"/>
                        
                        <ToggleButton x:Name="ToggleAutoBooster"
                                    HorizontalAlignment="Right"
                                    Width="50"
                                    Height="24"
                                    Checked="ToggleAutoBooster_Checked"
                                    Unchecked="ToggleAutoBooster_Unchecked"
                                    Cursor="Hand">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid>
                                                    <Border x:Name="TrackBorder"
                                                          Background="#3A3D41"
                                                          CornerRadius="12"
                                                          Width="50"
                                                          Height="24"/>
                                                    
                                                    <Ellipse x:Name="ThumbEllipse"
                                                           Width="18"
                                                           Height="18"
                                                           Fill="White"
                                                           HorizontalAlignment="Left"
                                                           Margin="3,0,0,0">
                                                        <Ellipse.RenderTransform>
                                                            <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Grid>
                                                
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="TrackBorder"
                                                                                  Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                  To="#5865F2"
                                                                                  Duration="0:0:0.2"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                                                   Storyboard.TargetProperty="X"
                                                                                   To="26"
                                                                                   Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="TrackBorder"
                                                                                  Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                  To="#3A3D41"
                                                                                  Duration="0:0:0.2"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                                                   Storyboard.TargetProperty="X"
                                                                                   To="0"
                                                                                   Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>

                    <TextBlock Text="Detecta juegos automaticamente y optimiza el sistema"
                             FontSize="10"
                             Foreground="#808080"
                             TextWrapping="Wrap"
                             LineHeight="14"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
