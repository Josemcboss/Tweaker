<UserControl x:Class="Tweaker.Controls.TweakSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" 
             d:DesignWidth="800">
    
    <StackPanel Margin="40">
        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="IconText"
                     Text="{Binding SectionIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     FontFamily="Segoe UI Emoji" 
                     FontSize="28" 
                     FontWeight="Bold" 
                     VerticalAlignment="Center"
                     Margin="0,0,10,0"/>
            <TextBlock x:Name="TitleText"
                     Text="{Binding SectionTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     FontSize="28" 
                     FontWeight="Bold" 
                     Foreground="White"
                     VerticalAlignment="Center"/>
        </StackPanel>
        
        <TextBlock x:Name="SubtitleText"
                 Text="{Binding SectionSubtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 FontSize="14" 
                 Foreground="#A0A0A0" 
                 Margin="0,0,0,30"/>
        
        <!-- Content Area - Donde se agregan los TweakItems -->
        <ItemsControl x:Name="TweaksContainer" 
                     ItemsSource="{Binding TweakItems, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Los TweakItems se agregaran aqui dinamicamente -->
                    <ContentPresenter Content="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <!-- Additional Content Area -->
        <ContentPresenter Content="{Binding AdditionalContent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </StackPanel>
</UserControl>