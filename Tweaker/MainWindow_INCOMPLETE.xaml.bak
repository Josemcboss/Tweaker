<Window x:Class="Tweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tweaker - Gaming Dashboard" 
        Height="900" 
        Width="1400"
        Background="#0F0F0F"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="False">

    <Window.Resources>
        <!-- ??????????????????????????????????????????????????????????????? -->
        <!-- ESTILOS MODERNOS (HONE.GG / DISCORD STYLE) -->
        <!-- ??????????????????????????????????????????????????????????????? -->

        <!-- Bot�n del Sidebar (Men� Lateral) -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B9BBBE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,3,0"
                                BorderBrush="Transparent"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2D31"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Active">
                                <Setter TargetName="border" Property="BorderBrush" Value="#5865F2"/>
                                <Setter Property="Background" Value="#35363C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bot�n ON (verde gaming) -->
        <Style x:Key="OnButton" TargetType="Button">
            <Setter Property="Background" Value="#0E7A0D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#107C10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#11910F"/>
                    <Setter Property="BorderBrush" Value="#13A813"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Bot�n OFF (rojo gaming) -->
        <Style x:Key="OffButton" TargetType="Button">
            <Setter Property="Background" Value="#A80000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C50500"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C50500"/>
                    <Setter Property="BorderBrush" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- T�tulo de secci�n -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Descripci�n -->
        <Style x:Key="Description" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

    </Window.Resources>

    <!-- ??????????????????????????????????????????????????????????????????? -->
    <!-- ESTRUCTURA PRINCIPAL: GRID DE 2 COLUMNAS -->
    <!-- ??????????????????????????????????????????????????????????????????? -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Columna 0: Sidebar (Men� Lateral) -->
            <ColumnDefinition Width="240"/>
            <!-- Columna 1: �rea de Contenido -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ??????????????????????????????????????????????????????????????? -->
        <!-- COLUMNA 0: SIDEBAR (MEN� LATERAL) -->
        <!-- ??????????????????????????????????????????????????????????????? -->
        <Border Grid.Column="0" 
                Background="#1E1E1E" 
                BorderBrush="#2A2A2A" 
                BorderThickness="0,0,1,0">
            <StackPanel>
                <!-- Header del Sidebar -->
                <Border Background="#151515" 
                        Padding="20,25"
                        BorderBrush="#2A2A2A"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="? TWEAKER" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="#5865F2"/>
                        <TextBlock Text="Gaming Dashboard" 
                                   FontSize="11" 
                                   Foreground="#7F8084"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Botones de Navegaci�n -->
                <StackPanel Margin="0,15,0,0">
                    <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToDashboard"
                            x:Name="BtnNavDashboard"
                            Tag="Active">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="??" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToInput"
                            x:Name="BtnNavInput">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="??" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Input &amp; Visuals" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToNetwork"
                            x:Name="BtnNavNetwork">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="??" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Red &amp; Ping" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToSystem"
                            x:Name="BtnNavSystem">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="??" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Sistema &amp; GPU" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToCleanup"
                            x:Name="BtnNavCleanup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="???" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="Limpieza" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToFr33thy"
                            x:Name="BtnNavFr33thy">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="??" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="FR33THY Pack" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer del Sidebar -->
                <Border Background="#151515" 
                        Padding="15"
                        BorderBrush="#2A2A2A"
                        BorderThickness="0,1,0,0"
                        VerticalAlignment="Bottom"
                        Margin="0,180,0,0">
                    <StackPanel>
                        <TextBlock Text="?? Ejecutar como Admin" 
                                   FontSize="10" 
                                   Foreground="#FFC107"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="v2.0 - DaddyGhost" 
                                   FontSize="9" 
                                   Foreground="#5F5F5F"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ??????????????????????????????????????????????????????????????? -->
        <!-- COLUMNA 1: �REA DE CONTENIDO (PESTA�AS) -->
        <!-- ??????????????????????????????????????????????????????????????? -->
        <Grid Grid.Column="1" Background="#252526">
            
            <!-- Dashboard Page -->
            <ScrollViewer x:Name="DashboardPage" 
                          Visibility="Visible" 
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40">
                    <TextBlock Text="?? Dashboard" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Optimizador Gaming Profesional" 
                               FontSize="14" 
                               Foreground="#A0A0A0"
                               Margin="0,0,0,30"/>

                    <!-- Stats Cards -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1 -->
                        <Border Grid.Column="0" 
                                Background="#1E1E1E" 
                                CornerRadius="8" 
                                Padding="20"
                                Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="26" FontSize="32" FontWeight="Bold" Foreground="#5865F2"/>
                                <TextBlock Text="Tweaks Disponibles" FontSize="12" Foreground="#A0A0A0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2 -->
                        <Border Grid.Column="1" 
                                Background="#1E1E1E" 
                                CornerRadius="8" 
                                Padding="20"
                                Margin="5,0">
                            <StackPanel>
                                <TextBlock Text="8" FontSize="32" FontWeight="Bold" Foreground="#0E7A0D"/>
                                <TextBlock Text="Categor�as" FontSize="12" Foreground="#A0A0A0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3 -->
                        <Border Grid.Column="2" 
                                Background="#1E1E1E" 
                                CornerRadius="8" 
                                Padding="20"
                                Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="FR33THY" FontSize="18" FontWeight="Bold" Foreground="#FF6B35"/>
                                <TextBlock Text="Pack Incluido" FontSize="12" Foreground="#A0A0A0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Info Section -->
                    <Border Background="#1E1E1E" 
                            CornerRadius="8" 
                            Padding="25"
                            Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="?? Gu�a R�pida" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       Margin="0,0,0,15"/>
                            
                            <TextBlock TextWrapping="Wrap" Foreground="#B9BBBE" LineHeight="22">
                                <Run Text="1. " FontWeight="Bold"/>
                                <Run Text="Navega por las categor�as del men� lateral"/>
                                <LineBreak/>
                                <Run Text="2. " FontWeight="Bold"/>
                                <Run Text="Activa los tweaks con el bot�n ON (verde)"/>
                                <LineBreak/>
                                <Run Text="3. " FontWeight="Bold"/>
                                <Run Text="Desactiva con el bot�n OFF (rojo) si quieres revertir"/>
                                <LineBreak/>
                                <Run Text="4. " FontWeight="Bold"/>
                                <Run Text="Reinicia Windows despu�s de aplicar tweaks importantes"/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="?? Recomendado: Crea un punto de restauraci�n antes de empezar" 
                                     Foreground="#FFC107" 
                                     FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Quick Actions -->
                    <Border Background="#1E1E1E" 
                            CornerRadius="8" 
                            Padding="25"
                            Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="? Acciones R�pidas" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       Margin="0,0,0,15"/>
                            
                            <Button Content="??? Crear Punto de Restauraci�n" 
                                    Style="{StaticResource OnButton}"
                                    HorizontalAlignment="Left"
                                    Padding="20,12"
                                    Margin="0,0,0,10"
                                    Click="CreateRestorePoint"/>
                            
                            <TextBlock Text="Categor�as Populares:" 
                                       FontSize="14" 
                                       Foreground="#A0A0A0"
                                       Margin="0,15,0,10"/>
                            
                            <WrapPanel>
                                <Button Content="?? Red &amp; Ping" 
                                        Background="#2A2D31"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="15,10"
                                        Margin="0,0,10,10"
                                        Cursor="Hand"
                                        Click="NavigateToNetwork"/>
                                <Button Content="?? FR33THY Pack" 
                                        Background="#2A2D31"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="15,10"
                                        Margin="0,0,10,10"
                                        Cursor="Hand"
                                        Click="NavigateToFr33thy"/>
                                <Button Content="?? Input &amp; Visuals" 
                                        Background="#2A2D31"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="15,10"
                                        Cursor="Hand"
                                        Click="NavigateToInput"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TODO: Las dem�s p�ginas las agrego en la siguiente parte -->
            <!-- Input Page -->
            <ScrollViewer x:Name="InputPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40">
                    <TextBlock Text="⌨️ Input &amp; Visuals" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                    <TextBlock Text="Optimizaciones de Input Lag, FPS y Responsividad" FontSize="14" Foreground="#A0A0A0" Margin="0,0,0,30"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Network Page -->
            <ScrollViewer x:Name="NetworkPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40">
                    <TextBlock Text="?? Red &amp; Ping" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,30"/>
                    <!-- Contenido se agrega aqu� -->
                </StackPanel>
            </ScrollViewer>

            <!-- System Page -->
            <ScrollViewer x:Name="SystemPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40">
                    <TextBlock Text="?? Sistema &amp; GPU" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,30"/>
                    <!-- Contenido se agrega aqu� -->
                </StackPanel>
            </ScrollViewer>

            <!-- Cleanup Page -->
            <ScrollViewer x:Name="CleanupPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40">
                    <TextBlock Text="??? Limpieza" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,30"/>
                    <!-- Contenido se agrega aqu� -->
                </StackPanel>
            </ScrollViewer>

            <!-- FR33THY Page -->
            <ScrollViewer x:Name="Fr33thyPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40">
                    <TextBlock Text="?? FR33THY PACK" FontSize="28" FontWeight="Bold" Foreground="#FF6B35" Margin="0,0,0,30"/>
                    <!-- Contenido se agrega aqu� -->
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
