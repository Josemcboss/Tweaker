<UserControl x:Class="Tweaker.Resources.GhostOptimizerLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Stretch="Uniform">
        <Grid Width="120" Height="120">
            <!-- Definir gradientes y efectos -->
            <Grid.Resources>
                <!-- Gradiente morado-naranja para el anillo -->
                <LinearGradientBrush x:Key="NeonRingBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF8A2BE2" Offset="0"/>
                    <GradientStop Color="#FFFF4500" Offset="0.5"/>
                    <GradientStop Color="#FF8A2BE2" Offset="1"/>
                </LinearGradientBrush>
                
                <!-- Gradiente morado para el fantasma -->
                <LinearGradientBrush x:Key="GhostBrush" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF8A2BE2" Offset="0"/>
                    <GradientStop Color="#FF4B0082" Offset="1"/>
                </LinearGradientBrush>
                
                <!-- Efecto de resplandor -->
                <DropShadowEffect x:Key="NeonGlow" 
                                  Color="#FF8A2BE2" 
                                  BlurRadius="15" 
                                  ShadowDepth="0" 
                                  Opacity="0.8"/>
                
                <DropShadowEffect x:Key="RedGlow" 
                                  Color="#FFFF0000" 
                                  BlurRadius="10" 
                                  ShadowDepth="0" 
                                  Opacity="1"/>
            </Grid.Resources>
            
            <!-- Anillo exterior -->
            <Ellipse Width="120" Height="120" 
                     Stroke="{StaticResource NeonRingBrush}" 
                     StrokeThickness="3"
                     Effect="{StaticResource NeonGlow}"
                     Fill="Transparent"/>
            
            <!-- Anillo interior -->
            <Ellipse Width="110" Height="110" 
                     Stroke="{StaticResource NeonRingBrush}" 
                     StrokeThickness="1.5"
                     Fill="Transparent"
                     Opacity="0.7"/>
            
            <!-- Fondo del fantasma -->
            <Ellipse Width="90" Height="90" 
                     Fill="#FF1a1a1a" 
                     Opacity="0.8"/>
            
            <!-- Cuerpo del fantasma simplificado -->
            <Grid Width="60" Height="60">
                <!-- Cabeza del fantasma como elipse -->
                <Ellipse Width="50" Height="35"
                         Fill="{StaticResource GhostBrush}"
                         Stroke="#FF8A2BE2"
                         StrokeThickness="1"
                         Effect="{StaticResource NeonGlow}"
                         VerticalAlignment="Top"
                         Margin="5,10,5,0"/>
                
                <!-- Parte inferior como rectangulo redondeado -->
                <Border Width="50" Height="25"
                        Background="{StaticResource GhostBrush}"
                        BorderBrush="#FF8A2BE2"
                        BorderThickness="1"
                        Effect="{StaticResource NeonGlow}"
                        VerticalAlignment="Bottom"
                        Margin="5,0,5,10"
                        CornerRadius="0,0,8,8"/>
                
                <!-- Ondas inferiores -->
                <Grid Width="50" Height="8" VerticalAlignment="Bottom" Margin="5,0,5,10">
                    <Rectangle Width="10" Height="8" Fill="{StaticResource GhostBrush}" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                    <Rectangle Width="10" Height="8" Fill="{StaticResource GhostBrush}" HorizontalAlignment="Center"/>
                    <Rectangle Width="10" Height="8" Fill="{StaticResource GhostBrush}" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                </Grid>
                
                <!-- Ojos rojos -->
                <Ellipse Width="6" Height="8" 
                         Fill="#FFFF0000"
                         Effect="{StaticResource RedGlow}"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="18,20,0,0"/>
                
                <Ellipse Width="6" Height="8" 
                         Fill="#FFFF0000"
                         Effect="{StaticResource RedGlow}"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,20,18,0"/>
                
                <!-- Brillo en los ojos -->
                <Ellipse Width="2" Height="3" 
                         Fill="#FFFFFF"
                         Opacity="0.8"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="19,21,0,0"/>
                <Ellipse Width="2" Height="3" 
                         Fill="#FFFFFF"
                         Opacity="0.8"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,21,19,0"/>
            </Grid>
            
            <!-- Texto GHOST -->
            <TextBlock Text="GHOST" 
                       FontFamily="Impact, Arial Black"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{StaticResource NeonRingBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,20"
                       Effect="{StaticResource NeonGlow}"/>
            
            <!-- Texto OPTIMIZER -->
            <TextBlock Text="OPTIMIZER" 
                       FontFamily="Impact, Arial Black"
                       FontSize="8"
                       FontWeight="Bold"
                       Foreground="#FFFF4500"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,8"
                       Effect="{StaticResource NeonGlow}"/>
            
            <!-- Circuitos decorativos simplificados -->
            <Canvas Width="140" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <!-- Lineas de circuito -->
                <Line X1="0" Y1="70" X2="20" Y2="70" Stroke="#FF4B0082" StrokeThickness="1" Opacity="0.5"/>
                <Line X1="120" Y1="70" X2="140" Y2="70" Stroke="#FF4B0082" StrokeThickness="1" Opacity="0.5"/>
                <Line X1="70" Y1="0" X2="70" Y2="20" Stroke="#FF4B0082" StrokeThickness="1" Opacity="0.5"/>
                <Line X1="70" Y1="120" X2="70" Y2="140" Stroke="#FF4B0082" StrokeThickness="1" Opacity="0.5"/>
                
                <!-- Puntos de conexion -->
                <Ellipse Canvas.Left="15" Canvas.Top="67" Width="6" Height="6" Fill="#FF8A2BE2" Opacity="0.7"/>
                <Ellipse Canvas.Left="119" Canvas.Top="67" Width="6" Height="6" Fill="#FF8A2BE2" Opacity="0.7"/>
                <Ellipse Canvas.Left="67" Canvas.Top="15" Width="6" Height="6" Fill="#FF8A2BE2" Opacity="0.7"/>
                <Ellipse Canvas.Left="67" Canvas.Top="119" Width="6" Height="6" Fill="#FF8A2BE2" Opacity="0.7"/>
            </Canvas>
            
            <!-- Animacion de pulso -->
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Grid.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.8" To="1.0" Duration="0:0:1.5"
                                             AutoReverse="True"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>
    </Viewbox>
</UserControl>