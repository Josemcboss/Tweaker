<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Logo completo GHOST OPTIMIZER -->
    <DrawingImage x:Key="GhostOptimizerIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Fondo circular -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF0A0A0A" Offset="0"/>
                            <GradientStop Color="#FF1A1A1A" Offset="1"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="32,32" RadiusX="30" RadiusY="30"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                
                <!-- Anillo neon morado -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Thickness="3">
                            <Pen.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF8A2BE2" Offset="0"/>
                                    <GradientStop Color="#FFFF4500" Offset="0.5"/>
                                    <GradientStop Color="#FF8A2BE2" Offset="1"/>
                                </LinearGradientBrush>
                            </Pen.Brush>
                        </Pen>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="32,32" RadiusX="28" RadiusY="28"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                
                <!-- Cuerpo del fantasma -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF8A2BE2" Offset="0"/>
                            <GradientStop Color="#FF4B0082" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <PathGeometry>
                            <PathFigure StartPoint="20,18">
                                <QuadraticBezierSegment Point1="20,12" Point2="26,12"/>
                                <QuadraticBezierSegment Point1="32,12" Point2="38,12"/>
                                <QuadraticBezierSegment Point1="44,12" Point2="44,18"/>
                                <LineSegment Point="44,35"/>
                                <QuadraticBezierSegment Point1="44,45" Point2="32,45"/>
                                <QuadraticBezierSegment Point1="20,45" Point2="20,35"/>
                                <PathFigure.IsClosed>True</PathFigure.IsClosed>
                            </PathFigure>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                
                <!-- Parte inferior ondulada -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF8A2BE2" Offset="0"/>
                            <GradientStop Color="#FF4B0082" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <PathGeometry>
                            <PathFigure StartPoint="20,35">
                                <LineSegment Point="20,48"/>
                                <QuadraticBezierSegment Point1="24,44" Point2="28,48"/>
                                <QuadraticBezierSegment Point1="32,52" Point2="36,48"/>
                                <QuadraticBezierSegment Point1="40,44" Point2="44,48"/>
                                <LineSegment Point="44,35"/>
                                <PathFigure.IsClosed>True</PathFigure.IsClosed>
                            </PathFigure>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                
                <!-- Ojos rojos -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#FFFF0000"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="27,25" RadiusX="3" RadiusY="4"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#FFFF0000"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="37,25" RadiusX="3" RadiusY="4"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                
                <!-- Brillos en los ojos -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#FFFFFF"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="28,23" RadiusX="1" RadiusY="1.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <SolidColorBrush Color="#FFFFFF"/>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="38,23" RadiusX="1" RadiusY="1.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    
</ResourceDictionary>