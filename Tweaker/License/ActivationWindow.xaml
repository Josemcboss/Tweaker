<Window x:Class="Tweaker.License.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activación de Tweaker" 
        Height="400" 
        Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        WindowStyle="SingleBorderWindow">
    
    <Window.Resources>
        <!-- Estilo para TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <!-- Estilo para Button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1177BB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3F3F46"/>
                    <Setter Property="Foreground" Value="#777777"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" 
                   Text="🔐 Activación de Licencia"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#FFFFFF"
                   Margin="0,0,0,20"/>

        <!-- Información del Hardware ID -->
        <Border Grid.Row="1" 
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="3"
                Padding="15"
                Margin="0,0,0,20">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="ID del Hardware (para soporte):"
                              FontWeight="SemiBold"
                              DockPanel.Dock="Left"
                              VerticalAlignment="Center"/>
                    <Button x:Name="BtnCopyFingerprint"
                           Content="📋 Copiar"
                           Click="BtnCopyFingerprint_Click"
                           DockPanel.Dock="Right"
                           Padding="8,4"
                           FontSize="11"
                           Margin="10,0,0,0"
                           ToolTip="Copiar fingerprint completo al portapapeles"/>
                </DockPanel>
                <TextBox x:Name="TxtHardwareId"
                        IsReadOnly="True"
                        TextAlignment="Center"
                        FontWeight="Bold"
                        FontSize="12"
                        Foreground="#4EC9B0"
                        TextWrapping="Wrap"/>
                <TextBlock Text="💡 Envía este ID completo para generar tu clave de licencia"
                          FontSize="10"
                          Foreground="#888888"
                          Margin="0,5,0,0"
                          TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Input de Llave de Licencia -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Llave de Licencia:"
                      FontWeight="SemiBold"
                      Margin="0,0,0,8"/>
            <TextBox x:Name="TxtLicenseKey"
                    CharacterCasing="Upper"
                    MaxLength="23"
                    TextChanged="TxtLicenseKey_TextChanged"
                    ToolTip="Formato: XXXXX-XXXXX-XXXXX-XXXXX"/>
        </StackPanel>

        <!-- Mensaje de Estado -->
        <Border Grid.Row="3"
                x:Name="BorderStatus"
                Background="#2D2D30"
                BorderBrush="#3F3F46"
                BorderThickness="1"
                CornerRadius="3"
                Padding="12"
                Margin="0,0,0,15"
                Visibility="Collapsed">
            <TextBlock x:Name="TxtStatus"
                      TextWrapping="Wrap"
                      FontSize="12"/>
        </Border>

        <!-- Botones -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                   Content="&#x2705; Activar"
                   x:Name="BtnActivate"
                   Click="BtnActivate_Click"
                   IsEnabled="False"
                   MinWidth="120"/>

            <Button Grid.Column="3"
                   Content="&#x274C; Cancelar"
                   x:Name="BtnCancel"
                   Click="BtnCancel_Click"
                   Background="#3C3C3C"
                   MinWidth="120"/>
        </Grid>
    </Grid>
</Window>
