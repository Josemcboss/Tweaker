<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\GhostOptimizer.ico</ApplicationIcon>
    
    <!-- Información de la aplicación -->
    <PackageId>GhostOptimizer</PackageId>
    <Title>Ghost Optimizer</Title>
    <Product>Ghost Optimizer</Product>
    <Company>DaddyGhost</Company>
    <Description>Advanced Gaming Performance Tweaker</Description>
    <Copyright>Copyright © 2024 DaddyGhost</Copyright>
    <AssemblyVersion>2.3.0.0</AssemblyVersion>
    <FileVersion>2.3.0.0</FileVersion>
    <Version>2.3.0</Version>
    
    <!-- Configuración de publicación optimizada -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Self-contained solo para publicación, no para desarrollo -->
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <SelfContained Condition="'$(Configuration)' != 'Release'">false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>link</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
    
    <!-- Configuración de Runtime (solo para Release) -->
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <UseAppHost>true</UseAppHost>
    
    <!-- Optimizaciones adicionales -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunShowWarnings>false</PublishReadyToRunShowWarnings>
    <EnablePreviewFeatures>false</EnablePreviewFeatures>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referencia para ServiceController (gestión de servicios de Windows) -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre649" />
    <!-- LiveCharts2 removed due to restore conflicts; using custom WPF rendering for TemperatureGraph -->
    
    <!-- Referencia para WMI (obtener info del sistema) -->
    <PackageReference Include="System.Management" Version="10.0.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.103" PrivateAssets="all" />
  </ItemGroup>

</Project>
