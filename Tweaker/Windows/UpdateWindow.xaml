<Window x:Class="Tweaker.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available - Ghost Optimizer"
        Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F0F0F"
        WindowStyle="None"
        AllowsTransparency="True">
    
    <Border BorderBrush="#5865F2" BorderThickness="2" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#5865F2" CornerRadius="8,8,0,0" Padding="20,15">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="UPDATE" FontSize="24" Margin="0,0,10,0" Foreground="White"/>
                        <StackPanel>
                            <TextBlock x:Name="TxtTitle" Text="Nueva Actualizacion Disponible" 
                                     FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="TxtVersionInfo" Text="Version X.X.X disponible" 
                                     FontSize="12" Foreground="#E0E0E0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="X" 
                            HorizontalAlignment="Right"
                            Click="BtnClose_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="16"
                            Padding="10,0"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <!-- Changelog -->
                    <TextBlock Text="Novedades en esta version:" 
                             FontSize="14" FontWeight="Bold" 
                             Foreground="White" Margin="0,0,0,10"/>
                    
                    <Border Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                        <TextBlock x:Name="TxtChangelog" 
                                 TextWrapping="Wrap" 
                                 Foreground="#B0B0B0"
                                 FontSize="12"
                                 LineHeight="20"/>
                    </Border>

                    <!-- Release Notes -->
                    <Border x:Name="BorderReleaseNotes" Background="#1E1E1E" 
                            CornerRadius="8" Padding="15" Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Notas de la version:" 
                                     FontSize="12" FontWeight="Bold" 
                                     Foreground="White" Margin="0,0,0,5"/>
                            <TextBlock x:Name="TxtReleaseNotes" 
                                     TextWrapping="Wrap" 
                                     Foreground="#B0B0B0"
                                     FontSize="11"
                                     LineHeight="18"/>
                        </StackPanel>
                    </Border>

                    <!-- Critical Update Warning -->
                    <Border x:Name="BorderCriticalWarning" 
                            Background="#FF6B6B" 
                            CornerRadius="8" 
                            Padding="15" 
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WARNING" FontSize="16" Margin="0,0,10,0" FontWeight="Bold"/>
                            <TextBlock Text="Actualizacion Critica: Esta actualizacion corrige problemas de seguridad o errores criticos. Se recomienda actualizar inmediatamente."
                                     TextWrapping="Wrap"
                                     Foreground="White"
                                     FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- File Info -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Tamano: " Foreground="#808080" FontSize="11"/>
                        <TextBlock x:Name="TxtFileSize" Text="XX MB" Foreground="White" FontSize="11"/>
                        <TextBlock Text=" | " Foreground="#808080" FontSize="11" Margin="10,0"/>
                        <TextBlock Text="Publicado: " Foreground="#808080" FontSize="11"/>
                        <TextBlock x:Name="TxtReleaseDate" Text="XX/XX/XXXX" Foreground="White" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Progress Bar (Hidden by default) -->
            <StackPanel Grid.Row="2" x:Name="PanelProgress" Visibility="Collapsed" Margin="20,10">
                <TextBlock x:Name="TxtProgressStatus" 
                         Text="Descargando..." 
                         Foreground="White" 
                         FontSize="12" 
                         Margin="0,0,0,5"/>
                <ProgressBar x:Name="ProgressDownload" 
                           Height="6" 
                           Background="#1E1E1E" 
                           Foreground="#5865F2"
                           Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="TxtProgressDetails" 
                         Text="0 MB / 0 MB (0%)" 
                         Foreground="#808080" 
                         FontSize="10" 
                         Margin="0,5,0,0"
                         HorizontalAlignment="Right"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" 
                      HorizontalAlignment="Right" 
                      Margin="20,10,20,20">
                <Button x:Name="BtnLater" 
                      Content="Recordar mas tarde" 
                      Click="BtnLater_Click"
                      Background="#2A2D31" 
                      Foreground="White"
                      BorderThickness="0"
                      Padding="20,10"
                      FontSize="12"
                      Cursor="Hand"
                      Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2A2D31"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                              CornerRadius="5" 
                                              Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#35383D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="BtnUpdate" 
                      Content="Actualizar Ahora" 
                      Click="BtnUpdate_Click"
                      Background="#5865F2" 
                      Foreground="White"
                      BorderThickness="0"
                      Padding="20,10"
                      FontSize="12"
                      FontWeight="Bold"
                      Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#5865F2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                              CornerRadius="5" 
                                              Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#6875F5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
