<Window x:Class="Tweaker.Windows.DebloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Tweaker.Converters"
        Title="Debloat Wizard - Ghost Optimizer" 
        Height="700" 
        Width="900"
        Background="#0F0F0F"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="False">

    <Window.Resources>
        <Style x:Key="NeonGlowCard" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <RadialGradientBrush>
                        <GradientStop Color="#CC1E1E1E" Offset="0"/>
                        <GradientStop Color="#CC151515" Offset="1"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#404040" Offset="0"/>
                        <GradientStop Color="#101010" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OnButton" TargetType="Button">
            <Setter Property="Background" Value="#0E7A0D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#107C10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#11910F"/>
                    <Setter Property="BorderBrush" Value="#13A813"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <converters:RiskLevelToBrushConverter x:Key="RiskLevelToColorConverter"/>
        <converters:RiskLevelToIconConverter x:Key="RiskLevelToIconConverter"/>
        <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1A1A1A" BorderThickness="0,0,0,1" BorderBrush="#2A2A2A"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="DEBLOAT WIZARD" FontSize="12" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Grid.Column="1" Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                        Click="CloseButton_Click">
                    <TextBlock Text="X" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                
                <Border Style="{StaticResource NeonGlowCard}" Padding="25" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Asistente de Limpieza Segura" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                        <TextBlock Text="Elimina bloatware y apps innecesarias de Windows" FontSize="13" Foreground="#B9BBBE" TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding TotalItemsSelected}" FontSize="28" FontWeight="Bold" Foreground="#5865F2"/>
                                <TextBlock Text="Seleccionados" FontSize="11" Foreground="#7F8084"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding EstimatedRamFreed}" FontSize="28" FontWeight="Bold" Foreground="#0E7A0D"/>
                                    <TextBlock Text=" MB" FontSize="16" FontWeight="Bold" Foreground="#7F8084" Margin="3,10,0,0"/>
                                </StackPanel>
                                <TextBlock Text="RAM liberada" FontSize="11" Foreground="#7F8084"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding EstimatedDiskFreed}" FontSize="28" FontWeight="Bold" Foreground="#9B59B6"/>
                                    <TextBlock Text=" MB" FontSize="16" FontWeight="Bold" Foreground="#7F8084" Margin="3,10,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Disco liberado" FontSize="11" Foreground="#7F8084"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Content="SELECCIONAR RECOMENDADOS" Style="{StaticResource OnButton}"
                            Background="#5865F2" BorderBrush="#4752C4" Padding="20,12" FontSize="13"
                            Click="SelectRecommended_Click" Margin="0,0,15,0"/>
                    
                    <Button Content="EJECUTAR LIMPIEZA" Style="{StaticResource OnButton}" Padding="20,12" FontSize="13"
                            Click="ExecuteDebloat_Click"
                            IsEnabled="{Binding TotalItemsSelected, Converter={StaticResource GreaterThanZeroConverter}}"/>
                </StackPanel>

                <ListView ItemsSource="{Binding DebloatItems}" Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="Transparent" Margin="0,0,0,10">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource NeonGlowCard}" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,15,0"/>

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Risk, Converter={StaticResource RiskLevelToIconConverter}}" 
                                                       FontSize="14"
                                                       Foreground="{Binding Risk, Converter={StaticResource RiskLevelToColorConverter}}"
                                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                            
                                            <Border Background="#0E7A0D" CornerRadius="3" Padding="6,2" Margin="10,0,0,0"
                                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="RECOMENDADO" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#7F8084"
                                                   TextWrapping="Wrap" Margin="0,0,0,5"/>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#5865F2" Margin="0,0,15,0"/>
                                            <TextBlock Text="{Binding EstimatedRamFreedMB, StringFormat={}{0} MB RAM}" FontSize="10" Foreground="#0E7A0D" Margin="0,0,15,0"/>
                                            <TextBlock Text="{Binding EstimatedDiskFreedMB, StringFormat={}{0} MB Disco}" FontSize="10" Foreground="#9B59B6"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Style="{StaticResource NeonGlowCard}" Padding="20" Margin="0,20,0,0"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#00D9FF" TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
