<Window x:Class="Tweaker.Windows.Win32PriorityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win32 Priority Adjuster - Ghost Optimizer" 
        Height="620" 
        Width="520"
        Background="#0F0F0F"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="OptionCard" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#00D9FF"/>
                    <Setter Property="Background" Value="#252525"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Apply Button Style -->
        <Style x:Key="ApplyButton" TargetType="Button">
            <Setter Property="Background" Value="#00D9FF"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00BCD4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cancel Button Style -->
        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A1A1A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Radio Button Style -->
        <Style x:Key="CustomRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="#151515" BorderThickness="0,0,0,1" BorderBrush="#2A2A2A"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="WIN32 PRIORITY ADJUSTER" FontSize="11" FontFamily="Segoe UI" FontWeight="Bold" Foreground="#A970FF"
                           VerticalAlignment="Center" Margin="15,0,0,0"/>
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="CancelButton_Click">
                    <TextBlock Text="✕" FontSize="12"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="25,20,25,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Win32 CPU Scheduling" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                <TextBlock Text="Configura el quantum (porción de tiempo) que la CPU otorga a la ventana activa (Foreground) frente a las tareas secundarias (Background)." 
                           FontSize="12" Foreground="#8A8F98" TextWrapping="Wrap" LineHeight="16"/>
            </StackPanel>

            <!-- Scrollable list of priority values -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0">
                <StackPanel>
                    
                    <!-- FAST & RESPONSIVE -->
                    <TextBlock Text="⚡ MÁXIMA RESPONSIVIDAD (FAST QUANTUMS)" FontSize="11" FontWeight="Bold" Foreground="#00D9FF" Margin="0,5,0,8"/>

                    <Border Style="{StaticResource OptionCard}">
                        <RadioButton Name="Radio2A" Style="{StaticResource CustomRadioButton}" GroupName="PriorityGroup">
                            <StackPanel Margin="5,-1,0,0">
                                <TextBlock Text="Max Responsiveness (Most Aggressive)" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="0x2A (42) — Prioridad extrema a la ventana activa. Ideal para esports." FontSize="11" Foreground="#8A8F98" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Style="{StaticResource OptionCard}">
                        <RadioButton Name="Radio29" Style="{StaticResource CustomRadioButton}" GroupName="PriorityGroup">
                            <StackPanel Margin="5,-1,0,0">
                                <TextBlock Text="Balanced Fast + Stable" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="0x29 (41) — Respuesta muy rápida con excelente consistencia de frametime." FontSize="11" Foreground="#8A8F98" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Style="{StaticResource OptionCard}">
                        <RadioButton Name="Radio28" Style="{StaticResource CustomRadioButton}" GroupName="PriorityGroup">
                            <StackPanel Margin="5,-1,0,0">
                                <TextBlock Text="Fast but More Stable" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="0x28 (40) — Transición fluida de procesos, recomendada para streaming." FontSize="11" Foreground="#8A8F98" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <!-- FAST & ADAPTIVE -->
                    <TextBlock Text="🎯 ADAPTATIVO RECOMENDADO (VARIABLE QUANTUMS)" FontSize="11" FontWeight="Bold" Foreground="#A970FF" Margin="0,10,0,8"/>

                    <Border Style="{StaticResource OptionCard}">
                        <RadioButton Name="Radio26" Style="{StaticResource CustomRadioButton}" GroupName="PriorityGroup">
                            <StackPanel Margin="5,-1,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Fast and Adaptive [Recomendado]" FontWeight="Bold" Foreground="White"/>
                                    <Border Background="#2A00D9FF" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="DEFAULT GHOST" FontSize="9" FontWeight="Bold" Foreground="#00D9FF"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="0x26 (38) — Fuerte enfoque en tu juego con adaptabilidad dinámica." FontSize="11" Foreground="#8A8F98" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Style="{StaticResource OptionCard}">
                        <RadioButton Name="Radio25" Style="{StaticResource CustomRadioButton}" GroupName="PriorityGroup">
                            <StackPanel Margin="5,-1,0,0">
                                <TextBlock Text="Fast and Adaptive (Balanced)" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="0x25 (37) — Adaptativo general para sistemas de gama media." FontSize="11" Foreground="#8A8F98" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Style="{StaticResource OptionCard}">
                        <RadioButton Name="Radio24" Style="{StaticResource CustomRadioButton}" GroupName="PriorityGroup">
                            <StackPanel Margin="5,-1,0,0">
                                <TextBlock Text="Fast and Adaptive (Smooth)" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="0x24 (36) — Baja prioridad adaptativa, suaviza picos de CPU." FontSize="11" Foreground="#8A8F98" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <!-- STABLE & CONSISTENT -->
                    <TextBlock Text="🛡️ ESTABLE &amp; CONSISTENTE (LONG QUANTUMS)" FontSize="11" FontWeight="Bold" Foreground="#0E7A0D" Margin="0,10,0,8"/>

                    <Border Style="{StaticResource OptionCard}">
                        <RadioButton Name="Radio1A" Style="{StaticResource CustomRadioButton}" GroupName="PriorityGroup">
                            <StackPanel Margin="5,-1,0,0">
                                <TextBlock Text="Very Stable (Long Quantum)" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="0x1A (26) — Fuerte consistencia, excelente para multitarea pesada." FontSize="11" Foreground="#8A8F98" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Style="{StaticResource OptionCard}">
                        <RadioButton Name="Radio19" Style="{StaticResource CustomRadioButton}" GroupName="PriorityGroup">
                            <StackPanel Margin="5,-1,0,0">
                                <TextBlock Text="Stable and Balanced" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="0x19 (25) — Equilibrio óptimo en cargas de trabajo de renderizado." FontSize="11" Foreground="#8A8F98" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Style="{StaticResource OptionCard}">
                        <RadioButton Name="Radio18" Style="{StaticResource CustomRadioButton}" GroupName="PriorityGroup">
                            <StackPanel Margin="5,-1,0,0">
                                <TextBlock Text="Stable (Standard)" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="0x18 (24) — Comportamiento conservador, máxima estabilidad de servicios." FontSize="11" Foreground="#8A8F98" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <!-- ORIGINAL DEFAULT -->
                    <TextBlock Text="🔄 WINDOWS DEFAULT" FontSize="11" FontWeight="Bold" Foreground="#8A8F98" Margin="0,10,0,8"/>

                    <Border Style="{StaticResource OptionCard}">
                        <RadioButton Name="Radio02" Style="{StaticResource CustomRadioButton}" GroupName="PriorityGroup">
                            <StackPanel Margin="5,-1,0,0">
                                <TextBlock Text="Windows Default" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="0x02 (2) — Configuración por defecto de Windows para PCs de escritorio." FontSize="11" Foreground="#8A8F98" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="#151515" BorderThickness="0,1,0,0" BorderBrush="#2A2A2A" Padding="25,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="⚠️ Requiere reiniciar para aplicar cambios." FontSize="11" Foreground="#FFC107" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="CANCELAR" Style="{StaticResource CancelButton}" Margin="0,0,10,0" Click="CancelButton_Click"/>
                    <Button Content="APLICAR" Style="{StaticResource ApplyButton}" Click="ApplyButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
