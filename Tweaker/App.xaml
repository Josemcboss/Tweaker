<Application x:Class="Tweaker.App"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:Tweaker"
xmlns:converters="clr-namespace:Tweaker.Converters"
StartupUri="MainWindow.xaml"
Startup="Application_Startup">
    <Application.Resources>
        <!-- Incluir recursos de iconos y estilos optimizados -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters globales -->
            <converters:BoolToRecommendationIconConverter x:Key="BoolToRecommendationIconConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
