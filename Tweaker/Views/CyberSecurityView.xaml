<UserControl x:Class="Tweaker.Views.CyberSecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200"
             Foreground="White">
    <UserControl.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1E1F22"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderBrush" Value="#2B2D31"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#35373C"/>
            <Setter Property="Foreground" Value="#DCDDDE"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#DA373C"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
            <!-- Encabezado -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="🛡️ Ciberseguridad &amp; Privacidad" FontSize="26" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Herramientas de protección de superficie de ataque, DNS cifrado, inspección de persistencia y monitor de red." 
                           FontSize="13" Foreground="#B9BBBE" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Barra de Estado / Notificación -->
            <Border Background="#2B2D31" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️ Estado: " FontWeight="SemiBold" Foreground="#5865F2"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#E0E0E0"/>
                </StackPanel>
            </Border>

            <!-- Sección 1: DNS Seguro & Cifrado (DoH) -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="🌐 DNS Seguro &amp; Cifrado (DNS-over-HTTPS)" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                    <TextBlock Text="Cifra tus solicitudes DNS para evitar la inspección del proveedor de internet (ISP), mitigar spoofing y optimizar la latencia en gaming." 
                               FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    
                    <WrapPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ActionButton}" Content="⚡ Cloudflare (1.1.1.1 Gaming DoH)" 
                                Command="{Binding ApplyDnsCommand}" CommandParameter="Cloudflare"/>
                        <Button Style="{StaticResource ActionButton}" Content="🛡️ Quad9 (Anti-Malware &amp; Phishing)" 
                                Command="{Binding ApplyDnsCommand}" CommandParameter="Quad9"/>
                        <Button Style="{StaticResource ActionButton}" Content="🚫 AdGuard (Bloqueo de Anuncios)" 
                                Command="{Binding ApplyDnsCommand}" CommandParameter="AdGuard"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="🔄 Restaurar DNS Automático" 
                                Command="{Binding ResetDnsCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Sección 2: Hardening de Windows Defender & Telemetría -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tarjeta Defender ASR -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="🛡️ Reglas ASR de Windows Defender" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                        <TextBlock Text="Attack Surface Reduction: Bloquea robo de credenciales en LSASS e inyección de código sin impactar rendimiento de juegos." 
                                   FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ActionButton}" Content="Activar Reglas ASR" Command="{Binding EnableAsrCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Desactivar ASR" Command="{Binding DisableAsrCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Tarjeta Aislamiento de Telemetría -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="🔕 Hardening de Telemetría &amp; Privacidad" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                        <TextBlock Text="Deshabilita recolección de diagnósticos, Advertising ID y DiagTrack manteniendo Windows Update y Store 100% operativos." 
                                   FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ActionButton}" Content="Bloquear Telemetría" Command="{Binding EnableTelemetryBlockCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Restaurar Valores" Command="{Binding RevertTelemetryBlockCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Sección 3: Monitor del Archivo Hosts -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="📝 Integridad del Archivo Hosts" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding HostsStatusSummary}" FontSize="12" Foreground="#B9BBBE" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}" Content="Verificar" Command="{Binding CheckHostsCommand}"/>
                            <Button Style="{StaticResource DangerButton}" Content="Restaurar a Limpio" Command="{Binding RestoreHostsCommand}"/>
                        </StackPanel>
                    </Grid>

                    <ListView ItemsSource="{Binding HostsEntries}" Height="120" Background="#141517" BorderThickness="0" Foreground="White">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Línea" DisplayMemberBinding="{Binding LineNumber}" Width="50"/>
                                <GridViewColumn Header="Dirección IP" DisplayMemberBinding="{Binding IP}" Width="150"/>
                                <GridViewColumn Header="Dominio Redirigido" DisplayMemberBinding="{Binding Domain}" Width="300"/>
                                <GridViewColumn Header="Sospechoso" DisplayMemberBinding="{Binding IsSuspicious}" Width="90"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Sección 4: Escáner de Persistencia & Auto-Runs -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🔍 Escáner de Persistencia (Auto-Runs)" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Analiza programas configurados para iniciar automáticamente con Windows (Run / RunOnce)." 
                                       FontSize="12" Foreground="#B9BBBE" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Content="🔄 Refrescar" Command="{Binding RefreshPersistenceCommand}"/>
                    </Grid>

                    <ListView ItemsSource="{Binding PersistenceItems}" Height="150" Background="#141517" BorderThickness="0" Foreground="White">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Nombre" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                <GridViewColumn Header="Ubicación" DisplayMemberBinding="{Binding Location}" Width="110"/>
                                <GridViewColumn Header="Firma / Origen" DisplayMemberBinding="{Binding StatusBadge}" Width="160"/>
                                <GridViewColumn Header="Ruta Ejecutable" DisplayMemberBinding="{Binding Path}" Width="500"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Sección 5: Monitor de Conexiones de Red y Puertos -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="🔌 Conexiones de Red Activas &amp; Puertos" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Monitorea en tiempo real qué ejecutables tienen puertos de red abiertos y conexiones establecidas." 
                                       FontSize="12" Foreground="#B9BBBE" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Content="🔄 Actualizar Conexiones" Command="{Binding RefreshConnectionsCommand}"/>
                    </Grid>

                    <ListView ItemsSource="{Binding ActiveConnections}" Height="200" Background="#141517" BorderThickness="0" Foreground="White">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Proceso" DisplayMemberBinding="{Binding ProcessName}" Width="160"/>
                                <GridViewColumn Header="PID" DisplayMemberBinding="{Binding ProcessId}" Width="60"/>
                                <GridViewColumn Header="Proto" DisplayMemberBinding="{Binding Protocol}" Width="60"/>
                                <GridViewColumn Header="Dirección Local" DisplayMemberBinding="{Binding LocalAddress}" Width="180"/>
                                <GridViewColumn Header="Dirección Remota" DisplayMemberBinding="{Binding RemoteAddress}" Width="180"/>
                                <GridViewColumn Header="Estado" DisplayMemberBinding="{Binding State}" Width="120"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
