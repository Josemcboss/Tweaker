                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Name="TxtNoStartupItems" Text="No se encontraron elementos de inicio o la lista está optimizada." Foreground="#7F8084" HorizontalAlignment="Center" Margin="0,50,0,0" Visibility="Collapsed" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer Name="ProfilesPage" Visibility="{Binding CurrentPageName, Converter={StaticResource PageNameToVisibilityConverter}, ConverterParameter=Profiles}" VerticalScrollBarVisibility="Auto">
          <UIElement.RenderTransform>
            <TranslateTransform />
          </UIElement.RenderTransform>
          <StackPanel Margin="40">
            <TextBlock FontFamily="Segoe UI Emoji" FontSize="28" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,10">
              <Run Text="📁" /> <Run Text="Sistema de Perfiles" /></TextBlock>
            <TextBlock Text="Guarda tu configuración actual de optimización, cárgala cuando la necesites, o aplica presets predefinidos." FontSize="14" Foreground="#A0A0A0" Margin="0,0,0,30" />
