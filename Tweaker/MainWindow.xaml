                <StackPanel>
                  <TextBlock Text="Guardar Configuración Actual" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,10" />
                  <TextBlock Text="Crea un perfil con todos los tweaks que tienes activos actualmente para poder restaurarlos más tarde." Foreground="#B9BBBE" FontSize="12" Margin="0,0,0,20" TextWrapping="Wrap" Height="40" />
                  <StackPanel Orientation="Horizontal">
                    <Button Content="CREAR PERFIL NUEVO" Style="{StaticResource OnButton}" Background="#5865F2" Padding="15,10" Margin="0,0,10,0" Command="{Binding SaveProfileCommand}" />
                    <Button Content="IMPORTAR PERFIL" Style="{DynamicResource PresetButton}" Padding="15,10" Command="{Binding ImportProfileCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{DynamicResource NeonGlowCard}" Padding="20" Margin="10,0,0,0">
                <StackPanel>
                  <TextBlock Text="Presets del Sistema" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,10" />
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,20" Height="40">
                    <Button Content="Casual" Style="{DynamicResource PresetButton}" Margin="0,0,8,0" Width="85" CommandParameter="Casual" Command="{Binding LoadPresetCommand}" />
                    <Button Content="Competitivo" Style="{DynamicResource PresetButton}" Margin="0,0,8,0" Width="105" CommandParameter="Competitivo" Command="{Binding LoadPresetCommand}" />
                    <Button Content="Extremo" Style="{DynamicResource PresetButton}" Width="90" CommandParameter="Extremo" Command="{Binding LoadPresetCommand}" />
                  </StackPanel>
                  <TextBlock Text="Aplica configuraciones recomendadas por Ghost Optimizer según tu perfil de uso." Foreground="#B9BBBE" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </Grid>
            <TextBlock Text="Mis Perfiles Guardados" FontSize="20" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,15" />
            <ItemsControl ItemsSource="{Binding SavedProfiles}">
