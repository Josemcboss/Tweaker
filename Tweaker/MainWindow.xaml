                                    <Border Style="{StaticResource DetailRowBorder}">
                                        <StackPanel>
                                            <TextBlock Text="CORES" FontSize="10" FontWeight="Bold" Foreground="#606060" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding HardwareInfo.CPUCores}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DetailRowBorder}">
                                        <StackPanel>
                                            <TextBlock Text="LOGICAL PROCESSORS" FontSize="10" FontWeight="Bold" Foreground="#606060" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding HardwareInfo.CPULogicalProcessors}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DetailRowBorder}" BorderThickness="0">
                                        <StackPanel>
                                            <TextBlock Text="MAX CLOCK SPEED" FontSize="10" FontWeight="Bold" Foreground="#606060" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding HardwareInfo.CPUMaxSpeed, StringFormat={}{0} MHz}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Mainboard Details -->
                            <Border Style="{DynamicResource NeonGlowCard}" Background="#0C0808" Padding="5" 
                                    Visibility="{Binding SelectedSystemTab, Converter={StaticResource PageNameToVisibilityConverter}, ConverterParameter=Mainboard}">
                                <StackPanel>
                                    <Border Style="{StaticResource DetailRowBorder}">
                                        <StackPanel>
                                            <TextBlock Text="MANUFACTURER" FontSize="10" FontWeight="Bold" Foreground="#606060" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding HardwareInfo.MotherboardManufacturer}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DetailRowBorder}">
                                        <StackPanel>
                                            <TextBlock Text="MODEL" FontSize="10" FontWeight="Bold" Foreground="#606060" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding HardwareInfo.MotherboardModel}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DetailRowBorder}" BorderThickness="0">
                                        <StackPanel>
                                            <TextBlock Text="BIOS VERSION" FontSize="10" FontWeight="Bold" Foreground="#606060" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding HardwareInfo.BiosVersion}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Memory Details -->
                            <Border Style="{DynamicResource NeonGlowCard}" Background="#0C0808" Padding="5" 
                                    Visibility="{Binding SelectedSystemTab, Converter={StaticResource PageNameToVisibilityConverter}, ConverterParameter=Memory}">
                                <StackPanel>
                                    <Border Style="{StaticResource DetailRowBorder}">
                                        <StackPanel>
                                            <TextBlock Text="TOTAL CAPACITY" FontSize="10" FontWeight="Bold" Foreground="#606060" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding HardwareInfo.TotalRAMGB, StringFormat={}{0} GB}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DetailRowBorder}">
                                        <StackPanel>
                                            <TextBlock Text="SPEED" FontSize="10" FontWeight="Bold" Foreground="#606060" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding HardwareInfo.RAMSpeed, StringFormat={}{0} MHz}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DetailRowBorder}" BorderThickness="0">
                                        <StackPanel>
                                            <TextBlock Text="TYPE" FontSize="10" FontWeight="Bold" Foreground="#606060" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding HardwareInfo.RAMType}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Graphics Details -->
                            <Border Style="{DynamicResource NeonGlowCard}" Background="#0C0808" Padding="5" 
                                    Visibility="{Binding SelectedSystemTab, Converter={StaticResource PageNameToVisibilityConverter}, ConverterParameter=Graphics}">
                                <StackPanel>
                                    <Border Style="{StaticResource DetailRowBorder}">
                                        <StackPanel>
                                            <TextBlock Text="GPU NAME" FontSize="10" FontWeight="Bold" Foreground="#606060" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding HardwareInfo.GPUName}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DetailRowBorder}" BorderThickness="0">
                                        <StackPanel>
                                            <TextBlock Text="VRAM" FontSize="10" FontWeight="Bold" Foreground="#606060" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding HardwareInfo.GPUVramGB, StringFormat={}{0} GB}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Storage Details -->
                            <Border Style="{DynamicResource NeonGlowCard}" Background="#0C0808" Padding="5" 
                                    Visibility="{Binding SelectedSystemTab, Converter={StaticResource PageNameToVisibilityConverter}, ConverterParameter=Storage}">
                                <ItemsControl ItemsSource="{Binding HardwareInfo.StorageDisks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource DetailRowBorder}">
                                                <StackPanel>
                                                    <TextBlock Text="DISK DRIVE" FontSize="10" FontWeight="Bold" Foreground="#606060" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Network Details -->
                            <Border Style="{DynamicResource NeonGlowCard}" Background="#0C0808" Padding="5" 
                                    Visibility="{Binding SelectedSystemTab, Converter={StaticResource PageNameToVisibilityConverter}, ConverterParameter=Network}">
                                <ItemsControl ItemsSource="{Binding HardwareInfo.NetworkAdapters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource DetailRowBorder}">
                                                <StackPanel>
                                                    <TextBlock Text="NETWORK ADAPTER" FontSize="10" FontWeight="Bold" Foreground="#606060" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
  </Grid>
</Window>