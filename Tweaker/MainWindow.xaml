                                    <TextBlock Text="• Network power saving OFF" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,3"/>
                                    <TextBlock Text="• NetBIOS OFF" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,3"/>
                                    <TextBlock Text="• DNS ultra optimized" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,10"/>

                                    <TextBlock Text="⚡ POWER MAXIMUM:" FontSize="14" FontWeight="Bold" Foreground="#E81123" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Ultimate Performance plan" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,3"/>
                                    <TextBlock Text="• Power throttling OFF" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,3"/>
                                    <TextBlock Text="• Core parking OFF" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,3"/>
                                </StackPanel>

                                <!-- Columna derecha -->
                                <StackPanel Grid.Column="1">
