<Window x:Class="Tweaker.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:resources="clr-namespace:Tweaker.Resources"
mc:Ignorable="d"
Title="Ghost Optimizer - Gaming Tweaker" 
Height="938" 
Width="1538"
Background="#0F0F0F"
WindowStartupLocation="CenterScreen"
ResizeMode="CanResize"
WindowStyle="None"
AllowsTransparency="False"
Icon="{StaticResource GhostOptimizerIcon}">

    <Window.Resources>
        <!-- ??????????????????????????????????????????????????????????????? -->
        <!-- ESTILOS MODERNOS (HONE.GG / DISCORD STYLE) -->
        <!-- ??????????????????????????????????????????????????????????????? -->

        <!-- Botón del Sidebar (Menú Lateral) -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B9BBBE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,3,0"
                                BorderBrush="Transparent"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2D31"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Active">
                                <Setter TargetName="border" Property="BorderBrush" Value="#5865F2"/>
                                <Setter Property="Background" Value="#35363C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón ON (verde gaming) -->
        <Style x:Key="OnButton" TargetType="Button">
            <Setter Property="Background" Value="#0E7A0D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#107C10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#11910F"/>
                    <Setter Property="BorderBrush" Value="#13A813"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón OFF (rojo gaming) -->
        <Style x:Key="OffButton" TargetType="Button">
            <Setter Property="Background" Value="#A80000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C50500"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C50500"/>
                    <Setter Property="BorderBrush" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Título de sección -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Descripción -->
        <Style x:Key="Description" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Title Bar Button Base - MEJORADO -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#404040"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Close Button - MEJORADO (Hover rojo más visible) -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C50500"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón de Categoría del Dashboard -->
        <Style x:Key="DashboardCategoryButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2D31"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#35393F"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#40444B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern RadioButton Style -->
        <Style x:Key="ModernRadioButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" 
                                Background="#2C2F33" 
                                BorderBrush="#5865F2" 
                                BorderThickness="1" 
                                CornerRadius="15"
                                Padding="12,8"
                                Margin="2">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextBlock.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#5865F2"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#7289DA"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#40444B"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#7289DA"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <!-- ROOT GRID -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <!-- Title Bar -->
            <RowDefinition Height="*"/>
            <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- CUSTOM TITLE BAR - MEJORADO -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" 
                Background="#1A1A1A" 
                BorderThickness="0,0,0,1"
                BorderBrush="#2A2A2A"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo y Título a la izquierda -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="8,0,0,0">

                    <!-- Logo GHOST OPTIMIZER -->
                    <resources:GhostOptimizerLogo Width="24" Height="24" 
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>

                    <!-- Título principal -->
                    <TextBlock Text="GHOST OPTIMIZER" 
                               FontFamily="Impact, Arial Black"
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#A970FF" 
                                            BlurRadius="6" 
                                            ShadowDepth="0" 
                                            Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Separador -->
                    <Border Width="1" Height="16" 
                            Background="#3A3A3A" 
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"/>

                    <!-- Subtítulo -->
                    <TextBlock Text="Gaming Tweaker" 
                               FontFamily="Segoe UI"
                               FontSize="11" 
                               Foreground="#B9BBBE"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF4500" 
                                            BlurRadius="4" 
                                            ShadowDepth="0" 
                                            Opacity="0.3"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Botones de control a la derecha -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right">


                    <!-- Botón Minimizar -->
                    <Button Style="{StaticResource TitleBarButton}" 
                            Click="MinimizeButton_Click"
                            ToolTip="Minimizar">
                        <Viewbox Width="10" Height="10" 
                                 VerticalAlignment="Center" 
                                 HorizontalAlignment="Center">
                            <Path Data="M 0,0 L 10,0" 
                                  Stroke="White" 
                                  StrokeThickness="1.5"/>
                        </Viewbox>
                    </Button>

                    <!-- Botón Cerrar -->
                    <Button Style="{StaticResource CloseButton}" 
                            Click="CloseButton_Click"
                            ToolTip="Cerrar">
                        <Viewbox Width="10" Height="10" 
                                 VerticalAlignment="Center" 
                                 HorizontalAlignment="Center">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" 
                                  Stroke="White" 
                                  StrokeThickness="1.5"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- CONTENIDO PRINCIPAL (SIDEBAR + PÁGINAS) -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Columna 0: Sidebar -->
                <ColumnDefinition Width="240"/>
                <!-- Columna 1: Contenido -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═════════════════════════════════════════════════════════════════ -->
            <!-- COLUMNA 0: SIDEBAR (MENÚ LATERAL) -->
            <!-- ═════════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" 
                Background="#1E1E1E" 
                BorderBrush="#2A2A2A" 
                BorderThickness="0,0,1,0">
                <StackPanel>
                    <!-- Header del Sidebar -->
                    <Border Background="#151515" 
                        Padding="20,25"
                        BorderBrush="#2A2A2A"
                        BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe UI Emoji" FontSize="20" FontWeight="Bold" Foreground="#5865F2">
                            <Run Text="&#x26A1;"/>&#x0020;<Run Text="TWEAKER"/>
                            </TextBlock>
                            <TextBlock Text="Gaming Dashboard" 
                                   FontSize="11" 
                                   Foreground="#7F8084"
                                   Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Botones de Navegación -->
                    <StackPanel Margin="0,15,0,0">
                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToDashboard"
                            x:Name="BtnNavDashboard"
                            Tag="Active">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F3E0;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToInput"
                            x:Name="BtnNavInput">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2328;&#xFE0F;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Input &amp; Visuals" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToNetwork"
                            x:Name="BtnNavNetwork">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4E1;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Red &amp; Ping" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToSystem"
                            x:Name="BtnNavSystem">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F3AE;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Sistema &amp; GPU" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToCleanup"
                            x:Name="BtnNavCleanup">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F9F9;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Limpieza" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToGhost"
                            x:Name="BtnNavGhost">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F47B;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="GHOST Pack" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToAdvanced"
                            x:Name="BtnNavAdvanced">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x26A0;&#xFE0F;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Advanced" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Footer del Sidebar -->
                    <Border Background="#151515" 
                        Padding="15"
                        BorderBrush="#2A2A2A"
                        BorderThickness="0,1,0,0"
                        VerticalAlignment="Bottom"
                        Margin="0,180,0,0">
                        <StackPanel>
                            <!-- Mini logo -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <resources:GhostOptimizerLogo Width="16" Height="16" 
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>
                                <TextBlock Text="GHOST OPTIMIZER" 
                                       FontFamily="Impact, Arial Black"
                                       FontSize="10" 
                                       FontWeight="Bold"
                                       Foreground="#A970FF"
                                       VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock FontFamily="Segoe UI Emoji" FontSize="10" Foreground="#FFC107" FontWeight="SemiBold" Margin="0,0,0,5">
                            <Run Text="⚠️"/>&#x0020;<Run Text="Ejecutar como Admin"/>
                            </TextBlock>
                            <TextBlock Text="v2.0 - DaddyGhost Edition" 
                                   FontSize="9" 
                                   Foreground="#5F5F5F"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═════════════════════════════════════════════════════════════════ -->
            <!-- COLUMNA 1: ÁREA DE CONTENIDO (PESTAÑAS) -->
            <!-- ═════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1" Background="#252526">

                <!-- Dashboard Page -->
                <ScrollViewer x:Name="DashboardPage" 
                          Visibility="Visible" 
                          VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40">
                        <!-- Header con logo -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <!-- Logo grande -->
                            <resources:GhostOptimizerLogo Width="60" Height="60" 
                                                       Margin="0,0,20,0"
                                                       VerticalAlignment="Center"/>

                            <!-- Texto del header -->
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontFamily="Impact, Arial Black" FontSize="32" FontWeight="Bold" Foreground="White">
                                <Run Text="GHOST OPTIMIZER"/>
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#A970FF" 
                                                    BlurRadius="8" 
                                                    ShadowDepth="0" 
                                                    Opacity="0.6"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock FontFamily="Segoe UI" FontSize="16" Foreground="#B9BBBE" Margin="0,5,0,0">
                                <Run Text="Gaming Performance Dashboard"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Optimizador Gaming Profesional" 
                               FontSize="14" 
                               Foreground="#A0A0A0"
                               Margin="0,0,0,30"/>

                        <!-- Stats Cards (DINÁMICAS) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Tweaks Activos (DINÁMICO) -->
                            <Border Grid.Column="0" 
                                Background="#1E1E1E" 
                                CornerRadius="8" 
                                Padding="20"
                                Margin="0,0,10,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtActiveTweaks" 
                                               Text="0" 
                                               FontSize="32" 
                                               FontWeight="Bold" 
                                               Foreground="#5865F2"/>
                                        <TextBlock Text="/" 
                                               FontSize="20" 
                                               FontWeight="Bold" 
                                               Foreground="#7F8084"
                                               Margin="5,8,0,0"/>
                                        <TextBlock Text="32" 
                                               FontSize="20" 
                                               FontWeight="Bold" 
                                               Foreground="#7F8084"
                                               Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Tweaks Activos" FontSize="12" Foreground="#A0A0A0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock x:Name="TxtOptimizationPercent" 
                                               Text="0%" 
                                               FontSize="10" 
                                               Foreground="#0E7A0D" 
                                               FontWeight="SemiBold"/>
                                        <TextBlock Text=" optimizado" 
                                               FontSize="10" 
                                               Foreground="#7F8084"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Beneficios Estimados (DINÁMICO) -->
                            <Border Grid.Column="1" 
                                Background="#1E1E1E" 
                                CornerRadius="8" 
                                Padding="20"
                                Margin="5,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtEstimatedFps" 
                                           Text="+0" 
                                           FontSize="32" 
                                           FontWeight="Bold" 
                                           Foreground="#0E7A0D"/>
                                    <TextBlock Text="FPS Estimados" FontSize="12" Foreground="#A0A0A0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="🎯 " FontFamily="Segoe UI Emoji" FontSize="10"/>
                                        <TextBlock x:Name="TxtLatencyReduction" 
                                               Text="-0ms ping" 
                                               FontSize="10" 
                                               Foreground="#7F8084"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: RAM Liberada (DINÁMICO) -->
                            <Border Grid.Column="2" 
                                Background="#1E1E1E" 
                                CornerRadius="8" 
                                Padding="20"
                                Margin="10,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtRamFreed" 
                                               Text="0.0" 
                                               FontSize="32" 
                                               FontWeight="Bold" 
                                               Foreground="#9B59B6"/>
                                        <TextBlock Text=" GB" 
                                               FontSize="18" 
                                               FontWeight="Bold" 
                                               Foreground="#7F8084"
                                               Margin="3,10,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="RAM Liberada" FontSize="12" Foreground="#A0A0A0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="💾 " FontFamily="Segoe UI Emoji" FontSize="10"/>
                                        <TextBlock Text="Memoria optimizada" 
                                               FontSize="10" 
                                               Foreground="#7F8084"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Info Section -->
                        <Border Background="#1E1E1E" 
                            CornerRadius="8" 
                            Padding="25"
                            Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock FontFamily="Segoe UI Emoji" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15">
                                <Run Text="&#x1F4D6;"/>&#x0020;<Run Text="Guía Rápida"/>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" Foreground="#B9BBBE" LineHeight="22">
                                <Run Text="1. " FontWeight="Bold"/>
                                <Run Text="Navega por las categorías del menú lateral"/>
                                <LineBreak/>
                                <Run Text="2. " FontWeight="Bold"/>
                                <Run Text="Activa los tweaks con el botón ON (verde)"/>
                                <LineBreak/>
                                <Run Text="3. " FontWeight="Bold"/>
                                <Run Text="Desactiva con el botón OFF (rojo) si quieres revertir"/>
                                <LineBreak/>
                                <Run Text="4. " FontWeight="Bold"/>
                                <Run Text="Reinicia Windows después de aplicar tweaks importantes"/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="⚠️ Recomendado: Crea un punto de restauración antes de empezar" FontFamily="Segoe UI Emoji" Foreground="#FFC107" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Active Tweaks Section (NUEVO - DINÁMICO) -->
                        <Border x:Name="ActiveTweaksSection"
                            Background="#1E1E1E" 
                            CornerRadius="8" 
                            Padding="25"
                            Margin="0,20,0,0"
                            Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock FontFamily="Segoe UI Emoji" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15">
                                <Run Text="✅"/>&#x0020;<Run Text="Tweaks Activos"/>
                                </TextBlock>

                                <!-- Lista de tweaks activos -->
