                  <TextBlock Text="Control del Registro" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,5" />
                  <TextBlock Text="Puedes exportar el historial a tu escritorio o vaciar el registro por completo." Foreground="#B9BBBE" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Content="EXPORTAR REGISTRO" Style="{StaticResource OnButton}" Background="#5865F2" Padding="15,10" Margin="0,0,10,0" Command="{Binding ExportLogCommand}" />
                  <Button Content="LIMPIAR HISTORIAL" Style="{StaticResource OffButton}" Padding="15,10" Command="{Binding ClearHistoryCommand}" />
                </StackPanel>
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding RecentHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{DynamicResource NeonGlowCard}" Padding="15" Margin="0,0,0,10">
