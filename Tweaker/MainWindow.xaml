                               Foreground="#A0A0A0"
                               Margin="0,0,0,30"/>

                        <!-- Stats Cards (DINÁMICAS) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Tweaks Activos (DINÁMICO) -->
                            <Border Grid.Column="0" 
                                Style="{DynamicResource NeonGlowCard}"
                                Padding="20"
                                Margin="0,0,10,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtActiveTweaks" 
                                               Text="0" 
                                               FontSize="32" 
                                               FontWeight="Bold" 
                                               Foreground="#5865F2"/>
                                        <TextBlock Text="/" 
                                               FontSize="20" 
                                               FontWeight="Bold" 
                                               Foreground="#7F8084"
                                               Margin="5,8,0,0"/>
                                        <TextBlock Text="58" 
                                               FontSize="20" 
                                               FontWeight="Bold" 
                                               Foreground="#7F8084"
                                               Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Tweaks Activos" FontSize="12" Foreground="#A0A0A0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock x:Name="TxtOptimizationPercent" 
                                               Text="0%" 
                                               FontSize="10" 
                                               Foreground="#0E7A0D" 
                                               FontWeight="SemiBold"/>
                                        <TextBlock Text=" optimizado" 
                                               FontSize="10" 
                                               Foreground="#7F8084"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Beneficios Estimados (DINÁMICO) -->
                            <Border Grid.Column="1" 
                                Style="{DynamicResource NeonGlowCard}"
                                Padding="20"
                                Margin="5,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtEstimatedFps" 
                                           Text="+0" 
                                           FontSize="32" 
                                           FontWeight="Bold" 
                                           Foreground="#0E7A0D"/>
                                    <TextBlock Text="FPS Estimados" FontSize="12" Foreground="#A0A0A0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="🎯 " FontFamily="Segoe UI Emoji" FontSize="10"/>
                                        <TextBlock x:Name="TxtLatencyReduction" 
                                               Text="-0ms ping" 
                                               FontSize="10" 
                                               Foreground="#7F8084"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>


                            <!-- Card 3: RAM Liberada (DINÁMICO) -->
                            <Border Grid.Column="2" 
                                Style="{DynamicResource NeonGlowCard}"
                                Padding="20"
                                Margin="10,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtRamFreed" 
                                               Text="0.0" 
                                               FontSize="32" 
                                               FontWeight="Bold" 
                                               Foreground="#9B59B6"/>
                                        <TextBlock Text=" GB" 
                                               FontSize="18" 
                                               FontWeight="Bold" 
                                               Foreground="#7F8084"
                                               Margin="3,10,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="RAM Liberada" FontSize="12" Foreground="#A0A0A0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="💾 " FontFamily="Segoe UI Emoji" FontSize="10"/>
                                        <TextBlock Text="Memoria optimizada" 
                                               FontSize="10" 
                                               Foreground="#7F8084"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Real-time Hardware Monitoring -->
                        <TextBlock Text="Monitoreo de Hardware en Tiempo Real" 
                               FontSize="14" 
                               Foreground="#A0A0A0"
                               Margin="0,20,0,10"/>
                        
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CPU Graph -->
                            <Border Grid.Column="0" Style="{StaticResource NeonGlowCard}" Margin="0,0,10,0" Padding="15">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="CPU" FontWeight="Bold" Foreground="#5865F2" HorizontalAlignment="Left"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock x:Name="TxtCpuTemp" Text="0°C" Foreground="#A0A0A0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtCpuLoad" Text="0%" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <controls:HardwareGraph x:Name="GraphCpu" Height="120" LineColor="DodgerBlue" MaxValue="100" ValueUnit="%"/>
                                </StackPanel>
                            </Border>

                            <!-- GPU Graph -->
                            <Border Grid.Column="1" Style="{StaticResource NeonGlowCard}" Margin="5,0" Padding="15">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="GPU" FontWeight="Bold" Foreground="#2ECC71" HorizontalAlignment="Left"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock x:Name="TxtGpuTemp" Text="0°C" Foreground="#A0A0A0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtGpuLoad" Text="0%" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <controls:HardwareGraph x:Name="GraphGpu" Height="120" LineColor="SpringGreen" MaxValue="100" ValueUnit="%"/>
                                </StackPanel>
                            </Border>

                            <!-- RAM Graph -->
                            <Border Grid.Column="2" Style="{StaticResource NeonGlowCard}" Margin="10,0,0,0" Padding="15">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="RAM" FontWeight="Bold" Foreground="#9B59B6" HorizontalAlignment="Left"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock x:Name="TxtRamLoad" Text="0%" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <controls:HardwareGraph x:Name="GraphRam" Height="120" LineColor="MediumPurple" MaxValue="100" ValueUnit="%"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Smart Scan Section (NUEVO) -->
                        <Border Style="{DynamicResource NeonGlowCard}"
                            Padding="25"
                            Margin="0,20,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontFamily="Segoe UI Emoji" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,5">
                                    <Run Text="🔍"/>&#x0020;<Run Text="Smart Scan &amp; Optimization"/>
                                    </TextBlock>
                                    <TextBlock Text="Analiza tu sistema en busca de optimizaciones pendientes y mejora tu rendimiento con un clic." 
                                           Foreground="#A0A0A0" Margin="0,0,0,15"/>
                                    
                                    <!-- Scanning State (Hidden by default) -->
                                    <StackPanel x:Name="ScanningState" Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                                        <ProgressBar x:Name="ScanProgressBar" Height="10" Background="#1A1A1A" Foreground="#5865F2" IsIndeterminate="True" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="TxtScanStatus" Text="Analizando servicios y registro..." Foreground="#B9BBBE" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Result State (Hidden by default) -->
                                    <StackPanel x:Name="ResultState" Visibility="{Binding ShowScanResults, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="Puntaje de Optimización: " Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtOptimizationScore" Text="{Binding ScanScore, StringFormat={}{0}%}" Foreground="#0E7A0D" FontSize="24" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtScanSummary" Text="{Binding ScanSummary}" Foreground="#B9BBBE" Margin="0,0,0,15"/>
                                        <Button x:Name="BtnOptimizeNow" Content="OPTIMIZAR AHORA" Visibility="{Binding ShowOptimizeButton, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding OptimizeNowCommand}" Style="{StaticResource OnButton}" Padding="20,10" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                        x:Name="BtnStartScan"
                                        Style="{StaticResource OnButton}"
                                        Background="#5865F2"
                                        BorderBrush="#4752C4"
                                        VerticalAlignment="Center"
                                        Padding="25,15"
                                        Command="{Binding StartScanCommand}">                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍" FontFamily="Segoe UI Emoji" Margin="0,0,10,0"/>
                                        <TextBlock Text="ANALIZAR PC" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Info Section -->
                        <Border Style="{DynamicResource NeonGlowCard}"
                            Padding="25"
                            Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock FontFamily="Segoe UI Emoji" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15">
                                <Run Text="&#x1F4D6;"/>&#x0020;<Run Text="Guía Rápida"/>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" Foreground="#B9BBBE" LineHeight="22">
                                <Run Text="1. " FontWeight="Bold"/>
                                <Run Text="Navega por las categorías del menú lateral"/>
                                <LineBreak/>
                                <Run Text="2. " FontWeight="Bold"/>
                                <Run Text="Activa los tweaks con el botón ON (verde)"/>
                                <LineBreak/>
                                <Run Text="3. " FontWeight="Bold"/>
                                <Run Text="Desactiva con el botón OFF (rojo) si quieres revertir"/>
                                <LineBreak/>
                                <Run Text="4. " FontWeight="Bold"/>
                                <Run Text="Reinicia Windows después de aplicar tweaks importantes"/>
                                <LineBreak/>
                                <LineBreak/>
                                <Run Text="⚠️ Recomendado: Crea un punto de restauración antes de empezar" FontFamily="Segoe UI Emoji" Foreground="#FFC107" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Active Tweaks Section (NUEVO - DINÁMICO) -->
                        <Border x:Name="ActiveTweaksSection"
                            Style="{DynamicResource NeonGlowCard}"
                            Padding="25"
                            Margin="0,20,0,0"
                            Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock FontFamily="Segoe UI Emoji" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15">
                                <Run Text="✅"/>&#x0020;<Run Text="Tweaks Activos"/>
                                </TextBlock>

                                <!-- Lista de tweaks activos -->
                                <StackPanel x:Name="ActiveTweaksList">
                                    <!-- Se llenará dinámicamente desde código -->
                                </StackPanel>

                                <!-- Mensaje cuando no hay tweaks activos -->
                                <TextBlock x:Name="NoTweaksMessage"
                                       Text="No hay tweaks activos. Comienza activando optimizaciones desde las categorías del menú." 
                                       TextWrapping="Wrap" 
                                       Foreground="#7F8084" 
                                       FontStyle="Italic"
                                       Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Quick Actions -->
                        <Border Style="{DynamicResource NeonGlowCard}"
                            Padding="25"
                            Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock FontFamily="Segoe UI Emoji" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15">
                                <Run Text="&#x26A1;"/>&#x0020;<Run Text="Acciones Rápidas"/>
                                </TextBlock>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Botón Crear Punto de Restauración -->
                                    <Button Grid.Column="0"
                                        Style="{StaticResource OnButton}" 
                                        Padding="20,12" 
                                        Click="CreateRestorePoint">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F6E1;&#xFE0F;" FontFamily="Segoe UI Emoji" Margin="0,0,8,0"/>
                                            <TextBlock Text="Crear Punto de Restauración"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Botón Abrir Restauración del Sistema -->
                                    <Button Grid.Column="2"
                                        Style="{StaticResource OnButton}" 
                                        Background="#5865F2"
                                        BorderBrush="#4752C4"
                                        Padding="20,12" 
                                        Click="OpenSystemRestore">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F504;" FontFamily="Segoe UI Emoji" Margin="0,0,8,0"/>
                                            <TextBlock Text="Abrir Restauración del Sistema"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Botón REVERTIR TODOS LOS TWEAKS -->
                                    <Button Grid.Column="4"
                                        Style="{StaticResource OnButton}" 
                                        Background="#E81123"
                                        BorderBrush="#C42B1C"
                                        Padding="20,12" 
                                        Click="RevertAllTweaks">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄" FontFamily="Segoe UI Emoji" Margin="0,0,8,0"/>
                                            <TextBlock Text="REVERTIR TODOS LOS TWEAKS" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Text="Categorías Populares:" 
                                       FontSize="14" 
                                       Foreground="#A0A0A0"
                                       Margin="0,15,0,10"/>

                                <WrapPanel>
                                    <!-- Botón Red & Ping -->
                                    <Button Style="{StaticResource DashboardCategoryButton}"
                                        Click="NavigateToNetwork">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F4E1;" 
                                                   FontFamily="Segoe UI Emoji" 
                                                   FontSize="14"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="Red &amp; Ping" 
                                                   VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Botón GHOST Pack -->
                                    <Button Style="{StaticResource DashboardCategoryButton}"
                                        Click="NavigateToGhost">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x1F47B;" 
                                                   FontFamily="Segoe UI Emoji" 
                                                   FontSize="14"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="GHOST Pack" 
                                                   VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Botón Input & Visuals -->
                                    <Button Style="{StaticResource DashboardCategoryButton}"
                                        Click="NavigateToInput">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x2328;&#xFE0F;" 
                                                   FontFamily="Segoe UI Emoji" 
                                                   FontSize="14"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="Input &amp; Visuals" 
                                                   VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TODO: Las demás páginas las agrego en la siguiente parte -->
                <!-- Input Page -->
                <ScrollViewer x:Name="InputPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.RenderTransform>
                        <TranslateTransform/>
                    </ScrollViewer.RenderTransform>
                    <StackPanel Margin="40">
                        <TextBlock FontFamily="Segoe UI Emoji" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,10">
                        <Run Text="&#x2328;&#xFE0F;"/>&#x0020;<Run Text="Input &amp; Visuals"/>
                        </TextBlock>
                        <TextBlock Text="Optimizaciones de Input Lag y FPS" FontSize="14" Foreground="#A0A0A0" Margin="0,0,0,30"/>

                        <!-- Mouse Acceleration -->
                        <Border Style="{DynamicResource NeonGlowCard}" Padding="25" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <!-- Risk Level Indicator -->
                                        <Grid Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse Width="18" Height="18" Fill="#4CAF50" Opacity="0.2"/>
                                            <TextBlock Text="✓" FontFamily="Segoe UI Symbol" FontSize="11" FontWeight="Bold"
                                                      Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Nivel de Riesgo: Safe" FontWeight="Bold"/>
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="Desactivar Aceleración del Mouse" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="✅" FontFamily="Segoe UI Emoji" FontSize="14" Foreground="#0E7A0D" 
                                                 Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Recomendado para gaming"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Description}">
                                    <Run Text="MouseSpeed = 0, Thresholds = 0"/>
                                    <LineBreak/>
                                    <Run Text="Aim 1:1 pixel perfect, muscle memory consistente"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Style="{StaticResource InfoButton}" 
                                        Margin="0,0,15,0"
                                        VerticalAlignment="Center"
                                        Click="ShowTweakInfo" 
                                        Tag="mouse_acceleration"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- ModernToggleSwitch (CheckBox estilizado) -->
                                    <CheckBox x:Name="ToggleMouseAccel"
                                              Style="{StaticResource ModernToggleSwitch}"
                                              Checked="BtnMouseAccel_On_Click"
                                              Unchecked="BtnMouseAccel_Off_Click"
                                              VerticalAlignment="Center"
                                              Margin="0,0,15,0"
                                              ToolTip="Click para activar/desactivar tweak"/>

                                    <!-- Texto dinámico ON/OFF -->
                                    <TextBlock x:Name="TxtMouseAccelStatus"
                                               Text="OFF"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="#E74C3C"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Keyboard -->
                        <Border Style="{DynamicResource NeonGlowCard}" Padding="25" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <!-- Risk Level Indicator - Safe -->
                                        <Grid Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse Width="18" Height="18" Fill="#4CAF50" Opacity="0.2"/>
                                            <TextBlock Text="✓" FontFamily="Segoe UI Symbol" FontSize="11" FontWeight="Bold"
                                                      Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock Text="Nivel de Riesgo: Safe" FontWeight="Bold"/>
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="Optimizar Teclado" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="✅" FontFamily="Segoe UI Emoji" FontSize="14" Foreground="#0E7A0D" 
                                                 Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Recomendado para gaming"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Description}" Text="KeyboardDelay = 0, Input lag -50ms"/>
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Style="{StaticResource InfoButton}" 
                                        Margin="0,0,15,0"
                                        VerticalAlignment="Center"
                                        Click="ShowTweakInfo" 
                                        Tag="keyboard_optimization"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- ModernToggleSwitch (CheckBox estilizado) -->
                                    <CheckBox x:Name="ToggleKeyboard"
                                              Style="{StaticResource ModernToggleSwitch}"
                                              Checked="BtnKeyboard_On_Click"
                                              Unchecked="BtnKeyboard_Off_Click"
                                              VerticalAlignment="Center"
                                              Margin="0,0,15,0"
                                              ToolTip="Click para activar/desactivar tweak"/>

                                    <!-- Texto dinámico ON/OFF -->
                                    <TextBlock x:Name="TxtKeyboardStatus"
                                               Text="OFF"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="#E74C3C"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Visual Effects -->
                        <Border Style="{DynamicResource NeonGlowCard}" Padding="25" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
