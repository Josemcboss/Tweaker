                </StackPanel>
                <Button Grid.Column="1" Content="REFRESCAR LISTA" Style="{StaticResource OnButton}" Background="#5865F2" Padding="20,10" Command="{Binding RefreshStartupCommand}" />
              </Grid>
            </Border>
