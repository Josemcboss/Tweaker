                                    <TextBlock Text="• Windows Game Mode ON" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,3"/>
                                    <TextBlock Text="• GPU scheduling optimized" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,3"/>
                                    <TextBlock Text="• System responsiveness = 0" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,3"/>
                                    <TextBlock Text="• Game priority HIGH for 15+ games" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,10"/>

                                    <TextBlock Text="👻 GHOST PACK EXTREMO:" FontSize="14" FontWeight="Bold" Foreground="#E81123" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Core Isolation OFF (VBS)" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,3"/>
                                    <TextBlock Text="• MPO Fix (anti-flicker)" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,3"/>
                                    <TextBlock Text="• HPET optimized" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,3"/>
                                    <TextBlock Text="• CPU Scheduling AGGRESSIVE" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,10"/>

                                    <TextBlock Text="🛑 SERVICES MINIMAL:" FontSize="14" FontWeight="Bold" Foreground="#E81123" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Windows Search OFF" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,3"/>
                                    <TextBlock Text="• SysMain OFF" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,3"/>
                                    <TextBlock Text="• Non-essential services OFF" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,3"/>
                                    <TextBlock Text="• Windows Update OFF" FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,3"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Resultados esperados -->
                        <TextBlock Text="🎯 Resultados esperados:" FontSize="18" FontWeight="Bold" Foreground="#00FF00" Margin="0,30,0,15"/>

                        <Border Background="#0A1A0A" CornerRadius="8" Padding="20" BorderBrush="#00FF00" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Columna izquierda -->
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="🎯 COMPETITIVE PERFORMANCE:" FontSize="14" FontWeight="Bold" Foreground="#00FF00" Margin="0,0,0,8"/>
                                    <TextBlock FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,10">
                                    <Run Text="• Input lag: -70 a -120ms" FontWeight="Bold" Foreground="#00FF00"/>
                                    <LineBreak/>
                                    <Run Text="• Latencia de red: -15 a -40ms"/>
                                    <LineBreak/>
                                    <Run Text="• FPS: +10-25%"/>
                                    <LineBreak/>
                                    <Run Text="• 0.1% Low FPS: +15-30%"/>
                                    <LineBreak/>
                                    <Run Text="• Frame consistency: +20-35%"/>
                                    </TextBlock>

                                    <TextBlock Text="💾 RESOURCES FREED:" FontSize="14" FontWeight="Bold" Foreground="#00FF00" Margin="0,0,0,8"/>
                                    <TextBlock FontSize="12" Foreground="#B9BBBE">
                                    <Run Text="• RAM: +300-800MB para el juego"/>
                                    <LineBreak/>
                                    <Run Text="• CPU: +5-15% disponible"/>
                                    <LineBreak/>
                                    <Run Text="• GPU: 100% dedicado al juego"/>
                                    <LineBreak/>
                                    <Run Text="• Network: Mínima interferencia"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Columna derecha -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="🏆 COMPETITIVE ADVANTAGE:" FontSize="14" FontWeight="Bold" Foreground="#00FF00" Margin="0,0,0,8"/>
                                    <TextBlock FontSize="12" Foreground="#B9BBBE" Margin="0,0,0,10">
                                    <Run Text="• Aim más preciso y consistente"/>
                                    <LineBreak/>
                                    <Run Text="• Mejor hitreg en FPS competitivos"/>
                                    <LineBreak/>
                                    <Run Text="• Respuesta instantánea a inputs"/>
                                    <LineBreak/>
                                    <Run Text="• Sin micro-stutters ni lag spikes"/>
                                    <LineBreak/>
                                    <Run Text="• Ventaja competitiva mensurable"/>
                                    </TextBlock>

                                    <TextBlock Text="🎮 GAMES OPTIMIZED FOR:" FontSize="14" FontWeight="Bold" Foreground="#00FF00" Margin="0,0,0,8"/>
                                    <TextBlock FontSize="12" Foreground="#B9BBBE">
                                    <Run Text="• Counter-Strike 2"/>
                                    <LineBreak/>
                                    <Run Text="• Valorant"/>
                                    <LineBreak/>
                                    <Run Text="• League of Legends"/>
                                    <LineBreak/>
                                    <Run Text="• Overwatch 2"/>
                                    <LineBreak/>
                                    <Run Text="• Apex Legends"/>
                                    <LineBreak/>
                                    <Run Text="• Rocket League"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Recomendaciones finales -->
                        <Border Background="#1A1A2E" CornerRadius="8" Padding="20" Margin="0,20,0,0" BorderBrush="#7F8C8D" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚡ Recomendaciones para gaming competitivo:" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="#7F8C8D" 
                                       Margin="0,0,0,10"/>

                                <TextBlock FontSize="12" Foreground="#B9BBBE" TextWrapping="Wrap" LineHeight="18">
                                <Run Text="1. " FontWeight="Bold"/>
                                <Run Text="Aplica el preset COMPLETO antes de una sesión competitiva"/>
                                <LineBreak/>
                                <Run Text="2. " FontWeight="Bold"/>
                                <Run Text="REINICIA Windows después de aplicar tweaks críticos"/>
                                <LineBreak/>
                                <Run Text="3. " FontWeight="Bold"/>
                                <Run Text="Cierra TODOS los programas no esenciales antes de jugar"/>
                                <LineBreak/>
                                <Run Text="4. " FontWeight="Bold"/>
                                <Run Text="Usa monitor 240Hz+ para aprovechar completamente las optimizaciones"/>
                                <LineBreak/>
                                <Run Text="5. " FontWeight="Bold"/>
                                <Run Text="Considera revertir el preset si experimentas inestabilidad"/>
                                <LineBreak/>
                                <Run Text="6. " FontWeight="Bold"/>
                                <Run Text="Mantén drivers actualizados (GPU, mouse, teclado)"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Advanced Latency Page -->
                <ScrollViewer x:Name="AdvancedLatencyPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.RenderTransform>
                        <TranslateTransform/>
                    </ScrollViewer.RenderTransform>
                    <StackPanel Margin="40">
                        <TextBlock FontFamily="Segoe UI Emoji" FontSize="28" FontWeight="Bold" Foreground="#00D9FF" Margin="0,0,0,10">
                            <Run Text="⚡"/>&#x0020;<Run Text="Latency Tweaks"/>
                        </TextBlock>
                        <TextBlock Text="Optimizaciones de latencia de bajo nivel del sistema" FontSize="14" Foreground="#A0A0A0" Margin="0,0,0,30"/>

                        <!-- Interrupt Moderation -->
                        <Border Style="{DynamicResource NeonGlowCard}" Padding="25" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🔌 Deshabilitar Interrupt Moderation" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource Description}">
                                        <Run Text="Fuerza procesamiento inmediato de paquetes de red"/>
                                        <LineBreak/>
                                        <Run Text="Latencia de red -2-10ms por paquete, jitter reducido" FontWeight="Bold" Foreground="#0E7A0D"/>
                                        <LineBreak/>
                                        <Run Text="⚠️ CPU usage de red puede subir +1-3%" Foreground="#FFA500"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource InfoButton}" Margin="0,0,15,0" VerticalAlignment="Center" Click="ShowTweakInfo" Tag="interrupt_moderation"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ToggleInterruptModeration" Style="{StaticResource ModernToggleSwitch}"
                                              Checked="BtnInterruptModeration_On_Click" Unchecked="BtnInterruptModeration_Off_Click"
                                              VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <TextBlock x:Name="TxtInterruptModerationStatus" Text="OFF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Foreground="#E74C3C"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Menu Show Delay -->
                        <Border Style="{DynamicResource NeonGlowCard}" Padding="25" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="⚡ MenuShow Delay 0ms" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource Description}">
                                        <Run Text="Reduce delay artificial de menús de 400ms → 0ms"/>
                                        <LineBreak/>
                                        <Run Text="UI responde instantáneamente, Alt+Tab más rápido" FontWeight="Bold" Foreground="#0E7A0D"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource InfoButton}" Margin="0,0,15,0" VerticalAlignment="Center" Click="ShowTweakInfo" Tag="menu_show_delay"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ToggleMenuShowDelay" Style="{StaticResource ModernToggleSwitch}"
                                              Checked="BtnMenuShowDelay_On_Click" Unchecked="BtnMenuShowDelay_Off_Click"
                                              VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <TextBlock x:Name="TxtMenuShowDelayStatus" Text="OFF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Foreground="#E74C3C"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Data Queue Sizes -->
                        <Border Style="{DynamicResource NeonGlowCard}" Padding="25" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🎮 Optimizar Data Queue Sizes" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource Description}">
                                        <Run Text="Mouse: 100→256 buffers | Teclado: 100→200 buffers"/>
                                        <LineBreak/>
                                        <Run Text="Cero inputs perdidos con polling rates 1000Hz+" FontWeight="Bold" Foreground="#0E7A0D"/>
                                        <LineBreak/>
                                        <Run Text="⚠️ REQUIERE REINICIO" Foreground="#FFA500"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource InfoButton}" Margin="0,0,15,0" VerticalAlignment="Center" Click="ShowTweakInfo" Tag="data_queue_sizes"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ToggleDataQueueSizes" Style="{StaticResource ModernToggleSwitch}"
                                              Checked="BtnDataQueueSizes_On_Click" Unchecked="BtnDataQueueSizes_Off_Click"
                                              VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <TextBlock x:Name="TxtDataQueueSizesStatus" Text="OFF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Foreground="#E74C3C"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- CSRSS Priority -->
                        <Border Style="{DynamicResource NeonGlowCard}" Padding="25" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🖥️ CSRSS High Priority" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource Description}">
                                        <Run Text="Prioriza el proceso de rendering Win32 del sistema"/>
                                        <LineBreak/>
                                        <Run Text="Menos micro-stutters en UI durante gaming intensivo" FontWeight="Bold" Foreground="#0E7A0D"/>
                                        <LineBreak/>
                                        <Run Text="⚠️ Temporal, se restaura al reiniciar" Foreground="#FFA500"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource InfoButton}" Margin="0,0,15,0" VerticalAlignment="Center" Click="ShowTweakInfo" Tag="csrss_priority"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ToggleCsrssPriority" Style="{StaticResource ModernToggleSwitch}"
                                              Checked="BtnCsrssPriority_On_Click" Unchecked="BtnCsrssPriority_Off_Click"
                                              VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <TextBlock x:Name="TxtCsrssPriorityStatus" Text="OFF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Foreground="#E74C3C"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- GPU IRQ Affinity -->
                        <Border Style="{DynamicResource NeonGlowCard}" Padding="25" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🎯 GPU IRQ Affinity (Último Core)" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource Description}">
                                        <Run Text="Asigna interrupciones GPU a un core dedicado"/>
                                        <LineBreak/>
                                        <Run Text="DPC latency reducida, frame times más consistentes" FontWeight="Bold" Foreground="#0E7A0D"/>
                                        <LineBreak/>
                                        <Run Text="⚠️ REQUIERE REINICIO OBLIGATORIO | Mínimo 4 cores" Foreground="#E81123" FontWeight="Bold"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource InfoButton}" Margin="0,0,15,0" VerticalAlignment="Center" Click="ShowTweakInfo" Tag="gpu_irq_affinity"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ToggleGpuIrqAffinity" Style="{StaticResource ModernToggleSwitch}"
                                              Checked="BtnGpuIrqAffinity_On_Click" Unchecked="BtnGpuIrqAffinity_Off_Click"
                                              VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <TextBlock x:Name="TxtGpuIrqAffinityStatus" Text="OFF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Foreground="#E74C3C"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Startup Manager Page -->
                <ScrollViewer x:Name="StartupPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.RenderTransform>
                        <TranslateTransform/>
                    </ScrollViewer.RenderTransform>
                    <StackPanel Margin="40">
                        <TextBlock FontFamily="Segoe UI Emoji" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,10">
                        <Run Text="🚀"/>&#x0020;<Run Text="Startup Manager"/>
                        </TextBlock>
                        <TextBlock Text="Gestiona aplicaciones que arrancan con Windows para mejorar la velocidad de inicio." 
                               FontSize="14" Foreground="#A0A0A0" Margin="0,0,0,30"/>

                        <!-- Header Actions -->
                        <Border Style="{DynamicResource NeonGlowCard}" Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Optimización de Inicio" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                                    <TextBlock Text="Deshabilitar programas innecesarios puede liberar RAM y reducir el tiempo de carga del sistema." 
                                           Foreground="#B9BBBE" FontSize="12"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="REFRESCAR LISTA" 
                                        Style="{StaticResource OnButton}" 
                                        Background="#5865F2"
                                        Padding="20,10"
                                        Command="{Binding RefreshStartupCommand}"/>
                            </Grid>
                        </Border>

                        <!-- Items List -->
                        <ItemsControl x:Name="StartupItemsList" ItemsSource="{Binding StartupItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource NeonGlowCard}" Padding="15" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Icon Placeholder -->
                                            <Border Grid.Column="0" Width="40" Height="40" Background="#2A2D31" CornerRadius="6" Margin="0,0,15,0">
                                                <TextBlock Text="📦" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                                <TextBlock Text="{Binding Command}" Foreground="#7F8084" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Source}" Foreground="#5865F2" FontSize="10" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="DESHABILITAR" 
                                                    Style="{StaticResource OffButton}" 
                                                    Padding="12,6"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.DisableStartupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State -->
                        <TextBlock x:Name="TxtNoStartupItems" 
                               Text="No se encontraron elementos de inicio o la lista está optimizada." 
                               Foreground="#7F8084" 
                               HorizontalAlignment="Center" 
                               Margin="0,50,0,0"
                               Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
            <!-- Cierre <Grid Grid.Column="1"> (Área de contenido) -->
        </Grid>
        <!-- Cierre Grid Columnas (Sidebar + Content) -->

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- GAME BOOSTER WIDGET - FLOTANTE ESQUINA SUPERIOR DERECHA -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <controls:GameBoosterWidget 
            x:Name="GameBoosterWidget"
            VerticalAlignment="Top"
            HorizontalAlignment="Right"
            Margin="0,45,20,0"
            Panel.ZIndex="9999"
            Grid.Row="1"
            Grid.ColumnSpan="2" Grid.Column="3"/>

    </Grid>
    <!-- Cierre Grid Rows (TitleBar + Content) -->
</Window>

