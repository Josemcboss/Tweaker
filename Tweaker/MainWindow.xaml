                        <TextBlock Text="📦" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="Bold" Foreground="#FFFFFFFF" FontSize="14" Text="{Binding Name}" />
                        <TextBlock Foreground="#7F8084" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Command}" />
                        <TextBlock Foreground="#5865F2" FontSize="10" Margin="0,2,0,0" Text="{Binding Source}" />
                      </StackPanel>
                      <Button Grid.Column="2" Content="DESHABILITAR" Style="{StaticResource OffButton}" Padding="12,6" VerticalAlignment="Center" Command="{Binding DataContext.DisableStartupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
