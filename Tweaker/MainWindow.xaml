                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer Name="HistoryPage" Visibility="{Binding CurrentPageName, Converter={StaticResource PageNameToVisibilityConverter}, ConverterParameter=History}" VerticalScrollBarVisibility="Auto">
          <UIElement.RenderTransform>
            <TranslateTransform />
          </UIElement.RenderTransform>
