<Window x:Class="Tweaker.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:resources="clr-namespace:Tweaker.Resources"
xmlns:controls="clr-namespace:Tweaker.Controls"
mc:Ignorable="d"
Title="Ghost Optimizer - Gaming Tweaker" 
Height="938" 
Width="1538"
Background="#0F0F0F"
WindowStartupLocation="CenterScreen"
ResizeMode="CanResize"
WindowStyle="None"
AllowsTransparency="False"
Icon="{StaticResource GhostOptimizerIcon}">

    <Window.Resources>
        <!-- ────────────────────────────────────────── -->
        <!-- ESTILOS MODERNOS (HONE.GG / DISCORD STYLE) -->
        <!-- ────────────────────────────────────────── -->

        <!-- Botón del Sidebar (Menú Lateral) -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B9BBBE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,3,0"
                                BorderBrush="Transparent"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2D31"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Active">
                                <Setter TargetName="border" Property="BorderBrush" Value="#5865F2"/>
                                <Setter Property="Background" Value="#35363C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón ON (verde gaming) -->
        <Style x:Key="OnButton" TargetType="Button">
            <Setter Property="Background" Value="#0E7A0D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#107C10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#11910F"/>
                    <Setter Property="BorderBrush" Value="#13A813"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón OFF (rojo gaming) -->
        <Style x:Key="OffButton" TargetType="Button">
            <Setter Property="Background" Value="#A80000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C50500"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C50500"/>
                    <Setter Property="BorderBrush" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Título de sección -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Descripción -->
        <Style x:Key="Description" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Title Bar Button Base - MEJORADO -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#404040"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Close Button - MEJORADO (Hover rojo más visible) -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C50500"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón de Categoría del Dashboard -->
        <Style x:Key="DashboardCategoryButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2D31"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#35393F"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#40444B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern RadioButton Style -->
        <Style x:Key="ModernRadioButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" 
                                Background="#2C2F33" 
                                BorderBrush="#5865F2" 
                                BorderThickness="1" 
                                CornerRadius="15"
                                Padding="12,8"
                                Margin="2">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextBlock.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#5865F2"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#7289DA"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#40444B"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#7289DA"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Info Button Style para tooltips de tweaks -->
        <Style x:Key="InfoButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5865F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#5865F2"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Content" Value="?"/>
            <Setter Property="ToolTip" Value="Información detallada del tweak"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5865F2"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#4752C4"/>
                    <Setter Property="BorderBrush" Value="#4752C4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- GLASS & NEON STYLES (MODERNOS) -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->

        <!-- GlassCard Style - Efecto Glass Morphism -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <!-- Gradiente radial sutil desde el centro -->
                    <RadialGradientBrush>
                        <GradientStop Color="#CC1E1E1E" Offset="0"/>
                        <GradientStop Color="#CC151515" Offset="1"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <!-- Gradiente vertical: luz cenital -->
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#404040" Offset="0"/>
                        <GradientStop Color="#101010" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" 
                                    BlurRadius="20" 
                                    ShadowDepth="0" 
                                    Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NeonBorder Style - Efecto Neon Glow en Hover -->
        <Style x:Key="NeonBorder" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" 
                                    BlurRadius="8" 
                                    ShadowDepth="0" 
                                    Opacity="0.3"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#00D9FF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <!-- Neon Glow Effect -->
                            <DropShadowEffect Color="#00D9FF" 
                                            BlurRadius="20" 
                                            ShadowDepth="0" 
                                            Opacity="0.8"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- GlassCardWithHover Style - Combina Glass + Neon -->
        <Style x:Key="GlassCardWithHover" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <RadialGradientBrush>
                        <GradientStop Color="#CC1E1E1E" Offset="0"/>
                        <GradientStop Color="#CC151515" Offset="1"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#404040" Offset="0"/>
                        <GradientStop Color="#101010" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" 
                                    BlurRadius="20" 
                                    ShadowDepth="0" 
                                    Opacity="0.4"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#00D9FF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <!-- Neon Glow cuando hover -->
                            <DropShadowEffect Color="#00D9FF" 
                                            BlurRadius="25" 
                                            ShadowDepth="0" 
                                            Opacity="0.7"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- PurpleNeonBorder Style - Variante morada para GHOST Pack -->
        <Style x:Key="PurpleNeonBorder" TargetType="Border" BasedOn="{StaticResource NeonBorder}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#A970FF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#A970FF" 
                                            BlurRadius="20" 
                                            ShadowDepth="0" 
                                            Opacity="0.8"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- RedNeonBorder Style - Variante roja para tweaks peligrosos -->
        <Style x:Key="RedNeonBorder" TargetType="Border" BasedOn="{StaticResource NeonBorder}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#E81123"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#E81123" 
                                            BlurRadius="20" 
                                            ShadowDepth="0" 
                                            Opacity="0.8"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dashboard action styles -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource OnButton}">
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="BorderBrush" Value="#4752C4"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource OffButton}">
            <Setter Property="Background" Value="#2D2B55"/>
            <Setter Property="BorderBrush" Value="#534AB7"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource OffButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="BorderBrush" Value="#8B3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="RestartBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFAB40"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PendingRestartCount}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- ========================================= -->
    <!-- BEGIN WINDOW CONTENT -->
    <!-- ========================================= -->

    <!-- ROOT GRID -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288*"/>
            <ColumnDefinition Width="123*"/>
            <ColumnDefinition Width="396*"/>
            <ColumnDefinition Width="582*"/>
            <ColumnDefinition Width="149*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <!-- Title Bar -->
            <RowDefinition Height="*"/>
            <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- CUSTOM TITLE BAR - MEJORADO -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" 
                Background="#1A1A1A" 
                BorderThickness="0,0,0,1"
                BorderBrush="#2A2A2A"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Grid.ColumnSpan="5" HorizontalAlignment="Stretch" Height="NaN" Margin="0,0,0,0" VerticalAlignment="Stretch" Width="NaN">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo y Título a la izquierda -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="8,0,0,0">

                    <!-- Logo GHOST OPTIMIZER -->
                    <resources:GhostOptimizerLogo Width="24" Height="24" 
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>

                    <!-- Título principal -->
                    <TextBlock Text="GHOST OPTIMIZER" 
                               FontFamily="Impact, Arial Black"
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#A970FF" 
                                            BlurRadius="6" 
                                            ShadowDepth="0" 
                                            Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Separador -->
                    <Border Width="1" Height="16" 
                            Background="#3A3A3A" 
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"/>

                    <!-- Subtítulo -->
                    <TextBlock Text="Gaming Tweaker" 
                               FontFamily="Segoe UI"
                               FontSize="11" 
                               Foreground="#B9BBBE"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF4500" 
                                            BlurRadius="4" 
                                            ShadowDepth="0" 
                                            Opacity="0.3"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Botones de control a la derecha -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right">

                    <Border x:Name="RestartBadge"
                            Style="{StaticResource RestartBadgeStyle}"
                            ToolTip="Tweak(s) pendientes de reinicio"
                            MouseLeftButtonUp="RestartBadge_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄 " FontSize="12"/>
                            <TextBlock FontSize="12" Foreground="#1A1A1A" FontWeight="SemiBold">
                                <Run Text="{Binding PendingRestartCount}"/>
                                <Run Text=" tweaks pendientes de reinicio"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>


                    <!-- Botón Minimizar -->
                    <Button Style="{StaticResource TitleBarButton}" 
                            Click="MinimizeButton_Click"
                            ToolTip="Minimizar">
                        <Viewbox Width="10" Height="10" 
                                 VerticalAlignment="Center" 
                                 HorizontalAlignment="Center">
                            <Path Data="M 0,0 L 10,0" 
                                  Stroke="White" 
                                  StrokeThickness="1.5"/>
                        </Viewbox>
                    </Button>

                    <!-- Botón Cerrar -->
                    <Button Style="{StaticResource CloseButton}" 
                            Click="CloseButton_Click"
                            ToolTip="Cerrar">
                        <Viewbox Width="10" Height="10" 
                                 VerticalAlignment="Center" 
                                 HorizontalAlignment="Center">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" 
                                  Stroke="White" 
                                  StrokeThickness="1.5"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- CONTENIDO PRINCIPAL (SIDEBAR + PÁGINAS) -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Grid.ColumnSpan="5">
            <Grid.ColumnDefinitions>
                <!-- Columna 0: Sidebar -->
                <ColumnDefinition Width="240"/>
                <!-- Columna 1: Contenido -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═════════════════════════════════════════════════════════════════ -->
            <!-- COLUMNA 0: SIDEBAR (MENÚ LATERAL) -->
            <!-- ═════════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" 
                Background="#1E1E1E" 
                BorderBrush="#2A2A2A" 
                BorderThickness="0,0,1,0">
                <StackPanel>
                    <!-- Header del Sidebar -->
                    <Border Background="#151515" 
                        Padding="20,25"
                        BorderBrush="#2A2A2A"
                        BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe UI Emoji" FontSize="20" FontWeight="Bold" Foreground="#5865F2">
                            <Run Text="&#x26A1;"/>&#x0020;<Run Text="TWEAKER"/>
                            </TextBlock>
                            <TextBlock Text="Gaming Dashboard" 
                                   FontSize="11" 
                                   Foreground="#7F8084"
                                   Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Botones de Navegación -->
                    <StackPanel Margin="0,15,0,0">
                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToDashboard"
                            x:Name="BtnNavDashboard"
                            Tag="Active">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F3E0;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToInput"
                            x:Name="BtnNavInput">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2328;&#xFE0F;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Input &amp; Visuals" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToNetwork"
                            x:Name="BtnNavNetwork">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4E1;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Red &amp; Ping" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToSystem"
                            x:Name="BtnNavSystem">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F3AE;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Sistema &amp; GPU" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToCleanup"
                            x:Name="BtnNavCleanup">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F9F9;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Limpieza" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToStartup"
                            x:Name="BtnNavStartup">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F680;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Startup Manager" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToGhost"
                            x:Name="BtnNavGhost">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F47B;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="GHOST Pack" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToAdvanced"
                            x:Name="BtnNavAdvanced">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x26A0;&#xFE0F;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Advanced" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToAdvancedLatency"
                            x:Name="BtnNavAdvancedLatency">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x26A1;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Latency Tweaks" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToLaptop"
                            x:Name="BtnNavLaptop">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4BB;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Preset Laptop" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToCompetitive"
                            x:Name="BtnNavCompetitive">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F3C6;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Competitive Gaming" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToDebloatWizard"
                            x:Name="BtnNavDebloat">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F9F9;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Debloat Wizard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="GPU &amp; Display">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F3AE;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="GPU &amp; Display" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Almacenamiento">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4BE;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Almacenamiento" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="CPU Avanzado">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="CPU Avanzado" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Profiles">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4C1;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Perfiles" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="History">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4CB;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Historial" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Footer del Sidebar -->
                    <Border Background="#151515" 
                        Padding="15"
                        BorderBrush="#2A2A2A"
                        BorderThickness="0,1,0,0"
                        VerticalAlignment="Bottom"
                        Margin="0,180,0,0">
                        <StackPanel>
                            <!-- Mini logo -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <resources:GhostOptimizerLogo Width="16" Height="16" 
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>
                                <TextBlock Text="GHOST OPTIMIZER" 
                                       FontFamily="Impact, Arial Black"
                                       FontSize="10" 
                                       FontWeight="Bold"
                                       Foreground="#A970FF"
                                       VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock FontFamily="Segoe UI Emoji" FontSize="10" Foreground="#FFC107" FontWeight="SemiBold" Margin="0,0,0,5">
                            <Run Text="&#x26A0;&#xFE0F;"/>&#x0020;<Run Text="Ejecutar como Admin"/>
                            </TextBlock>
                            <TextBlock Text="v2.0 - DaddyGhost Edition" 
                                   FontSize="9" 
                                   Foreground="#5F5F5F"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═════════════════════════════════════════════════════════════════ -->
            <!-- COLUMNA 1: ÁREA DE CONTENIDO (PESTAÑAS) -->
            <!-- ═════════════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1" Background="#252526">

                <!-- Dashboard Page -->
                <ScrollViewer x:Name="DashboardPage" 
                          Visibility="Visible" 
                          VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.RenderTransform>
                        <TranslateTransform/>
                    </ScrollViewer.RenderTransform>
                    <StackPanel Margin="40">
                        <!-- Header con logo -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <!-- Logo grande -->
                            <resources:GhostOptimizerLogo Width="60" Height="60" 
                                                       Margin="0,0,20,0"
                                                       VerticalAlignment="Center"/>

                            <!-- Texto del header -->
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontFamily="Impact, Arial Black" FontSize="32" FontWeight="Bold" Foreground="White">
                                <Run Text="GHOST OPTIMIZER"/>
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#A970FF" 
                                                    BlurRadius="8" 
                                                    ShadowDepth="0" 
                                                    Opacity="0.6"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock FontFamily="Segoe UI" FontSize="16" Foreground="#B9BBBE" Margin="0,5,0,0">
                                <Run Text="Gaming Performance Dashboard"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Optimizador Gaming Profesional" 
                               FontSize="14" 
                               Foreground="#A0A0A0"
                               Margin="0,0,0,30"/>

                        <!-- Stats Cards (DINÁMICAS) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Tweaks Activos (DINÁMICO) -->
                            <Border Grid.Column="0" 
                                Style="{DynamicResource NeonGlowCard}"
                                Padding="20"
                                Margin="0,0,10,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtActiveTweaks" 
                                                Text="{Binding ActiveTweakCount}" 
                                                FontSize="32" 
                                                FontWeight="Bold" 
                                                Foreground="#5865F2"/>
                                        <TextBlock Text="/" 
                                                FontSize="20" 
                                                FontWeight="Bold" 
                                                Foreground="#7F8084"
                                                Margin="5,8,0,0"/>
                                        <TextBlock Text="{Binding TotalTweaksCount}" 
                                                FontSize="20" 
                                                FontWeight="Bold" 
                                                Foreground="#7F8084"
                                                Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Tweaks Activos" FontSize="12" Foreground="#A0A0A0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock x:Name="TxtOptimizationPercent" 
                                                Text="{Binding OptimizationPercentage, StringFormat={}{0:0}%}" 
                                                FontSize="10" 
                                                Foreground="#0E7A0D" 
                                                FontWeight="SemiBold"/>
                                        <TextBlock Text=" optimizado" 
                                                FontSize="10" 
                                                Foreground="#7F8084"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Beneficios Estimados (DINÁMICO) -->
                            <Border Grid.Column="1" 
                                Style="{DynamicResource NeonGlowCard}"
                                Padding="20"
                                Margin="5,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtEstimatedFps" 
                                            Text="{Binding EstimatedFpsGain, StringFormat=+{0}}" 
                                            FontSize="32" 
                                            FontWeight="Bold" 
                                            Foreground="#0E7A0D"/>
                                    <TextBlock Text="FPS Estimados" FontSize="12" Foreground="#A0A0A0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="🎯 " FontFamily="Segoe UI Emoji" FontSize="10"/>
                                        <TextBlock x:Name="TxtLatencyReduction" 
                                                Text="{Binding EstimatedPingReduction, StringFormat=-{0}ms ping}" 
                                                FontSize="10" 
                                                Foreground="#7F8084"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>


                            <!-- Card 3: RAM Liberada (DINÁMICO) -->
                            <Border Grid.Column="2" 
                                Style="{DynamicResource NeonGlowCard}"
                                Padding="20"
                                Margin="10,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtRamFreed" 
                                                Text="{Binding RamFreedGB, StringFormat={}{0:0.0}}" 
                                                FontSize="32" 
                                                FontWeight="Bold" 
                                                Foreground="#9B59B6"/>
                                        <TextBlock Text=" GB" 
                                                FontSize="18" 
                                                FontWeight="Bold" 
                                                Foreground="#7F8084"
                                                Margin="3,10,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="RAM Liberada" FontSize="12" Foreground="#A0A0A0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="💾 " FontFamily="Segoe UI Emoji" FontSize="10"/>
                                        <TextBlock Text="Memoria optimizada" 
                                                FontSize="10" 
                                                Foreground="#7F8084"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </Grid>

                        <!-- Divider -->
                        <Border Height="1" Background="#2A2A2A" Margin="0,30"/>

                        <!-- System Info & Anticheat Warning Section (NUEVO) -->
                        <Border Background="#1E1E2E" 
                                CornerRadius="12" 
                                Padding="20" 
                                Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.ColumnSpan="3" 
                                           Text="⚙️ Información del Sistema"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#9D8FFF"
                                           Margin="0,0,0,12"/>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="CPU" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding HardwareInfo.CPUName, FallbackValue=Detectando...}" 
                                               FontSize="12" Foreground="#E0E0E0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock FontSize="11" Foreground="#888" Margin="0,2,0,0">
                                        <Run Text="{Binding HardwareInfo.CPUCores}"/>
                                        <Run Text=" núcleos"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="GPU" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding HardwareInfo.GPUName, FallbackValue=Detectando...}" 
                                               FontSize="12" Foreground="#E0E0E0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock FontSize="11" Foreground="#888" Margin="0,2,0,0"
                                               Text="{Binding HardwareInfo.GPUName, FallbackValue=Detectando...}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Text="RAM · Disco" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                                    <TextBlock FontSize="12" Foreground="#E0E0E0">
                                        <Run Text="{Binding HardwareInfo.TotalRAMGB}"/>
                                        <Run Text=" GB RAM"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="#888" Margin="0,2,0,0">
                                        <Run Text="{Binding HardwareInfo.IsSSD}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding HardwareInfo.WindowsVersion, FallbackValue=Detectando...}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#2D1A1A"
                                BorderBrush="#8B3A3A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10"
                                Margin="0,8,0,0"
                                Visibility="{Binding HasDetectedAntiCheats, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️ " FontSize="13"/>
                                <TextBlock FontSize="12" Foreground="#FF8A80">
                                    <Run Text="Anticheat detectado: "/>
                                    <Run Text="{Binding DetectedAntiCheatsSummary}" FontWeight="SemiBold"/>
                                    <Run Text=" — Algunos tweaks pueden causar ban."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Smart Scan Section (NUEVO) -->
                        <Border Background="#2A2D31" 
                                CornerRadius="12" 
                                Padding="20" 
                                Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="🎯 Smart Scan: Optimización Rápida" 
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#9D8FFF"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="Realiza un análisis rápido para aplicar las optimizaciones más relevantes según tu hardware." 
                                           FontSize="12" Foreground="#B9BBBE" 
                                           TextWrapping="Wrap" Margin="0,0,0,20"/>

                                <!-- Progress Bar y Botón de Acción -->
                                <StackPanel Orientation="Horizontal" 
                                            Margin="0,0,0,10"
                                            HorizontalAlignment="Stretch">
                                    <!-- Barra de Progreso (DINÁMICA) -->
                                    <Border Background="#404040" 
                                            CornerRadius="8" 
                                            Height="8" 
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,10,0">
                                        <Border x:Name="ProgressBarIndicator"
                                                Background="#5865F2" 
                                                CornerRadius="8" 
                                                Height="8"
                                                Width="0"/>
                                    </Border>

                                    <!-- Texto de Porcentaje (DINÁMICO) -->
                                    <TextBlock x:Name="TxtSmartScanPercent"
                                               Text="0%"
                                               FontSize="12" 
                                               Foreground="#B9BBBE"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Botón de Acción (DINÁMICO) -->
                                <Button Style="{StaticResource PrimaryButton}"
                                        x:Name="BtnSmartScan"
                                        Click="SmartScanButton_Click">
                                    <TextBlock Text="Iniciar Smart Scan" 
                                               FontSize="14" 
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Button>

                                <!-- Mensaje Informativo -->
                                <TextBlock Text="🔍 El Smart Scan detectará automáticamente el hardware y aplicará las mejores configuraciones." 
                                           FontSize="11" Foreground="#A0A0A0"
                                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Divider -->
                        <Border Height="1" Background="#2A2A2A" Margin="0,30"/>

                        <!-- Game Mode Section (NUEVO) -->
                        <Border Background="#2A2D31" 
                                CornerRadius="12" 
                                Padding="20" 
                                Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="🎮 Game Mode: Optimización Máxima" 
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#9D8FFF"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="Activa el Modo Gaming para ajustar automáticamente la configuración del sistema y maximizar el rendimiento del juego." 
                                           FontSize="12" Foreground="#B9BBBE" 
                                           TextWrapping="Wrap" Margin="0,0,0,20"/>

                                <!-- Botón de Activación (DINÁMICO) -->
                                <Button Style="{StaticResource PrimaryButton}"
                                        x:Name="BtnToggleGameMode"
                                        Click="ToggleGameMode_Click">
                                    <!-- Contenido Cambiante según Estado -->
                                    <ContentPresenter Content="{Binding IsGameModeActive, Converter={StaticResource BooleanToContentConverter}}"
                                                      ContentTemplate="{Binding IsGameModeActive, Converter={StaticResource BooleanToDataTemplateConverter}}"/>
                                </Button>

                                <!-- Indicador de Estado (DINÁMICO) -->
                                <TextBlock x:Name="TxtGameModeStatus"
                                           Text="{Binding IsGameModeActive, Converter={StaticResource BooleanToStatusConverter}}"
                                           FontSize="12" 
                                           Foreground="{Binding IsGameModeActive, Converter={StaticResource StatusColorConverter}}"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══════════════════════════════════════════════════════════════════ -->
                        <!-- NUEVO: SECCIÓN DE AJUSTES AVANZADOS (PANTALLA COMPLETA) -->
                        <!-- ═══════════════════════════════════════════════════════════════════ -->
                        <Border Background="#1E1E1E" 
                                CornerRadius="12" 
                                Padding="20" 
                                Margin="0,16,0,0">
                            <StackPanel>
                             <TextBlock Text="⚙️ Ajustes Avanzados" 
                                        FontSize="16" FontWeight="Bold"
                                        Foreground="White"
                                        Margin="0,0,0,12"/>

                            <TextBlock Text="Esta sección te permite modificar ajustes avanzados del sistema y del optimizador." 
                                       FontSize="12" Foreground="#B9BBBE" 
                                       TextWrapping="Wrap" Margin="0,0,0,20"/>

                            <!-- Contenedor para los toggles de ajustes avanzados -->
                            <StackPanel x:Name="AdvancedSettingsContainer"
                                        Margin="0,0,0,10">
                                <!-- Cada fila tendrá un Toggle y una descripción -->
                                <!-- Toggle 1: Desactivar Reinicio/Verificación (Ejemplo) -->
                                <StackPanel Orientation="Horizontal" 
                                            Margin="0,0,0,12">
                                    <ToggleButton x:Name="ToggleDisableReboot"
                                                  Content="Desactivar Reinicio Requerido"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding DisableReboot, Mode=TwoWay}"
                                                  Width="200"
                                                  Height="36"
                                                  Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource InfoButton}"
                                            ToolTip="Al activar, el sistema no pedirá reiniciar después de aplicar tweaks compatibles."
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Toggle 2: Modo Silencioso (Ejemplo) -->
                                <StackPanel Orientation="Horizontal" 
                                            Margin="0,0,0,12">
                                    <ToggleButton x:Name="ToggleSilentMode"
                                                  Content="Activar Modo Silencioso"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding SilentMode, Mode=TwoWay}"
                                                  Width="200"
                                                  Height="36"
                                                  Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource InfoButton}"
                                            ToolTip="Reduce los sonidos del sistema y oculta notificaciones temporales."
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Toggle 3: Desactivar AntiCheat (Ejemplo) -->
                                <StackPanel Orientation="Horizontal" 
                                            Margin="0,0,0,12">
                                    <ToggleButton x:Name="ToggleDisableAntiCheat"
                                                  Content="Desactivar Protección AntiCheat"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding DisableAntiCheat, Mode=TwoWay}"
                                                  Width="200"
                                                  Height="36"
                                                  Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource InfoButton}"
                                            ToolTip="Desactiva temporalmente la protección AntiCheat. Útil para pruebas."
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- NUEVO: Toggle 4 para activar/desactivar todos los tweaks -->
                                <StackPanel Orientation="Horizontal" 
                                            Margin="0,0,0,12">
                                    <ToggleButton x:Name="ToggleEnableAllTweaks"
                                                  Content="Activar Todos los Tweaks"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding AreAllTweaksEnabled, Mode=TwoWay}"
                                                  Width="200"
                                                  Height="36"
                                                  Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource InfoButton}"
                                            ToolTip="Habilita o deshabilita todos los tweaks de un solo ajuste."
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- NUEVO: Botón para aplicar ajustes avanzados -->
                                <Button Style="{StaticResource PrimaryButton}"
                                        x:Name="BtnApplyAdvancedSettings"
                                        Click="ApplyAdvancedSettings_Click">
                                    <TextBlock Text="Aplicar Ajustes Avanzados" 
                                               FontSize="14" 
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Button>
                            </StackPanel>

                            <!-- Mensaje de advertencia para ajustes avanzados -->
                             <TextBlock Text="⚠️ Ten cuidado al modificar ajustes avanzados. Pueden afectar la estabilidad del sistema." 
                                        FontSize="11" Foreground="#FF8888"
                                        TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══════════════════════════════════════════════════════════════════ -->
                        <!-- FOOTER DINÁMICO: ESTADO DEL SISTEMA Y OPTIMIZACIONES (VARIABLES) -->
                        <!-- ═══════════════════════════════════════════════════════════════════ -->
                        <Border Background="#2A2D31" 
                                CornerRadius="12" 
                                Padding="20" 
                                Margin="0,16,0,0">
                            <StackPanel>

                                <!-- Subtítulos de estado -->
                                <TextBlock Text="Estado del Sistema" 
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#9D8FFF"
                                           Margin="0,0,0,8"/>

                                <!-- Fila 1: Estado del Sistema y Optimización -->
                                <StackPanel Orientation="Horizontal" 
                                            Margin="0,0,0,12">
                                    <!-- Indicador de Estado del Sistema (Icono + Texto) -->
                                    <StackPanel Orientation="Horizontal" 
                                                Margin="0,0,20,0">
                                        <Image Source="pack://application:,,,/Resources/Icons/system_status.png" 
                                               Width="24" Height="24" 
                                               VerticalAlignment="Center"/>

                                        <TextBlock Text="Sistema: Optimizado"
                                                   FontSize="12" 
                                                   Foreground="#B9BBBE" 
                                                   VerticalAlignment="Center"
                                                   Margin="5,0,0,0"/>
                                    </StackPanel>

                                    <!-- Indicador de Estado del Antivirus (Icono + Texto) -->
                                    <StackPanel Orientation="Horizontal" 
                                                Margin="0,0,20,0">
                                        <Image Source="pack://application:,,,/Resources/Icons/antivirus_status.png" 
                                               Width="24" Height="24" 
                                               VerticalAlignment="Center"/>

                                        <TextBlock Text="Antivirus: Activo"
                                                   FontSize="12" 
                                                   Foreground="#B9BBBE" 
                                                   VerticalAlignment="Center"
                                                   Margin="5,0,0,0"/>
                                    </StackPanel>

                                    <!-- Indicador de Conexión a Internet (Icono + Texto) -->
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Resources/Icons/internet_status.png" 
                                               Width="24" Height="24" 
                                               VerticalAlignment="Center"/>

                                        <TextBlock Text="Internet: Conectado"
                                                   FontSize="12" 
                                                   Foreground="#B9BBBE" 
                                                   VerticalAlignment="Center"
                                                   Margin="5,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Fila 2: Acciones Rápidas (Botones) -->
                                <StackPanel Orientation="Horizontal" 
                                            Margin="0,0,0,12"
                                            HorizontalAlignment="Stretch">
                                    <!-- Botón 1: Optimizar Ahora -->
                                    <Button Style="{StaticResource PrimaryButton}"
                                            x:Name="BtnQuickOptimize"
                                            Click="QuickOptimizeButton_Click"
                                            Width="120"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="Optimizar Ahora" 
                                                   FontSize="12" 
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Button>

                                    <!-- Botón 2: Ver Informe de Estado -->
                                    <Button Style="{StaticResource SecondaryButton}"
                                            x:Name="BtnViewStatusReport"
                                            Click="ViewStatusReportButton_Click"
                                            Width="120">
                                        <TextBlock Text="Ver Informe" 
                                                   FontSize="12" 
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Button>
                                </StackPanel>

                                <!-- Mensaje informativo adicional -->
                                <TextBlock Text="ℹ️ Para obtener los mejores resultados, reinicia el sistema después de aplicar optimizaciones."
                                           FontSize="11" Foreground="#A0A0A0"
                                           TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="ProfilesPanel" Margin="0,20,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPageName}" Value="Profiles">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="🎮 Perfiles de Optimización"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="#9D8FFF" Margin="0,0,0,8"/>
                            <TextBlock Text="Guarda y carga combinaciones de tweaks"
                                       FontSize="13" Foreground="#666" Margin="0,0,0,20"/>

                            <Button Content="💾 Guardar Perfil Actual"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,20"
                                    Command="{Binding SaveProfileCommand}"/>

                            <ItemsControl ItemsSource="{Binding SavedProfiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E1E2E" 
                                                CornerRadius="10" 
                                                Padding="16" 
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="#E0E0E0"/>
                                                    <TextBlock FontSize="12" Foreground="#888" Margin="0,4,0,0">
                                                        <Run Text="{Binding TweakCount}"/>
                                                        <Run Text=" tweaks · "/>
                                                        <Run Text="{Binding Created, StringFormat='dd/MM/yyyy'}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="11" Foreground="#666"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" 
                                                        Content="Cargar"
                                                        Margin="0,0,8,0"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Command="{Binding DataContext.LoadProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="2"
                                                        Content="🗑"
                                                        Style="{StaticResource DangerButton}"
                                                        Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Perfiles predefinidos"
                                       FontSize="13" Foreground="#666"
                                       Margin="0,16,0,12"/>
                            <WrapPanel>
                                <Button Content="🎯 Casual (20 tweaks)"  
                                        Style="{StaticResource PresetButton}"
                                        Command="{Binding LoadPresetCommand}"
                                        CommandParameter="Casual"/>
                                <Button Content="⚡ Competitivo (40 tweaks)" 
                                        Style="{StaticResource PresetButton}"
                                        Command="{Binding LoadPresetCommand}"
                                        CommandParameter="Competitivo"/>
                                <Button Content="☠️ Extremo (58 tweaks)"   
                                        Style="{StaticResource PresetButton}"
                                        Command="{Binding LoadPresetCommand}"
                                        CommandParameter="Extremo"/>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel x:Name="HistoryPanel" Margin="0,20,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPageName}" Value="History">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="📋 Historial de Cambios"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="#9D8FFF" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Content="📤 Exportar Log"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0"
                                        Command="{Binding ExportLogCommand}"/>
                                <Button Content="🗑 Limpiar"
                                        Style="{StaticResource DangerButton}"
                                        Command="{Binding ClearHistoryCommand}"/>
                            </StackPanel>

                            <ListView ItemsSource="{Binding RecentHistory}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0,4"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="12,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1A1A2E"/>
                                                    <Setter Property="BorderBrush" Value="#2A2A2A"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Action}" Value="ON">
                                                            <Setter Property="Background" Value="#1F4D2B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Action}" Value="OFF">
                                                            <Setter Property="Background" Value="#4D1F1F"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#2D2B55"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Action}" Value="ON">
                                                                    <Setter Property="Background" Value="#4CAF50"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Action}" Value="OFF">
                                                                    <Setter Property="Background" Value="#F44336"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Action}" 
                                                               FontSize="11" FontWeight="Bold"
                                                               Foreground="#1A1A1A"/>
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding TweakName}"
                                                           FontSize="12" Foreground="#E0E0E0"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Category}"
                                                           FontSize="11" Foreground="#666"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Timestamp, StringFormat='HH:mm · dd/MM'}"
                                                           FontSize="11" Foreground="#555"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <Grid Visibility="Collapsed">
                            <Border x:Name="ActiveTweaksSection" Visibility="Collapsed"/>
                            <TextBlock x:Name="NoTweaksMessage"/>
                            <StackPanel x:Name="ActiveTweaksList"/>
                            <Button x:Name="BtnStartScan"/>
                            <StackPanel x:Name="ScanningState" Visibility="Collapsed"/>
                            <StackPanel x:Name="ResultState" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtScanStatus"/>
                            <TextBlock x:Name="TxtOptimizationScore"/>
                            <TextBlock x:Name="TxtScanSummary"/>
                            <Button x:Name="BtnOptimizeNow"/>
                            <ListView x:Name="StartupItemsList"/>
                            <TextBlock x:Name="TxtNoStartupItems"/>
                            <CheckBox x:Name="ToggleDisableLSO"/>
                            <TextBlock x:Name="TxtDisableLSOStatus"/>
                            <controls:HardwareGraph x:Name="GraphCpu"/>
                            <TextBlock x:Name="TxtCpuLoad"/>
                            <controls:HardwareGraph x:Name="GraphGpu"/>
                            <TextBlock x:Name="TxtGpuLoad"/>
                            <controls:HardwareGraph x:Name="GraphRam"/>
                            <TextBlock x:Name="TxtRamLoad"/>
                            <TextBlock x:Name="TxtCpuTemp"/>
                            <TextBlock x:Name="TxtGpuTemp"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>

