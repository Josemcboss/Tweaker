<Window x:Class="Tweaker.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:resources="clr-namespace:Tweaker.Resources"
xmlns:controls="clr-namespace:Tweaker.Controls"
mc:Ignorable="d"
Title="Ghost Optimizer - Gaming Tweaker" 
Height="938" 
Width="1538"
Background="#0F0F0F"
WindowStartupLocation="CenterScreen"
ResizeMode="CanResize"
WindowStyle="None"
AllowsTransparency="False"
Icon="{StaticResource GhostOptimizerIcon}">

    <Window.Resources>
        <!-- ??????????????????????????????????????????????????????????????? -->
        <!-- ESTILOS MODERNOS (HONE.GG / DISCORD STYLE) -->
        <!-- ??????????????????????????????????????????????????????????????? -->

        <!-- Botón del Sidebar (Menú Lateral) -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B9BBBE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,3,0"
                                BorderBrush="Transparent"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2D31"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Active">
                                <Setter TargetName="border" Property="BorderBrush" Value="#5865F2"/>
                                <Setter Property="Background" Value="#35363C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón ON (verde gaming) -->
        <Style x:Key="OnButton" TargetType="Button">
            <Setter Property="Background" Value="#0E7A0D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#107C10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#11910F"/>
                    <Setter Property="BorderBrush" Value="#13A813"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón OFF (rojo gaming) -->
        <Style x:Key="OffButton" TargetType="Button">
            <Setter Property="Background" Value="#A80000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#C50500"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C50500"/>
                    <Setter Property="BorderBrush" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Título de sección -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Descripción -->
        <Style x:Key="Description" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Title Bar Button Base - MEJORADO -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#404040"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Close Button - MEJORADO (Hover rojo más visible) -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C50500"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón de Categoría del Dashboard -->
        <Style x:Key="DashboardCategoryButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2D31"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#35393F"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#40444B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern RadioButton Style -->
        <Style x:Key="ModernRadioButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" 
                                Background="#2C2F33" 
                                BorderBrush="#5865F2" 
                                BorderThickness="1" 
                                CornerRadius="15"
                                Padding="12,8"
                                Margin="2">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextBlock.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#5865F2"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#7289DA"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#40444B"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#7289DA"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Info Button Style para tooltips de tweaks -->
        <Style x:Key="InfoButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5865F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#5865F2"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Content" Value="?"/>
            <Setter Property="ToolTip" Value="Información detallada del tweak"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5865F2"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#4752C4"/>
                    <Setter Property="BorderBrush" Value="#4752C4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- GLASS & NEON STYLES (MODERNOS) -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->

        <!-- GlassCard Style - Efecto Glass Morphism -->
        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <!-- Gradiente radial sutil desde el centro -->
                    <RadialGradientBrush>
                        <GradientStop Color="#CC1E1E1E" Offset="0"/>
                        <GradientStop Color="#CC151515" Offset="1"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <!-- Gradiente vertical: luz cenital -->
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#404040" Offset="0"/>
                        <GradientStop Color="#101010" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" 
                                    BlurRadius="20" 
                                    ShadowDepth="0" 
                                    Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NeonBorder Style - Efecto Neon Glow en Hover -->
        <Style x:Key="NeonBorder" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" 
                                    BlurRadius="8" 
                                    ShadowDepth="0" 
                                    Opacity="0.3"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#00D9FF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <!-- Neon Glow Effect -->
                            <DropShadowEffect Color="#00D9FF" 
                                            BlurRadius="20" 
                                            ShadowDepth="0" 
                                            Opacity="0.8"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- GlassCardWithHover Style - Combina Glass + Neon -->
        <Style x:Key="GlassCardWithHover" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <RadialGradientBrush>
                        <GradientStop Color="#CC1E1E1E" Offset="0"/>
                        <GradientStop Color="#CC151515" Offset="1"/>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#404040" Offset="0"/>
                        <GradientStop Color="#101010" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" 
                                    BlurRadius="20" 
                                    ShadowDepth="0" 
                                    Opacity="0.4"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#00D9FF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <!-- Neon Glow cuando hover -->
                            <DropShadowEffect Color="#00D9FF" 
                                            BlurRadius="25" 
                                            ShadowDepth="0" 
                                            Opacity="0.7"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- PurpleNeonBorder Style - Variante morada para GHOST Pack -->
        <Style x:Key="PurpleNeonBorder" TargetType="Border" BasedOn="{StaticResource NeonBorder}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#A970FF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#A970FF" 
                                            BlurRadius="20" 
                                            ShadowDepth="0" 
                                            Opacity="0.8"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- RedNeonBorder Style - Variante roja para tweaks peligrosos -->
        <Style x:Key="RedNeonBorder" TargetType="Border" BasedOn="{StaticResource NeonBorder}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#E81123"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#E81123" 
                                            BlurRadius="20" 
                                            ShadowDepth="0" 
                                            Opacity="0.8"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- ROOT GRID -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288*"/>
            <ColumnDefinition Width="123*"/>
            <ColumnDefinition Width="396*"/>
            <ColumnDefinition Width="582*"/>
            <ColumnDefinition Width="149*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <!-- Title Bar -->
            <RowDefinition Height="*"/>
            <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- CUSTOM TITLE BAR - MEJORADO -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" 
                Background="#1A1A1A" 
                BorderThickness="0,0,0,1"
                BorderBrush="#2A2A2A"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Grid.ColumnSpan="5" HorizontalAlignment="Stretch" Height="NaN" Margin="0,0,0,0" VerticalAlignment="Stretch" Width="NaN">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo y Título a la izquierda -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="8,0,0,0">

                    <!-- Logo GHOST OPTIMIZER -->
                    <resources:GhostOptimizerLogo Width="24" Height="24" 
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>

                    <!-- Título principal -->
                    <TextBlock Text="GHOST OPTIMIZER" 
                               FontFamily="Impact, Arial Black"
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#A970FF" 
                                            BlurRadius="6" 
                                            ShadowDepth="0" 
                                            Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Separador -->
                    <Border Width="1" Height="16" 
                            Background="#3A3A3A" 
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"/>

                    <!-- Subtítulo -->
                    <TextBlock Text="Gaming Tweaker" 
                               FontFamily="Segoe UI"
                               FontSize="11" 
                               Foreground="#B9BBBE"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF4500" 
                                            BlurRadius="4" 
                                            ShadowDepth="0" 
                                            Opacity="0.3"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Botones de control a la derecha -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right">


                    <!-- Botón Minimizar -->
                    <Button Style="{StaticResource TitleBarButton}" 
                            Click="MinimizeButton_Click"
                            ToolTip="Minimizar">
                        <Viewbox Width="10" Height="10" 
                                 VerticalAlignment="Center" 
                                 HorizontalAlignment="Center">
                            <Path Data="M 0,0 L 10,0" 
                                  Stroke="White" 
                                  StrokeThickness="1.5"/>
                        </Viewbox>
                    </Button>

                    <!-- Botón Cerrar -->
                    <Button Style="{StaticResource CloseButton}" 
                            Click="CloseButton_Click"
                            ToolTip="Cerrar">
                        <Viewbox Width="10" Height="10" 
                                 VerticalAlignment="Center" 
                                 HorizontalAlignment="Center">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" 
                                  Stroke="White" 
                                  StrokeThickness="1.5"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- CONTENIDO PRINCIPAL (SIDEBAR + PÁGINAS) -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Grid.ColumnSpan="5">
            <Grid.ColumnDefinitions>
                <!-- Columna 0: Sidebar -->
                <ColumnDefinition Width="240"/>
                <!-- Columna 1: Contenido -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═════════════════════════════════════════════════════════════════ -->
            <!-- COLUMNA 0: SIDEBAR (MENÚ LATERAL) -->
            <!-- ═════════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" 
                Background="#1E1E1E" 
                BorderBrush="#2A2A2A" 
                BorderThickness="0,0,1,0">
                <StackPanel>
                    <!-- Header del Sidebar -->
                    <Border Background="#151515" 
                        Padding="20,25"
                        BorderBrush="#2A2A2A"
                        BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe UI Emoji" FontSize="20" FontWeight="Bold" Foreground="#5865F2">
                            <Run Text="&#x26A1;"/>&#x0020;<Run Text="TWEAKER"/>
                            </TextBlock>
                            <TextBlock Text="Gaming Dashboard" 
                                   FontSize="11" 
                                   Foreground="#7F8084"
                                   Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Botones de Navegación -->
                    <StackPanel Margin="0,15,0,0">
                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToDashboard"
                            x:Name="BtnNavDashboard"
                            Tag="Active">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F3E0;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToInput"
                            x:Name="BtnNavInput">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2328;&#xFE0F;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Input &amp; Visuals" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToNetwork"
                            x:Name="BtnNavNetwork">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4E1;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Red &amp; Ping" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToSystem"
                            x:Name="BtnNavSystem">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F3AE;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Sistema &amp; GPU" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToCleanup"
                            x:Name="BtnNavCleanup">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F9F9;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Limpieza" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToStartup"
                            x:Name="BtnNavStartup">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Startup Manager" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToGhost"
                            x:Name="BtnNavGhost">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F47B;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="GHOST Pack" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToAdvanced"
                            x:Name="BtnNavAdvanced">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x26A0;&#xFE0F;" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Advanced" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToAdvancedLatency"
                            x:Name="BtnNavAdvancedLatency">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Latency Tweaks" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToLaptop"
                            x:Name="BtnNavLaptop">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💻" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Preset Laptop" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
                            Click="NavigateToCompetitive"
                            x:Name="BtnNavCompetitive">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏆" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0"/>
                                <TextBlock Text="Competitive Gaming" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}"
