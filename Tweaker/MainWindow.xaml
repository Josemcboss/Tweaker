                          <TextBlock Text="Creado: " Foreground="#7F8084" FontSize="11" />
                          <TextBlock Foreground="#7F8084" FontSize="11" Text="{Binding CreatedDate, StringFormat=d}" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
