<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Tweaker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:resources="clr-namespace:Tweaker.Resources" xmlns:controls="clr-namespace:Tweaker.Controls" Title="Ghost Optimizer - Gaming Tweaker" Height="938" Width="1538" Background="{DynamicResource ThemeBgBrush}" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" WindowStyle="None" AllowsTransparency="False" Icon="{StaticResource GhostOptimizerIcon}" xmlns:tweaker="clr-namespace:Tweaker">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="SidebarButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#B9BBBE" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="20,15" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}" BorderThickness="0,0,3,0" BorderBrush="#00FFFFFF">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#2A2D31" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
                <DataTrigger Value="Active" Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
                  <Setter TargetName="border" Property="Border.BorderBrush" Value="#5865F2" />
                  <Setter Property="Background" Value="#35363C" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="OnButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#0E7A0D" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#107C10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#11910F" />
            <Setter Property="BorderBrush" Value="#13A813" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="OffButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#A80000" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#C50500" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#C50500" />
            <Setter Property="BorderBrush" Value="#E81123" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Margin" Value="0,0,0,10" />
      </Style>
      <Style x:Key="Description" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#A0A0A0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,5" />
      </Style>
      <Style x:Key="TitleBarButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#404040" />
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter Property="Background" Value="#505050" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="CloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource TitleBarButton}">
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#E81123" />
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter Property="Background" Value="#C50500" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="DashboardCategoryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#2A2D31" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="15,10" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="6" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#35393F" />
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter Property="Background" Value="#40444B" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ModernRadioButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <Border Name="Border" Background="#2C2F33" BorderBrush="#5865F2" BorderThickness="1" CornerRadius="15" Padding="12,8" Margin="2">
                <ContentPresenter Content="{TemplateBinding ContentControl.Content}" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="#FFFFFFFF" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="Border" Property="Border.Background" Value="#5865F2" />
                  <Setter TargetName="Border" Property="Border.BorderBrush" Value="#7289DA" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Border.Background" Value="#40444B" />
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="ToggleButton.IsChecked" Value="True" />
                    <Condition Property="UIElement.IsMouseOver" Value="True" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="Border" Property="Border.Background" Value="#7289DA" />
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
      </Style>
      <Style x:Key="InfoButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#5865F2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#5865F2" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Content" Value="?" />
        <Setter Property="FrameworkElement.ToolTip" Value="Información detallada del tweak" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="14">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#5865F2" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter Property="Background" Value="#4752C4" />
            <Setter Property="BorderBrush" Value="#4752C4" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="GlassCard" TargetType="{x:Type Border}">
        <Setter Property="Background">
          <Setter.Value>
            <RadialGradientBrush>
              <GradientStop Color="#CC1E1E1E" Offset="0" />
              <GradientStop Color="#CC151515" Offset="1" />
            </RadialGradientBrush>
          </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
          <Setter.Value>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#404040" Offset="0" />
              <GradientStop Color="#101010" Offset="1" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="12" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.4" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="NeonBorder" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ThemeSidebarBgBrush}" />
        <Setter Property="BorderBrush" Value="#2A2A2A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="0" Opacity="0.3" />
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="UIElement.Effect">
              <Setter.Value>
                <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.8" />
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="GlassCardWithHover" TargetType="{x:Type Border}">
        <Setter Property="Background">
          <Setter.Value>
            <RadialGradientBrush>
              <GradientStop Color="#CC1E1E1E" Offset="0" />
              <GradientStop Color="#CC151515" Offset="1" />
            </RadialGradientBrush>
          </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
          <Setter.Value>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#404040" Offset="0" />
              <GradientStop Color="#101010" Offset="1" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="12" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.4" />
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="UIElement.Effect">
              <Setter.Value>
                <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="25" ShadowDepth="0" Opacity="0.7" />
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="PurpleNeonBorder" TargetType="{x:Type Border}" BasedOn="{StaticResource NeonBorder}">
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="BorderBrush" Value="#A970FF" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="UIElement.Effect">
              <Setter.Value>
                <DropShadowEffect Color="#A970FF" BlurRadius="20" ShadowDepth="0" Opacity="0.8" />
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="RedNeonBorder" TargetType="{x:Type Border}" BasedOn="{StaticResource NeonBorder}">
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="BorderBrush" Value="#E81123" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="UIElement.Effect">
              <Setter.Value>
                <DropShadowEffect Color="#E81123" BlurRadius="20" ShadowDepth="0" Opacity="0.8" />
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="288*" />
      <ColumnDefinition Width="123*" />
      <ColumnDefinition Width="396*" />
      <ColumnDefinition Width="582*" />
      <ColumnDefinition Width="149*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBgBrush}" BorderThickness="0,0,0,1" BorderBrush="#2A2A2A" Grid.ColumnSpan="5" HorizontalAlignment="Stretch" Height="NaN" Margin="0,0,0,0" VerticalAlignment="Stretch" Width="NaN" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
          <resources:GhostOptimizerLogo Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Text="GHOST OPTIMIZER" FontFamily="Impact, Arial Black" FontSize="14" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0">
            <UIElement.Effect>
              <DropShadowEffect Color="#A970FF" BlurRadius="6" ShadowDepth="0" Opacity="0.5" />
            </UIElement.Effect>
          </TextBlock>
          <Border Width="1" Height="16" Background="#3A3A3A" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Text="Gaming Tweaker" FontFamily="Segoe UI" FontSize="11" Foreground="#B9BBBE" VerticalAlignment="Center">
            <UIElement.Effect>
              <DropShadowEffect Color="#FF4500" BlurRadius="4" ShadowDepth="0" Opacity="0.3" />
            </UIElement.Effect>
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource TitleBarButton}" ToolTip="Cambiar Idioma / Change Language" Width="40" Click="LanguageButton_Click">
            <TextBlock Text="🌐" FontFamily="Segoe UI Emoji" FontSize="14" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button Style="{StaticResource TitleBarButton}" ToolTip="Cambiar Tema / Change Theme" Width="40" Click="ThemeButton_Click">
            <TextBlock Text="🎨" FontFamily="Segoe UI Emoji" FontSize="14" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
          <Button Style="{StaticResource TitleBarButton}" ToolTip="Minimizar" Click="MinimizeButton_Click">
            <Viewbox Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Path Data="M0,0 L10,0" Stroke="#FFFFFFFF" StrokeThickness="1.5" />
            </Viewbox>
          </Button>
          <Button Style="{StaticResource CloseButton}" ToolTip="Cerrar" Click="CloseButton_Click">
            <Viewbox Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#FFFFFFFF" StrokeThickness="1.5" />
            </Viewbox>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Row="1" ColumnSpan="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource ThemeSidebarBgBrush}" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0">
        <StackPanel>
          <Border Background="{DynamicResource ThemeHeaderBgBrush}" Padding="20,25" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <StackPanel>
              <TextBlock FontFamily="Segoe UI Emoji" FontSize="20" FontWeight="Bold" Foreground="#5865F2">
                <Run Text="⚡" /> <Run Text="TWEAKER" /></TextBlock>
              <TextBlock Text="Gaming Dashboard" FontSize="11" Foreground="#7F8084" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
          <StackPanel Margin="0,15,0,0">
            <Button Name="BtnNavDashboard" Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Tag="{Binding CurrentPageName, Converter={StaticResource PageNameToTagConverter}, ConverterParameter=Dashboard}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏠" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0" />
                <TextBlock Text="Dashboard" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="BtnNavInput" Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="Input" Tag="{Binding CurrentPageName, Converter={StaticResource PageNameToTagConverter}, ConverterParameter='Input &amp; Visuals'}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="⌨️" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0" />
                <TextBlock Text="Input &amp; Visuals" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="BtnNavNetwork" Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="Network" Tag="{Binding CurrentPageName, Converter={StaticResource PageNameToTagConverter}, ConverterParameter='Red &amp; Ping'}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="📡" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0" />
                <TextBlock Text="Red &amp; Ping" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="BtnNavSystem" Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="System" Tag="{Binding CurrentPageName, Converter={StaticResource PageNameToTagConverter}, ConverterParameter='Sistema &amp; GPU'}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎮" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0" />
                <TextBlock Text="Sistema &amp; GPU" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="BtnNavGhost" Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="Ghost" Tag="{Binding CurrentPageName, Converter={StaticResource PageNameToTagConverter}, ConverterParameter='GHOST Pack'}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="👻" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0" />
                <TextBlock Text="GHOST Pack" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="BtnNavPresets" Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="Presets" Tag="{Binding CurrentPageName, Converter={StaticResource PageNameToTagConverter}, ConverterParameter='Presets Gaming'}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎯" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0" />
                <TextBlock Text="Presets Gaming" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="BtnNavCleanup" Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="Cleanup" Tag="{Binding CurrentPageName, Converter={StaticResource PageNameToTagConverter}, ConverterParameter=Limpieza}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🧹" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0" />
                <TextBlock Text="Limpieza &amp; Debloat" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="BtnNavProfiles" Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="Profiles" Tag="{Binding CurrentPageName, Converter={StaticResource PageNameToTagConverter}, ConverterParameter=Profiles}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="📁" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0" />
                <TextBlock Text="Perfiles" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="BtnNavHistory" Style="{StaticResource SidebarButton}" Command="{Binding NavigateCommand}" CommandParameter="History" Tag="{Binding CurrentPageName, Converter={StaticResource PageNameToTagConverter}, ConverterParameter=History}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="📜" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0" />
                <TextBlock Text="Historial" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Border Background="{DynamicResource ThemeHeaderBgBrush}" Padding="15" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" VerticalAlignment="Bottom" Margin="0,180,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <resources:GhostOptimizerLogo Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="GHOST OPTIMIZER" FontFamily="Impact, Arial Black" FontSize="10" FontWeight="Bold" Foreground="#A970FF" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock FontFamily="Segoe UI Emoji" FontSize="10" Foreground="#FFC107" FontWeight="SemiBold" Margin="0,0,0,5">
                <Run Text="⚠️" /> <Run Text="Ejecutar como Admin" /></TextBlock>
              <TextBlock Text="v2.0 - DaddyGhost Edition" FontSize="9" Foreground="#5F5F5F" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
      <Grid Column="1" Background="{DynamicResource ThemeBgBrush}">
        <ScrollViewer Name="DashboardPage" Visibility="{Binding CurrentPageName, Converter={StaticResource PageNameToVisibilityConverter}, ConverterParameter=Dashboard}" VerticalScrollBarVisibility="Auto">
          <UIElement.RenderTransform>
            <TranslateTransform />
          </UIElement.RenderTransform>

          <Grid Margin="30,25,30,25">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.35*" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Row 0: Header -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                  <resources:GhostOptimizerLogo Width="60" Height="60" Margin="0,0,20,0" VerticalAlignment="Center" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock FontFamily="Impact, Arial Black" FontSize="32" FontWeight="Bold" Foreground="#FFFFFFFF">
                      <Run Text="GHOST OPTIMIZER" />
                      <UIElement.Effect>
                        <DropShadowEffect Color="#A970FF" BlurRadius="8" ShadowDepth="0" Opacity="0.6" />
                      </UIElement.Effect>
                    </TextBlock>
                    <TextBlock FontFamily="Segoe UI" FontSize="16" Foreground="#B9BBBE" Margin="0,5,0,0">
                      <Run Text="Gaming Performance Dashboard" />
                    </TextBlock>
                  </StackPanel>
                </StackPanel>
                <TextBlock Text="Optimizador Gaming Profesional" FontSize="14" Foreground="#A0A0A0" Margin="0,0,0,10" />
              </StackPanel>

              <!-- System Info Button -->
              <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding OpenSystemInfoCommand}" Style="{StaticResource OnButton}" Background="#1D1515" BorderBrush="#2D1D1D" Padding="15,10" Cursor="Hand" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M13,17 H11 V11 H13 V17 Z M13,9 H11 V7 H13 V9 Z" Fill="#FFA0A0" Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform"/>
                  <TextBlock Text="System Info" FontWeight="Bold" VerticalAlignment="Center" Foreground="#FFFFFFFF"/>
                </StackPanel>
              </Button>
            </Grid>

            <!-- Row 1: Circular Telemetry Gauges (Side-by-Side) -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,25">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- CPU Usage Gauge -->
              <controls:CircularGauge Grid.Column="0" Title="CPU Usage" 
                                      Value="{Binding HardwareMonitor.CpuLoadPercent}" 
                                      Temperature="{Binding HardwareMonitor.CpuTemperature}"
                                      Command="{Binding OpenSystemInfoCommand}"
                                      IconData="M4,4 H20 V20 H4 Z M8,8 H16 V16 H8 Z M2,7 H4 M2,12 H4 M2,17 H4 M20,7 H22 M20,12 H22 M20,17 H22 M7,2 V4 M12,2 V4 M17,2 V4 M7,20 V22 M12,20 V22 M17,20 V22">
                <controls:CircularGauge.StrokeBrush>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF3B30" Offset="0.0"/>
                    <GradientStop Color="#FF453A" Offset="1.0"/>
                  </LinearGradientBrush>
                </controls:CircularGauge.StrokeBrush>
              </controls:CircularGauge>

              <!-- GPU Usage Gauge -->
              <controls:CircularGauge Grid.Column="2" Title="GPU Usage" 
                                      Value="{Binding HardwareMonitor.GpuLoadPercent}" 
                                      Temperature="{Binding HardwareMonitor.GpuTemperature}"
                                      Command="{Binding OpenSystemInfoCommand}"
                                      IconData="M2,4 H22 V16 H2 Z M6,16 V20 M18,16 V20 M2,10 H22 M6,7 A1.5,1.5 0 1 0 6,10 A1.5,1.5 0 1 0 6,7 M18,7 A1.5,1.5 0 1 0 18,10 A1.5,1.5 0 1 0 18,7">
                <controls:CircularGauge.StrokeBrush>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF3B30" Offset="0.0"/>
                    <GradientStop Color="#FF9500" Offset="1.0"/>
                  </LinearGradientBrush>
                </controls:CircularGauge.StrokeBrush>
              </controls:CircularGauge>

              <!-- RAM Usage Gauge -->
              <controls:CircularGauge Grid.Column="4" Title="RAM Usage" 
                                      Value="{Binding HardwareMonitor.RamUsagePercent}" 
                                      Command="{Binding OpenSystemInfoCommand}"
                                      IconData="M2,8 H22 V14 H2 Z M4,14 V16 M8,14 V16 M12,14 V16 M16,14 V16 M20,14 V16 M5,10 H7 V12 H5 Z M9,10 H11 V12 H9 Z M13,10 H15 V12 H13 Z M17,10 H19 V12 H17 Z">
                <controls:CircularGauge.StrokeBrush>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF9500" Offset="0.0"/>
                    <GradientStop Color="#FFCC00" Offset="1.0"/>
                  </LinearGradientBrush>
                </controls:CircularGauge.StrokeBrush>
              </controls:CircularGauge>
            </Grid>

            <!-- Row 2, Column 0: Left Column (Main controls & tweaks) -->
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,15,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{DynamicResource NeonGlowCard}" Padding="20" Margin="0,0,8,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Name="TxtActiveTweaks" Text="0" FontSize="32" FontWeight="Bold" Foreground="#5865F2" />
                    <TextBlock Text="/" FontSize="20" FontWeight="Bold" Foreground="#7F8084" Margin="5,8,0,0" />
                    <TextBlock Name="TxtTotalTweaks" Text="61" FontSize="20" FontWeight="Bold" Foreground="#7F8084" Margin="0,8,0,0" />
                  </StackPanel>
                  <TextBlock Text="Tweaks Activos" FontSize="12" Foreground="#A0A0A0" />
                  <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Name="TxtOptimizationPercent" Text="0%" FontSize="10" Foreground="#0E7A0D" FontWeight="SemiBold" />
                    <TextBlock Text=" optimizado" FontSize="10" Foreground="#7F8084" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{DynamicResource NeonGlowCard}" Padding="20" Margin="4,0">
                <StackPanel>
                  <TextBlock Name="TxtEstimatedFps" Text="+0" FontSize="32" FontWeight="Bold" Foreground="#0E7A0D" />
                  <TextBlock Text="FPS Estimados" FontSize="12" Foreground="#A0A0A0" />
                  <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="🎯 " FontFamily="Segoe UI Emoji" FontSize="10" />
                    <TextBlock Name="TxtLatencyReduction" Text="-0ms ping" FontSize="10" Foreground="#7F8084" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{DynamicResource NeonGlowCard}" Padding="20" Margin="8,0,0,0">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Name="TxtRamFreed" Text="0.0" FontSize="32" FontWeight="Bold" Foreground="#9B59B6" />
                    <TextBlock Text=" GB" FontSize="18" FontWeight="Bold" Foreground="#7F8084" Margin="3,10,0,0" />
                  </StackPanel>
                  <TextBlock Text="RAM Liberada" FontSize="12" Foreground="#A0A0A0" />
                  <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="💾 " FontFamily="Segoe UI Emoji" FontSize="10" />
                    <TextBlock Text="Memoria optimizada" FontSize="10" Foreground="#7F8084" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{DynamicResource NeonGlowCard}" Padding="25" Margin="0,0,0,20" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock FontFamily="Segoe UI Emoji" FontSize="18" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,5">
                    <Run Text="🔍" /> <Run Text="Smart Scan &amp; Optimization" /></TextBlock>
                  <TextBlock Text="Analiza tu sistema en busca de optimizaciones pendientes y mejora tu rendimiento con un clic." Foreground="#A0A0A0" Margin="0,0,0,15" />
                  <StackPanel Name="ScanningState" Margin="0,0,0,10" Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Name="ScanProgressBar" Height="10" Background="#1A1A1A" Foreground="#5865F2" IsIndeterminate="True" Margin="0,0,0,10" />
                    <TextBlock Name="TxtScanStatus" Text="Analizando servicios y registro..." Foreground="#B9BBBE" FontSize="12" />
                  </StackPanel>
                  <StackPanel Name="ResultState" Margin="0,0,0,10" Visibility="{Binding ShowScanResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <TextBlock Text="Puntaje de Optimización: " Foreground="#FFFFFFFF" FontSize="16" VerticalAlignment="Center" />
                      <TextBlock Name="TxtOptimizationScore" Foreground="#0E7A0D" FontSize="24" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding ScanScore, StringFormat={}{0}%}" />
                    </StackPanel>
                    <TextBlock Name="TxtScanSummary" Foreground="#B9BBBE" Margin="0,0,0,15" Text="{Binding ScanSummary}" />
                    <Button Name="BtnOptimizeNow" Content="OPTIMIZAR AHORA" Style="{StaticResource OnButton}" Padding="20,10" HorizontalAlignment="Left" Visibility="{Binding ShowOptimizeButton, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding OptimizeNowCommand}" />
                  </StackPanel>
                </StackPanel>
                <Button Name="BtnStartScan" Grid.Column="1" Style="{StaticResource OnButton}" Background="#5865F2" BorderBrush="#4752C4" VerticalAlignment="Center" Padding="25,15" Command="{Binding StartScanCommand}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" FontFamily="Segoe UI Emoji" Margin="0,0,10,0" />
                    <TextBlock Text="ANALIZAR PC" FontWeight="Bold" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <Border Background="#1A1D21" CornerRadius="8" Padding="25" Margin="0,0,0,20" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,15">
                  <Run Text="🔧" /> <Run Text="AUTO-MAINTENANCE" /></TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12" Foreground="#B9BBBE" TextWrapping="Wrap" Margin="0,0,20,12">Limpieza automática de temporales, flush de RAM cuando supera el 85%, y compactación de logs. Se ejecuta cada 30 minutos cuando el sistema está inactivo.</TextBlock>
                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                  <CheckBox Name="ChkAutoMaintenance" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Center" IsChecked="{Binding AutoMaintenance.IsEnabled, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,12">
                  <Border Background="#2A2D31" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                    <TextBlock FontSize="11" Foreground="#B9BBBE">
                      <Run Text="📦 Liberados:" /> <Run FontWeight="Bold" Foreground="#FFFFFFFF" Text="{Binding AutoMaintenance.TotalMBFreed, Mode=OneWay}" /> <Run Text="MB" /></TextBlock>
                  </Border>
                  <Border Background="#2A2D31" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                    <TextBlock FontSize="11" Foreground="#B9BBBE">
                      <Run Text="🗑️ Archivos:" /> <Run FontWeight="Bold" Foreground="#FFFFFFFF" Text="{Binding AutoMaintenance.TotalFilesDeleted, Mode=OneWay}" /></TextBlock>
                  </Border>
                  <Border Background="#2A2D31" CornerRadius="6" Padding="12,6" Margin="0,0,10,0">
                    <TextBlock FontSize="11" Foreground="#B9BBBE">
                      <Run Text="🕐 Última:" /> <Run FontWeight="Bold" Foreground="#FFFFFFFF" Text="{Binding AutoMaintenance.LastCleanupTimeText, Mode=OneWay}" /></TextBlock>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal">
                  <Button Content="⚡ EJECUTAR AHORA" Style="{StaticResource OnButton}" Padding="20,10" Margin="0,0,15,0" Command="{Binding RunMaintenanceNowCommand}" />
                  <TextBlock FontSize="12" Foreground="#B9BBBE" VerticalAlignment="Center" Text="{Binding MaintenanceStatusText}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Background="#1A1D21" CornerRadius="8" Padding="25" Margin="0,0,0,20" BorderBrush="#4ECDC4" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,10">
                    <Run Text="🎮" /> <Run Text="GAME MODE DETECTOR" /></TextBlock>
                  <TextBlock FontSize="12" Foreground="#B9BBBE" TextWrapping="Wrap" Margin="0,0,0,8">Detecta automáticamente juegos en ejecución y aplica optimizaciones de prioridad CPU, suspensión de Windows Update, y limpieza de RAM en tiempo real.</TextBlock>
                  <TextBlock FontSize="12" Foreground="#4ECDC4">
                    <Run Text="Estado:" /> <Run FontWeight="Bold" Text="{Binding CurrentStatus}" /></TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="🎮" FontFamily="Segoe UI Emoji" FontSize="42" HorizontalAlignment="Center" Margin="20,0,0,0" />
                  <TextBlock FontSize="10" Foreground="#4ECDC4" HorizontalAlignment="Center" Margin="20,4,0,0" Visibility="Collapsed" Text="{Binding IsGameModeActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{DynamicResource NeonGlowCard}" Padding="25" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock FontFamily="Segoe UI Emoji" FontSize="18" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,15">
                  <Run Text="⚡" /> <Run Text="Acciones Rápidas" /></TextBlock>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Style="{StaticResource OnButton}" Padding="20,12" Click="CreateRestorePoint">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="🛡️" FontFamily="Segoe UI Emoji" Margin="0,0,8,0" />
                      <TextBlock Text="Crear Punto de Restauración" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2" Style="{StaticResource OnButton}" Background="#5865F2" BorderBrush="#4752C4" Padding="20,12" Click="OpenSystemRestore">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="🔄" FontFamily="Segoe UI Emoji" Margin="0,0,8,0" />
                      <TextBlock Text="Abrir Restauración del Sistema" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="4" Style="{StaticResource OnButton}" Background="#E81123" BorderBrush="#C42B1C" Padding="20,12" Click="RevertAllTweaks">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="🔄" FontFamily="Segoe UI Emoji" Margin="0,0,8,0" />
                      <TextBlock Text="REVERTIR TODOS LOS TWEAKS" FontWeight="Bold" />
                    </StackPanel>
                  </Button>
                </Grid>
                <TextBlock Text="Categorías Populares:" FontSize="14" Foreground="#A0A0A0" Margin="0,15,0,10" />
                <WrapPanel>
                  <Button Style="{StaticResource DashboardCategoryButton}" Command="{Binding NavigateCommand}" CommandParameter="Network">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="📡" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Text="Red &amp; Ping" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource DashboardCategoryButton}" Command="{Binding NavigateCommand}" CommandParameter="Ghost">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="👻" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Text="GHOST Pack" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource DashboardCategoryButton}" Command="{Binding NavigateCommand}" CommandParameter="Input">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="⌨️" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Text="Input &amp; Visuals" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Name="ActiveTweaksSection" Style="{DynamicResource NeonGlowCard}" Padding="25" Margin="0,0,0,20" Visibility="Collapsed">
              <StackPanel>
                <TextBlock FontFamily="Segoe UI Emoji" FontSize="18" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,15">
                  <Run Text="✅" /> <Run Text="Tweaks Activos" /></TextBlock>
                <StackPanel Name="ActiveTweaksList" />
                <TextBlock Name="NoTweaksMessage" Text="No hay tweaks activos. Comienza activando optimizaciones desde las categorías del menú." TextWrapping="Wrap" Foreground="#7F8084" FontStyle="Italic" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
            </StackPanel>

            <!-- Row 2, Column 1: Right Column (Telemetry & Performance stats) -->
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="15,0,0,0">
              <!-- System Corruption Check Card -->
              <Border Style="{DynamicResource NeonGlowCard}" Margin="0,0,0,20" Padding="20">
                <StackPanel>
                  <StackPanel.Resources>
                    <!-- Style for Pending Dot -->
                    <Style x:Key="PendingDotStyle" TargetType="Ellipse">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=Tag}" Value="Running">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=Tag}" Value="Success">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=Tag}" Value="Failed">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>

                    <!-- Style for Running Spinner -->
                    <Style x:Key="RunningDotStyle" TargetType="Ellipse">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=Tag}" Value="Running">
                          <Setter Property="Visibility" Value="Visible"/>
                          <DataTrigger.EnterActions>
                            <BeginStoryboard Name="RotateSpinner">
                              <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.5"/>
                              </Storyboard>
                            </BeginStoryboard>
                          </DataTrigger.EnterActions>
                          <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="RotateSpinner"/>
                          </DataTrigger.ExitActions>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>

                    <!-- Style for Success Path -->
                    <Style x:Key="SuccessCheckStyle" TargetType="Path">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=Tag}" Value="Success">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>

                    <!-- Style for Failed Path -->
                    <Style x:Key="FailedCrossStyle" TargetType="Path">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=Tag}" Value="Failed">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Resources>

                  <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" Background="#1D1515" CornerRadius="8" BorderBrush="#2D1D1D" BorderThickness="1" Margin="0,0,15,0">
                      <!-- Dial / gauge style icon -->
                      <Path Data="M12,2A10,10,0,0,0,2,12A10,10,0,0,0,12,22A10,10,0,0,0,22,12A10,10,0,0,0,12,2M12,4A8,8,0,0,1,20,12A8,8,0,0,1,12,20A8,8,0,0,1,4,12A8,8,0,0,1,12,4M12,6A6,6,0,0,0,6,12A6,6,0,0,0,12,18A6,6,0,0,0,18,12A6,6,0,0,0,12,6M12,8V12H16" Fill="#FFA0A0" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="System Corruption Check" FontWeight="Bold" Foreground="#FFFFFFFF" FontSize="16" />
                      <TextBlock Text="Scan and repair Windows system files" Foreground="#808080" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>

                  <TextBlock Text="Runs a comprehensive system check including ChkDsk, SFC (System File Checker), and DISM to detect and repair corrupted Windows system files." 
                             TextWrapping="Wrap" Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,20" LineHeight="18" />

                  <!-- Check Steps -->
                  <StackPanel Margin="5,0,0,20">
                    <!-- Step 1: ChkDsk -->
                    <Grid Margin="0,0,0,12" Tag="{Binding ChkDskStatus}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <!-- Status Icon -->
                      <Grid Grid.Column="0" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource PendingDotStyle}" Stroke="#404040" StrokeThickness="1.5" Fill="Transparent"/>
                        <Ellipse Style="{StaticResource RunningDotStyle}" Stroke="#FFC107" StrokeThickness="1.5" Fill="Transparent" StrokeDashArray="3 1" RenderTransformOrigin="0.5,0.5">
                          <Ellipse.RenderTransform>
                            <RotateTransform Angle="0"/>
                          </Ellipse.RenderTransform>
                        </Ellipse>
                        <Path Style="{StaticResource SuccessCheckStyle}" Data="M3,8 L6,11 L13,4" Stroke="#4CAF50" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        <Path Style="{StaticResource FailedCrossStyle}" Data="M3,3 L13,13 M13,3 L3,13" Stroke="#E81123" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                      </Grid>
                      <TextBlock Grid.Column="1" Text="Disk corruption scan (ChkDsk)" Foreground="#FFFFFFFF" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Step 2: SFC -->
                    <Grid Margin="0,0,0,12" Tag="{Binding SfcStatus}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid Grid.Column="0" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource PendingDotStyle}" Stroke="#404040" StrokeThickness="1.5" Fill="Transparent"/>
                        <Ellipse Style="{StaticResource RunningDotStyle}" Stroke="#FFC107" StrokeThickness="1.5" Fill="Transparent" StrokeDashArray="3 1" RenderTransformOrigin="0.5,0.5">
                          <Ellipse.RenderTransform>
                            <RotateTransform Angle="0"/>
                          </Ellipse.RenderTransform>
                        </Ellipse>
                        <Path Style="{StaticResource SuccessCheckStyle}" Data="M3,8 L6,11 L13,4" Stroke="#4CAF50" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        <Path Style="{StaticResource FailedCrossStyle}" Data="M3,3 L13,13 M13,3 L3,13" Stroke="#E81123" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                      </Grid>
                      <TextBlock Grid.Column="1" Text="System file verification (SFC)" Foreground="#FFFFFFFF" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Step 3: DISM -->
                    <Grid Tag="{Binding DismStatus}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid Grid.Column="0" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource PendingDotStyle}" Stroke="#404040" StrokeThickness="1.5" Fill="Transparent"/>
                        <Ellipse Style="{StaticResource RunningDotStyle}" Stroke="#FFC107" StrokeThickness="1.5" Fill="Transparent" StrokeDashArray="3 1" RenderTransformOrigin="0.5,0.5">
                          <Ellipse.RenderTransform>
                            <RotateTransform Angle="0"/>
                          </Ellipse.RenderTransform>
                        </Ellipse>
