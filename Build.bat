@echo off
:: ???????????????????????????????????????????????????????????????????
:: GHOST OPTIMIZER - BUILD & PUBLISH SCRIPT
:: ???????????????????????????????????????????????????????????????????
:: Este script compila y publica Ghost Optimizer para distribucion
:: Version: 2.0.0
:: ???????????????????????????????????????????????????????????????????

echo.
echo ?????????????????????????????????????????????????????????????????
echo ?         GHOST OPTIMIZER - BUILD ^& PUBLISH SCRIPT             ?
echo ?                    Version 2.0.0                             ?
echo ?????????????????????????????????????????????????????????????????
echo.

:: Verificar que estamos en el directorio correcto
if not exist "Tweaker\Tweaker.csproj" (
    echo ? ERROR: No se encuentra Tweaker.csproj
    echo    Ejecuta este script desde la raíz de la solución
    pause
    exit /b 1
)

:: Configuración
set PROJECT_PATH=Tweaker\Tweaker.csproj
set OUTPUT_DIR=Release\Published
set VERSION=2.0.0

echo ???????????????????????????????????????????????????????????????
echo PASO 1: LIMPIAR COMPILACIONES ANTERIORES
echo ???????????????????????????????????????????????????????????????
echo.

if exist "%OUTPUT_DIR%" (
    echo ??? Eliminando carpeta anterior: %OUTPUT_DIR%
    rmdir /s /q "%OUTPUT_DIR%"
)

if exist "Tweaker\bin\Release" (
    echo ??? Limpiando carpeta bin\Release
    rmdir /s /q "Tweaker\bin\Release"
)

if exist "Tweaker\obj" (
    echo ??? Limpiando carpeta obj
    rmdir /s /q "Tweaker\obj"
)

echo ? Limpieza completada
echo.

:: ???????????????????????????????????????????????????????????????????
:: PASO 2: RESTAURAR PAQUETES NUGET
:: ???????????????????????????????????????????????????????????????????

echo ???????????????????????????????????????????????????????????????
echo PASO 2: RESTAURAR PAQUETES NUGET
echo ???????????????????????????????????????????????????????????????
echo.

dotnet restore "%PROJECT_PATH%"

if %ERRORLEVEL% NEQ 0 (
    echo ? ERROR: Falló la restauración de paquetes
    pause
    exit /b 1
)

echo ? Paquetes restaurados correctamente
echo.

:: ???????????????????????????????????????????????????????????????????
:: PASO 3: BUILD RELEASE CONFIGURATION
:: ???????????????????????????????????????????????????????????????????

echo ???????????????????????????????????????????????????????????????
echo PASO 3: BUILD RELEASE CONFIGURATION
echo ???????????????????????????????????????????????????????????????
echo.

dotnet build "%PROJECT_PATH%" ^
    --configuration Release ^
    --verbosity minimal

if %ERRORLEVEL% NEQ 0 (
    echo ? ERROR: Falló la compilación
    pause
    exit /b 1
)

echo ? Compilación exitosa
echo.

:: ???????????????????????????????????????????????????????????????????
:: PASO 4: PUBLICAR APLICACIÓN (Single-File EXE)
:: ???????????????????????????????????????????????????????????????????

echo ???????????????????????????????????????????????????????????????
echo PASO 4: PUBLICAR APLICACIÓN (Single-File EXE)
echo ???????????????????????????????????????????????????????????????
echo.

echo Configuración de publicación:
echo   ? Single-File: SÍ
echo   ? Self-Contained: SÍ
echo   ? Runtime: win-x64
echo   ? ReadyToRun: SÍ (mejor rendimiento)
echo   ? Compresión: SÍ
echo.

dotnet publish "%PROJECT_PATH%" ^
    --configuration Release ^
    --runtime win-x64 ^
    --self-contained true ^
    --output "%OUTPUT_DIR%" ^
    /p:PublishSingleFile=true ^
    /p:IncludeNativeLibrariesForSelfExtract=true ^
    /p:EnableCompressionInSingleFile=true ^
    /p:PublishReadyToRun=true ^
    /p:DebugType=None ^
    /p:DebugSymbols=false

if %ERRORLEVEL% NEQ 0 (
    echo ? ERROR: Falló la publicación
    pause
    exit /b 1
)

echo ? Publicación exitosa
echo.

:: ???????????????????????????????????????????????????????????????????
:: PASO 5: COPIAR ARCHIVOS ADICIONALES
:: ???????????????????????????????????????????????????????????????????

echo ???????????????????????????????????????????????????????????????
echo PASO 5: COPIAR ARCHIVOS ADICIONALES
echo ???????????????????????????????????????????????????????????????
echo.

:: Crear carpeta Docs
if not exist "%OUTPUT_DIR%\Docs" mkdir "%OUTPUT_DIR%\Docs"

:: Copiar documentación
echo ?? Copiando documentación...
if exist "Release\SISTEMA_SEGURIDAD_IMPLEMENTADO.md" (
    copy "Release\SISTEMA_SEGURIDAD_IMPLEMENTADO.md" "%OUTPUT_DIR%\Docs\" >nul 2>&1
)
if exist "Release\DASHBOARD_ACTUALIZADO_58_TWEAKS.md" (
    copy "Release\DASHBOARD_ACTUALIZADO_58_TWEAKS.md" "%OUTPUT_DIR%\Docs\" >nul 2>&1
)
if exist "Release\ADVANCED_TWEAKS_IMPLEMENTATION.md" (
    copy "Release\ADVANCED_TWEAKS_IMPLEMENTATION.md" "%OUTPUT_DIR%\Docs\" >nul 2>&1
)

:: Copiar README si existe
if exist "README.md" (
    copy "README.md" "%OUTPUT_DIR%\" >nul 2>&1
)

:: Copiar LICENSE si existe
if exist "LICENSE" (
    copy "LICENSE" "%OUTPUT_DIR%\" >nul 2>&1
)

echo ? Archivos adicionales copiados
echo.

:: ???????????????????????????????????????????????????????????????????
:: PASO 6: GENERAR INFORMACIÓN DE LA BUILD
:: ???????????????????????????????????????????????????????????????????

echo ???????????????????????????????????????????????????????????????
echo PASO 6: GENERAR INFORMACIÓN DE LA BUILD
echo ???????????????????????????????????????????????????????????????
echo.

:: Obtener información del EXE
for %%F in ("%OUTPUT_DIR%\Tweaker.exe") do set EXE_SIZE=%%~zF
set /a EXE_SIZE_MB=%EXE_SIZE% / 1048576

:: Crear archivo BUILD_INFO.txt
(
    echo ???????????????????????????????????????????????????????????????
    echo GHOST OPTIMIZER - BUILD INFORMATION
    echo ???????????????????????????????????????????????????????????????
    echo.
    echo VERSION:        %VERSION%
    echo BUILD DATE:     %DATE% %TIME%
    echo BUILD TYPE:     Release
    echo TARGET:         Windows x64
    echo .NET VERSION:   .NET 10.0
    echo.
    echo EXECUTABLE:     Tweaker.exe
    echo FILE SIZE:      %EXE_SIZE_MB% MB
    echo SINGLE FILE:    Yes
    echo SELF-CONTAINED: Yes
    echo READY TO RUN:   Yes
    echo COMPRESSED:     Yes
    echo.
    echo ???????????????????????????????????????????????????????????????
    echo CHARACTERISTICS
    echo ???????????????????????????????????????????????????????????????
    echo.
    echo ? Single executable file ^(no external dependencies^)
    echo ? Self-contained runtime ^(.NET 10 included^)
    echo ? Optimized for performance ^(ReadyToRun^)
    echo ? Compressed for smaller size
    echo ? Administrator privileges required
    echo.
    echo ???????????????????????????????????????????????????????????????
    echo FEATURES
    echo ???????????????????????????????????????????????????????????????
    echo.
    echo ??? ServiceGuard: Protección de servicios críticos
    echo ?? OptimizationBackup: Backup automático de cambios
    echo ? Validación de comandos BCD
    echo ?? Script de Rescate automático
    echo ?? 58 tweaks de optimización disponibles
    echo.
    echo ???????????????????????????????????????????????????????????????
    echo INSTALLATION
    echo ???????????????????????????????????????????????????????????????
    echo.
    echo 1. Ejecutar Tweaker.exe COMO ADMINISTRADOR
    echo 2. Seguir instrucciones del Dashboard
    echo 3. Crear punto de restauración recomendado
    echo 4. Aplicar optimizaciones deseadas
    echo 5. Reiniciar si es necesario
    echo.
    echo ???????????????????????????????????????????????????????????????
) > "%OUTPUT_DIR%\BUILD_INFO.txt"

echo ? Información de build generada
echo.

:: ???????????????????????????????????????????????????????????????????
:: PASO 7: RESUMEN FINAL
:: ???????????????????????????????????????????????????????????????????

echo.
echo ?????????????????????????????????????????????????????????????????
echo ?                   ? BUILD COMPLETADO                        ?
echo ?????????????????????????????????????????????????????????????????
echo.
echo ?? ARCHIVOS GENERADOS:
echo    Ubicación: %OUTPUT_DIR%
echo.
echo ?? ARCHIVO PRINCIPAL:
echo    ?? Tweaker.exe (%EXE_SIZE_MB% MB)
echo    ?? BUILD_INFO.txt
echo.
echo ?? DOCUMENTACIÓN:
echo    ?? Docs\
echo       ?? SISTEMA_SEGURIDAD_IMPLEMENTADO.md
echo       ?? DASHBOARD_ACTUALIZADO_58_TWEAKS.md
echo       ?? ADVANCED_TWEAKS_IMPLEMENTATION.md
echo.
echo ???????????????????????????????????????????????????????????????
echo PRÓXIMOS PASOS:
echo ???????????????????????????????????????????????????????????????
echo.
echo 1. Probar Tweaker.exe en un sistema limpio
echo 2. Verificar que funcione sin dependencias
echo 3. Ejecutar como Administrador
echo 4. Crear instalador (opcional):
echo    - Inno Setup
echo    - NSIS
echo    - WiX Toolset
echo.
echo 5. Distribuir:
echo    - GitHub Releases
echo    - Website
echo    - Discord/Comunidad
echo.
echo ???????????????????????????????????????????????????????????????

:: Abrir carpeta de salida
explorer "%OUTPUT_DIR%"

echo.
echo Presiona cualquier tecla para salir...
pause >nul
