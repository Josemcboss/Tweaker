@echo off
echo ????????????????????????????????????????????????????????
echo    GHOST OPTIMIZER - KEY GENERATOR
echo    Herramienta Administrativa
echo ????????????????????????????????????????????????????????
echo.

REM Verificar si el KeyGenerator está compilado
if not exist "KeyGenerator\bin\Debug\net10.0-windows\KeyGenerator.exe" (
    echo ?? KeyGenerator no está compilado. Compilando...
    echo.
    dotnet build KeyGenerator\KeyGenerator.csproj --configuration Debug
    if errorlevel 1 (
        echo.
        echo ? Error al compilar KeyGenerator
        pause
        exit /b 1
    )
)

echo.
echo ?? Iniciando KeyGenerator...
echo.

REM Ejecutar KeyGenerator
dotnet run --project KeyGenerator --no-build

pause