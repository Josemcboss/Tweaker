using System;
using Tweaker.License;

Console.WriteLine("????????????????????????????????????????????????????????");
Console.WriteLine("   OBTENER TU FINGERPRINT REAL");
Console.WriteLine("????????????????????????????????????????????????????????");
Console.WriteLine();

Console.WriteLine("?? Detectando hardware...");
Console.WriteLine();

try
{
    var fullFingerprint = HardwareFingerprint.GetFingerprint();
    var displayFingerprint = HardwareFingerprint.GetDisplayFingerprint();
    
    Console.WriteLine("?? TU HARDWARE FINGERPRINT:");
    Console.WriteLine($"   Completo: {fullFingerprint}");
    Console.WriteLine($"   Display:  {displayFingerprint}");
    Console.WriteLine();
    
    Console.WriteLine("?? GENERANDO CLAVE PARA TU HARDWARE...");
    var licenseKey = LicenseKeyGenerator.GenerateKey(fullFingerprint, null);
    Console.WriteLine();
    
    Console.ForegroundColor = ConsoleColor.Green;
    Console.WriteLine("???????????????????????????????????????????????????????");
    Console.WriteLine("          TU CLAVE DE LICENCIA PERSONALIZADA");
    Console.WriteLine("???????????????????????????????????????????????????????");
    Console.WriteLine();
    Console.WriteLine($"     {licenseKey}");
    Console.WriteLine();
    Console.WriteLine("???????????????????????????????????????????????????????");
    Console.ResetColor();
    Console.WriteLine();
    
    Console.WriteLine("?? INSTRUCCIONES:");
    Console.WriteLine($"1. Copia esta clave: {licenseKey}");
    Console.WriteLine("2. Abre Ghost Optimizer");
    Console.WriteLine("3. Pégala en la ventana de activación");
    Console.WriteLine("4. ¡Listo!");
    Console.WriteLine();
    
    // Validar que funciona
    Console.WriteLine("? Validando clave...");
    var result = LicenseValidator.ValidateLicenseKey(licenseKey, fullFingerprint);
    if (result != null)
    {
        Console.ForegroundColor = ConsoleColor.Green;
        Console.WriteLine("? CLAVE VÁLIDA - Funcionará en Ghost Optimizer");
        Console.ResetColor();
    }
    else
    {
        Console.ForegroundColor = ConsoleColor.Red;
        Console.WriteLine("? ERROR: La clave no validó correctamente");
        Console.ResetColor();
    }
}
catch (Exception ex)
{
    Console.ForegroundColor = ConsoleColor.Red;
    Console.WriteLine($"? ERROR: {ex.Message}");
    Console.ResetColor();
}

Console.WriteLine();
Console.WriteLine("Presiona cualquier tecla para salir...");
Console.ReadKey();